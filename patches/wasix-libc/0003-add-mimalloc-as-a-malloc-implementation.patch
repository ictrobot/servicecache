diff --git a/mimalloc/malloc.c b/mimalloc/malloc.c
new file mode 100644
--- /dev/null
+++ b/mimalloc/malloc.c
@@ -0,0 +1,59 @@
+// libc's malloc for MALLOC_IMPL=mimalloc: mimalloc's single-file build, from
+// the source tree MIMALLOC_DIR names, and libc's allocation functions
+// forwarded to it, as dlmalloc/src/dlmalloc.c wraps dlmalloc.
+//
+// mimalloc can define the functions itself (MI_MALLOC_OVERRIDE), but that
+// also defines strdup and strndup, which libc defines, and
+// std::get_new_handler, which libc++abi defines. libc++abi's operator new and
+// delete call malloc and free, so they need nothing here.
+
+#include "src/static.c"
+
+// mimalloc does not always report a failure in errno: calloc's overflow
+// check leaves it alone in a release build, and the other failures set it only
+// when it was zero. libc's functions set it themselves.
+
+void *malloc(size_t size) {
+    void *result = mi_malloc(size);
+    if (result == NULL) errno = ENOMEM;
+    return result;
+}
+
+void free(void *ptr) {
+    mi_free(ptr);
+}
+
+void *calloc(size_t nmemb, size_t size) {
+    void *result = mi_calloc(nmemb, size);
+    if (result == NULL) errno = ENOMEM;
+    return result;
+}
+
+void *realloc(void *ptr, size_t size) {
+    void *result = mi_realloc(ptr, size);
+    if (result == NULL) errno = ENOMEM;
+    return result;
+}
+
+int posix_memalign(void **memptr, size_t alignment, size_t size) {
+    return mi_posix_memalign(memptr, alignment, size);
+}
+
+void *aligned_alloc(size_t alignment, size_t bytes) {
+    if (alignment == 0 || (alignment & (alignment - 1)) != 0) {
+        errno = EINVAL;
+        return NULL;
+    }
+    void *result = mi_aligned_alloc(alignment, bytes);
+    if (result == NULL) errno = ENOMEM;
+    return result;
+}
+
+size_t malloc_usable_size(void *ptr) {
+    return mi_usable_size(ptr);
+}
+
+// Define these to satisfy musl references.
+void *__libc_malloc(size_t) __attribute__((alias("malloc")));
+void __libc_free(void *) __attribute__((alias("free")));
+void *__libc_calloc(size_t nmemb, size_t size) __attribute__((alias("calloc")));
