Subject: chdir: serialise relative-path resolution

`make_absolute()` assembled `cwd + "/" + path` in a process-wide static
buffer and returned a pointer into it, and `__wasilibc_find_relpath_alloc()`
read that buffer after the cwd lock had been released. Every libc call that
takes a relative path goes through it, so two threads making path syscalls
at the same time could hand the runtime each other's path, or a splice of
both: a create succeeded under the wrong name and the re-open of the right
one failed with ENOENT. The whole of `__wasilibc_find_relpath_alloc()` now
runs under a lock, as `preopens.c` already does for its table.

This is wasi-libc's fix, commit aa9b5c0820fc ("Make `make_absolute`
thread-local in `chdir.c`", WebAssembly/wasi-libc#781, by CPunisher,
2026-04-10), applied to wasix-libc's copy of the file.

diff --git a/libc-bottom-half/sources/chdir.c b/libc-bottom-half/sources/chdir.c
--- a/libc-bottom-half/sources/chdir.c
+++ b/libc-bottom-half/sources/chdir.c
@@ -1,6 +1,8 @@
+// Modified for ServiceCache: backported fix of https://github.com/WebAssembly/wasi-libc/pull/781
 #include <errno.h>
 #include <fcntl.h>
 #include <limits.h>
+#include <lock.h>
 #include <stdlib.h>
 #include <string.h>
 #include <sys/stat.h>
@@ -11,6 +13,7 @@
 #ifdef _REENTRANT
 void __wasilibc_cwd_lock(void);
 void __wasilibc_cwd_unlock(void);
+static volatile int lock[1];
 #else
 #define __wasilibc_cwd_lock() (void)0
 #define __wasilibc_cwd_unlock() (void)0
@@ -160,9 +163,12 @@
     size_t *relative_buf_len,
     int can_realloc
 ) {
+    LOCK(lock);
+
     // First, make our path absolute taking the cwd into account.
     const char *abspath = make_absolute(path);
     if (abspath == NULL) {
+        UNLOCK(lock);
         errno = ENOMEM;
         return -1;
     }
@@ -172,17 +178,21 @@
     // into `relative_buf`.
     const char *rel;
     int fd = __wasilibc_find_abspath(abspath, abs_prefix, &rel);
-    if (fd == -1)
+    if (fd == -1) {
+        UNLOCK(lock);
         return -1;
+    }
 
     size_t rel_len = strlen(rel);
     if (*relative_buf_len < rel_len + 1) {
         if (!can_realloc) {
+            UNLOCK(lock);
             errno = ERANGE;
             return -1;
         }
         char *tmp = realloc(*relative_buf, rel_len + 1);
         if (tmp == NULL) {
+            UNLOCK(lock);
             errno = ENOMEM;
             return -1;
         }
@@ -190,6 +200,7 @@
         *relative_buf_len = rel_len + 1;
     }
     strcpy(*relative_buf, rel);
+    UNLOCK(lock);
     return fd;
 }
 
