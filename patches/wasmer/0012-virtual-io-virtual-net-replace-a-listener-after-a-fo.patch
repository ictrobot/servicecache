+    /// Moves a token's registration to another descriptor, keeping its
+    /// handler: the old descriptor is deregistered if it is still known and
+    /// the new one is registered under the same token. A forked child uses
+    /// this to replace an inherited listening socket with its own.
+    #[cfg(unix)]
+    pub fn reregister(
+        &self,
+        token: Token,
+        source: &mut dyn SelectorSource,
+        interests: mio::Interest,
+    ) -> io::Result<()> {
+        let instance = self.instance.lock().unwrap();
+        let mut sources = self.sources.lock().unwrap();
+        if let Some((old_fd, _)) = sources.remove(&token) {
+            // The old descriptor may already be closed or unregistered.
+            instance
+                .registry
+                .deregister(&mut mio::unix::SourceFd(&old_fd))
+                .ok();
+        }
+        source.register(&instance.registry, token, interests)?;
+        sources.insert(token, (std::os::fd::AsRawFd::as_raw_fd(source), interests));
+        tracing::debug!(?token, "registration moved to a new descriptor");
+        Ok(())
+    }
+
     pub fn push_interest(&self, token: Token, interest: InterestType) {
         self.queue_modification(SelectorModification::PushInterest { token, interest });
     }
