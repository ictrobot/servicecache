+    /// Replaces the listening socket, keeping the guest's interest handler:
+    /// the registration moves to the new descriptor under the same token.
+    /// Connections accepted but not yet handed to the guest are dropped;
+    /// they belong to the old socket. A forked child uses this to listen on
+    /// its own socket instead of the one it inherited.
+    #[cfg(unix)]
+    pub fn replace_std_listener(&mut self, listener: std::net::TcpListener) -> io::Result<()> {
+        listener.set_nonblocking(true)?;
+        tracing::debug!(
+            old = ?self.stream.local_addr().ok(),
+            new = ?listener.local_addr().ok(),
+            "replacing the listening socket"
+        );
+        let mut stream = mio::net::TcpListener::from_std(listener);
+        let token = match &self.handler_guard {
+            HandlerGuardState::ExternalHandler(guard) | HandlerGuardState::WakerMap(guard, _) => {
+                Some(guard.token())
+            }
+            HandlerGuardState::None => None,
+        };
+        if let Some(token) = token {
+            self.selector.reregister(
+                token,
+                &mut stream,
+                mio::Interest::READABLE.add(mio::Interest::WRITABLE),
+            )?;
+        }
+        self.backlog.clear();
+        self.stream = stream;
+        Ok(())
+    }
