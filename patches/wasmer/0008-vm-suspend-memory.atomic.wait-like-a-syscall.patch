+/// The wait as a future: ready once notified, or once the timer fires.
+///
+/// A wait is normally run through the suspension machinery (the coroutine
+/// suspends and its host loop polls this), which is what lets a process be
+/// frozen while a guest thread sits in `memory.atomic.wait`. Without
+/// suspension it is polled in a park loop on the calling thread, with the
+/// deadline handled by `park_timeout`, which is what the Condvar did.
+struct AtomicWait {
+    map: Arc<NotifyMap>,
+    address: u32,
+    id: u64,
+    timer: Option<Pin<Box<dyn Future<Output = ()> + Send + Sync>>>,
+    deadline: Option<Instant>,
+}
+
+impl Future for AtomicWait {
+    type Output = Result<u32, WaiterError>;
+
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        if self.map.closed.load(Ordering::Acquire) {
+            return Poll::Ready(Err(WaiterError::AtomicsDisabled));
+        }
+        {
+            let mut waiters = self.map.waiters.lock();
+            match waiters
+                .get_mut(&self.address)
+                .and_then(|list| list.iter_mut().find(|w| w.id == self.id))
+            {
+                Some(waiter) if waiter.notified => return Poll::Ready(Ok(0)),
+                Some(waiter) => waiter.waker = Some(cx.waker().clone()),
+                None => return Poll::Ready(Ok(0)),
+            }
+        }
+        if let Some(timer) = self.timer.as_mut()
+            && timer.as_mut().poll(cx).is_ready()
+        {
+            return Poll::Ready(Ok(2));
+        }
+        if self
+            .deadline
+            .is_some_and(|deadline| Instant::now() >= deadline)
+        {
+            return Poll::Ready(Ok(2));
+        }
+        Poll::Pending
+    }
+}
+
+impl NotifyMap {
+    fn remove_waiter(&self, address: u32, id: u64) {
+        let mut waiters = self.waiters.lock();
+        if let Some(list) = waiters.get_mut(&address) {
+            list.retain(|w| w.id != id);
+            if list.is_empty() {
+                waiters.remove(&address);
+            }
+        }
+    }
+}
