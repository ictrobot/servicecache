+// SPDX-License-Identifier: MIT OR Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 Ethan Jones
+
+//! Suspend-on-block for the coroutines that run Wasm.
+//!
+//! Stock Wasmer runs every call into Wasm on a corosensei coroutine and, when
+//! a host function inside that call waits for I/O, parks the OS thread from
+//! within the coroutine. With suspension enabled a wait instead *suspends* the
+//! coroutine and hands its pending future to the loop that resumed it: that
+//! loop polls the future on the OS thread's own stack, parking between polls,
+//! and resumes the coroutine once the future completes. The guest observes
+//! the same syscall semantics, but while it waits its whole state is in
+//! memory and no OS thread is committed to it.
+//!
+//! Nothing here changes behaviour until [`enable`] is called: the suspend
+//! hooks are never installed, so `try_suspend_on_block` refuses and every
+//! wait blocks its thread as before.
+//!
+//! Two rules make a coroutine resumable on a different OS thread than the one
+//! it suspended on:
+//!
+//! - The pending future lives on the coroutine's own stack and is fused, so a
+//!   process that copies the memory (a fork) can re-poll it safely even when
+//!   it had already completed.
+//! - Every thread-local access on a path that spans a suspend goes through a
+//!   `#[inline(never)]` function. The compiler materialises a thread-local's
+//!   address once per function; a function that computed it before a suspend
+//!   and reused it after a resume on another thread would write into the old
+//!   thread's block.
+
+use std::future::Future;
+use std::mem;
+use std::pin::Pin;
+use std::ptr::NonNull;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::{Arc, OnceLock};
+use std::task::{Context, Poll, Wake, Waker};
+use std::time::{Duration, Instant};
+
+use corosensei::stack::DefaultStack;
+use corosensei::{Coroutine, CoroutineResult, Yielder};
+
+use super::trap::UnwindReason;
+use super::traphandlers::{
+    TrapHandlerContext, TrapHandlerFn, acquire_stack, release_stack, yielder_get, yielder_set,
+};
+
+/// What a coroutine hands back to the loop that resumed it.
+pub enum WasmYield {
+    /// Trap unwinding, the only yield stock Wasmer has.
+    Unwind(UnwindReason),
+    /// The guest is blocked in a host wait. The loop polls the future to
+    /// completion, parking between polls, and then resumes the coroutine.
+    Blocked(BlockedFuture),
+}
+
+/// A fused, `()`-returning future pinned on a suspended coroutine's stack.
+///
+/// The pointer stays valid until the coroutine is resumed: the frame holding
+/// the future cannot go away while the coroutine is suspended.
+#[derive(Clone, Copy, Debug)]
+pub struct BlockedFuture(NonNull<dyn Future<Output = ()> + 'static>);
+
+// SAFETY: the future is only ever polled by one thread at a time (the loop
+// that owns the coroutine), and the coroutine's stack is process memory, so
+// the pointer is valid from any thread.
+unsafe impl Send for BlockedFuture {}
+
+impl BlockedFuture {
+    /// Polls the future.
+    ///
+    /// # Safety
+    ///
+    /// The coroutine that owns the future must be suspended.
+    pub unsafe fn poll(self, cx: &mut Context<'_>) -> Poll<()> {
+        // SAFETY: the caller guarantees the owning coroutine is suspended, so the
+        // frame holding the future is intact, pinned on that stack, and nothing
+        // else touches it while we poll.
+        unsafe { Pin::new_unchecked(&mut *self.0.as_ptr()).poll(cx) }
+    }
+}
+
+/// A timer source: the host's sleep, used for the timeouts of waits that
+/// wasmer-vm implements itself (`memory.atomic.wait`).
+pub type SleepHook = fn(Duration) -> Pin<Box<dyn Future<Output = ()> + Send + Sync + 'static>>;
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static SLEEP_HOOK: OnceLock<SleepHook> = OnceLock::new();
+
+/// Enables suspension process-wide: host imports run on the coroutine stack
+/// and blocking waits suspend the coroutine. `sleep` supplies timers for the
+/// waits wasmer-vm implements itself. Irreversible.
+pub fn enable(sleep: SleepHook) {
+    let _ = SLEEP_HOOK.set(sleep);
+    ENABLED.store(true, Ordering::SeqCst);
+}
+
+/// Whether [`enable`] has been called.
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// A timer from the host's sleep hook, if suspension is enabled.
+pub(crate) fn sleep(duration: Duration) -> Option<Pin<Box<dyn Future<Output = ()> + Send + Sync>>> {
+    SLEEP_HOOK.get().map(|hook| hook(duration))
+}
+
+/// Logs through `tracing` when the crate's `tracing` feature is on, and
+/// expands to nothing otherwise.
+macro_rules! log {
+    ($level:ident, $($arg:tt)*) => {
+        #[cfg(feature = "tracing")]
+        tracing::$level!($($arg)*);
+    };
+}
+
+/// Number of host loops currently resuming a coroutine or polling its wait.
+static ACTIVE: AtomicUsize = AtomicUsize::new(0);
+
+/// Closed: no coroutine that has already started may be resumed or polled.
+static GATE_CLOSED: AtomicBool = AtomicBool::new(false);
+
+/// Registers the caller as active unless the gate is closed and `started`.
+///
+/// With sequentially consistent ordering either this thread sees the closed
+/// gate or the closer sees the incremented count, never neither.
+fn try_enter(started: bool) -> bool {
+    ACTIVE.fetch_add(1, Ordering::SeqCst);
+    if started && GATE_CLOSED.load(Ordering::SeqCst) {
+        ACTIVE.fetch_sub(1, Ordering::SeqCst);
+        return false;
+    }
+    true
+}
+
+fn leave() {
+    ACTIVE.fetch_sub(1, Ordering::SeqCst);
+}
+
+/// A `Waker` that unparks the thread that created it.
+struct Unparker(std::thread::Thread);
+
+impl Wake for Unparker {
+    fn wake(self: Arc<Self>) {
+        self.0.unpark();
+    }
+
+    fn wake_by_ref(self: &Arc<Self>) {
+        self.0.unpark();
+    }
+}
+
+/// Polls `fut` on this thread, parking between polls, until it is ready.
+/// Every poll is registered as active, so a freeze never catches a poll in
+/// flight.
+fn wait_ready(fut: BlockedFuture) {
+    let waker = Waker::from(Arc::new(Unparker(std::thread::current())));
+    let mut cx = Context::from_waker(&waker);
+    loop {
+        try_enter(false);
+        let ready = unsafe { fut.poll(&mut cx) }.is_ready();
+        leave();
+        if ready {
+            return;
+        }
+        std::thread::park();
+    }
+}
+
+/// Suspends the calling coroutine until the host loop has polled `fut` to
+/// completion, possibly on another OS thread. Returns `false`, without
+/// polling, when suspension is disabled or the caller is not on a coroutine.
+///
+/// This is the hook virtual-io's `block_on` calls; its signature is
+/// `virtual_mio::SuspendHook`.
+pub fn try_suspend_on_block(fut: Pin<&mut (dyn Future<Output = ()> + '_)>) -> bool {
+    if !enabled() {
+        return false;
+    }
+    let Some(yielder) = yielder_get() else {
+        return false;
+    };
+    // SAFETY: only the address is taken; the future is never moved out of
+    // its pinned place.
+    let raw: *mut (dyn Future<Output = ()> + '_) = unsafe { fut.get_unchecked_mut() };
+    // SAFETY: the lifetime is erased, not extended: the future lives on this
+    // coroutine's stack, which stays intact until the coroutine is resumed,
+    // and the loop polls it only while the coroutine is suspended (see
+    // `BlockedFuture`).
+    let raw: *mut (dyn Future<Output = ()> + 'static) = unsafe { mem::transmute(raw) };
+    // SAFETY: `raw` came from a reference.
+    let blocked = BlockedFuture(unsafe { NonNull::new_unchecked(raw) });
+    // SAFETY: the yielder pointer was stored in this thread's TLS by the
+    // coroutine we are running on and stays valid while that coroutine is
+    // live; suspending from within it is the operation it exists for.
+    log!(trace, "suspending on a wait");
+    unsafe { yielder.as_ref().suspend(WasmYield::Blocked(blocked)) };
+    // Resumed, possibly on another thread: this thread's view of the
+    // coroutine is re-established through the non-inlined accessor.
+    yielder_set(Some(yielder));
+    log!(trace, "resumed");
+    true
+}
+
+/// Fuses a future so that it can be re-polled after completion, storing its
+/// output in `slot`.
+struct Fused<'a, F: Future> {
+    fut: Pin<&'a mut F>,
+    slot: &'a mut Option<F::Output>,
+    done: bool,
+}
+
+impl<F: Future> Future for Fused<'_, F> {
+    type Output = ();
+
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<()> {
+        // All fields are `Unpin`, so `Fused` is too and no projection is needed.
+        let this = self.get_mut();
+        if this.done {
+            return Poll::Ready(());
+        }
+        match this.fut.as_mut().poll(cx) {
+            Poll::Ready(value) => {
+                *this.slot = Some(value);
+                this.done = true;
+                Poll::Ready(())
+            }
+            Poll::Pending => Poll::Pending,
+        }
+    }
+}
+
+/// Blocks on a future the way virtual-io's `block_on` does: suspending the
+/// coroutine when possible, otherwise polling in a park loop on this thread.
+/// `deadline` only matters for the park loop; a suspended wait must carry
+/// its own timer.
+pub(crate) fn block_on<F: Future>(fut: F, deadline: Option<Instant>) -> F::Output {
+    let mut slot = None;
+    let mut fut = std::pin::pin!(fut);
+    {
+        let mut fused = std::pin::pin!(Fused {
+            fut: fut.as_mut(),
+            slot: &mut slot,
+            done: false,
+        });
+        if !try_suspend_on_block(fused.as_mut()) {
+            let waker = Waker::from(Arc::new(Unparker(std::thread::current())));
+            let mut cx = Context::from_waker(&waker);
+            while fused.as_mut().poll(&mut cx).is_pending() {
+                match deadline {
+                    Some(deadline) => std::thread::park_timeout(
+                        deadline.saturating_duration_since(Instant::now()),
+                    ),
+                    None => std::thread::park(),
+                }
+            }
+        }
+    }
+    slot.expect("a fused future completed without an output")
+}
+
+/// One coroutine and what its loop needs to resume it.
+struct GuestCoro<T> {
+    coro: Coroutine<(), WasmYield, Result<T, UnwindReason>, DefaultStack>,
+    /// The custom trap handler installed around each resume, for coroutines
+    /// that run Wasm.
+    trap_handler: Option<*const TrapHandlerFn<'static>>,
+    /// Whether a trap-handler context is installed around each resume. Only
+    /// coroutines that run Wasm need one; a host segfault on a stack without
+    /// one crashes the process as it would anywhere else.
+    with_trap_context: bool,
+    /// The wait the coroutine is suspended in, if any.
+    pending: Option<BlockedFuture>,
+}
+
+impl<T: 'static> GuestCoro<T> {
+    /// Resumes the coroutine on the calling thread, recording the wait it
+    /// suspends in.
+    fn resume_here(&mut self) -> CoroutineResult<WasmYield, Result<T, UnwindReason>> {
+        self.pending = None;
+        let result = if self.with_trap_context {
+            let coro_trap_handler = self.coro.trap_handler();
+            TrapHandlerContext::install(self.trap_handler, coro_trap_handler, || {
+                self.coro.resume(())
+            })
+        } else {
+            self.coro.resume(())
+        };
+        if let CoroutineResult::Yield(WasmYield::Blocked(fut)) = &result {
+            self.pending = Some(*fut);
+        }
+        result
+    }
+}
+
+/// Runs `f` on a fresh coroutine stack with a trap-handler context, the way
+/// stock `on_wasm_stack` did, and drives the coroutine through its waits.
+///
+/// A wait is handled by whoever resumed this coroutine: if that is another
+/// coroutine (a call from within a suspended guest thread, or a nested call
+/// through a host import), the wait is propagated outwards so that no OS
+/// thread stack holds guest state; otherwise it is polled right here.
+pub(crate) fn run_wasm_call<F: FnOnce() -> T + 'static, T: 'static>(
+    stack_size: usize,
+    trap_handler: Option<*const TrapHandlerFn<'static>>,
+    f: F,
+) -> Result<T, UnwindReason> {
+    let stack = acquire_stack(stack_size);
+    let outer = yielder_get();
+
+    let coro = Coroutine::with_stack(stack, move |yielder: &Yielder<(), WasmYield>, ()| {
+        // Save the yielder to TLS so that it can be used later.
+        yielder_set(Some(yielder.into()));
+        Ok(f())
+    });
+    let mut handle = GuestCoro {
+        coro,
+        trap_handler,
+        with_trap_context: true,
+        pending: None,
+    };
+
+    // Restore the enclosing yielder however the loop ends, including by a
+    // panic propagating out of the coroutine.
+    let _restore = scopeguard::guard((), move |()| yielder_set(outer));
+
+    let result = loop {
+        let step = handle.resume_here();
+        yielder_set(outer);
+        match step {
+            CoroutineResult::Yield(WasmYield::Unwind(reason)) => {
+                // SAFETY: this came from `unwind_with`, which requires that there
+                // be only Wasm frames on the stack, so nothing on it needs `Drop`
+                // (the same contract as stock `on_wasm_stack`).
+                unsafe { handle.coro.force_reset() };
+                break Err(reason);
+            }
+            CoroutineResult::Yield(WasmYield::Blocked(fut)) => match outer {
+                Some(outer) => {
+                    // SAFETY: `outer` is the enclosing coroutine's yielder, read
+                    // from this thread's TLS before we started; that coroutine is
+                    // live because it is the one resuming us.
+                    unsafe { outer.as_ref().suspend(WasmYield::Blocked(fut)) };
+                    yielder_set(Some(outer));
+                }
+                None => wait_ready(fut),
+            },
+            CoroutineResult::Return(result) => break result,
+        }
+    };
+
+    // The loop only ends with the coroutine finished: it returned, or it
+    // unwound and was reset. Its stack goes back to the pool.
+    let GuestCoro { coro, .. } = handle;
+    debug_assert!(coro.done());
+    release_stack(coro.into_stack());
+    result
+}
