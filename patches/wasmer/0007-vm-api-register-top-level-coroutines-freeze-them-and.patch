+/// The store-context stack of a thread, as captured for a coroutine that is
+/// resumed on another thread. Only sync entries can be captured: a suspended
+/// guest thread holds no async store guard.
+#[cfg(feature = "sys")]
+struct SuspendedStoreContexts(Vec<(StoreId, *mut StoreInner, u32)>);
+
+#[cfg(feature = "sys")]
+unsafe impl Send for SuspendedStoreContexts {}
+
+#[cfg(feature = "sys")]
+#[inline(never)]
+fn capture_store_contexts() -> Box<dyn std::any::Any + Send> {
+    STORE_CONTEXT_STACK.with(|cell| {
+        let stack = cell.borrow();
+        Box::new(SuspendedStoreContexts(
+            stack
+                .iter()
+                .map(|ctx| {
+                    // SAFETY: we hold the `RefCell` borrow of the stack, so no
+                    // one mutates the entry while we read it.
+                    let ptr = unsafe { ctx.entry.get().as_ref().unwrap() }.as_ptr();
+                    (ctx.id, ptr, ctx.borrow_count)
+                })
+                .collect(),
+        ))
+    })
+}
+
+#[cfg(feature = "sys")]
+#[inline(never)]
+fn restore_store_contexts(state: &(dyn std::any::Any + Send)) {
+    let state = state
+        .downcast_ref::<SuspendedStoreContexts>()
+        .expect("captured store contexts");
+    STORE_CONTEXT_STACK.with(|cell| {
+        let mut stack = cell.borrow_mut();
+        for (id, ptr, borrow_count) in &state.0 {
+            stack.push(StoreContext {
+                id: *id,
+                borrow_count: *borrow_count,
+                entry: UnsafeCell::new(StoreContextEntry::Sync(*ptr)),
+            });
+        }
+    })
+}
+
+/// Lets `wasmer_vm` carry this thread-local store-context stack from the
+/// thread a suspended coroutine last ran on to the thread that resumes it.
+/// Part of enabling suspension; see `wasmer_vm::suspend`.
+#[cfg(feature = "sys")]
+pub fn install_suspend_thread_state_hooks() {
+    wasmer_vm::set_thread_state_hooks(wasmer_vm::ThreadStateHooks {
+        capture: capture_store_contexts,
+        restore: restore_store_contexts,
+    });
+}
