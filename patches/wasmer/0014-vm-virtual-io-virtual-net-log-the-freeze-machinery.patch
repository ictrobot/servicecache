+/// Logs through `tracing` when the crate's `tracing` feature is on, and
+/// expands to nothing otherwise.
+macro_rules! log {
+    ($level:ident, $($arg:tt)*) => {
+        #[cfg(feature = "tracing")]
+        tracing::$level!($($arg)*);
+    };
+}
