+/// Runs a host import: on the coroutine stack when suspension is enabled, so
+/// that a wait inside it can suspend the coroutine; on the OS thread's stack
+/// (stock behaviour, `on_host_stack`) otherwise.
+///
+/// Running host code on the coroutine stack gives up the isolation of host
+/// frames from guest-controlled stack depth: a stack overflow in an import is
+/// reported as a Wasm stack-overflow trap, and the coroutine stack must be
+/// sized for the host code as well.
+pub fn on_host_stack_for_import<F: FnOnce() -> T, T>(f: F) -> T {
+    if enabled() {
+        f()
+    } else {
+        super::traphandlers::on_host_stack(f)
+    }
+}
