--- /dev/null
+++ b/lib/compiler/src/profile/unwind.rs
@@ -0,0 +1,275 @@
+//! Convert relocated module CFI into independent profiling-only frame tables.
+
+use super::CodeRegion;
+use gimli::{
+    BaseAddresses, CallFrameInstruction as ReadInstruction, CieOrFde, EhFrame, EndianSlice,
+    LittleEndian, UnwindSection,
+    write::{
+        self, Address, CallFrameInstruction as Instruction, CommonInformationEntry, EndianVec,
+        FrameDescriptionEntry, FrameTable,
+    },
+};
+use std::collections::BTreeMap;
+
+type Reader<'a> = EndianSlice<'a, LittleEndian>;
+
+pub(super) fn attach(regions: &mut [CodeRegion], bytes: &[u8]) -> Result<(), String> {
+    let mut frame = EhFrame::new(bytes, LittleEndian);
+    frame.set_address_size(8);
+    let bases = BaseAddresses::default().set_eh_frame(bytes.as_ptr() as u64);
+    let indexes: BTreeMap<_, _> = regions
+        .iter()
+        .enumerate()
+        .map(|(index, region)| (region.address as u64, index))
+        .collect();
+    let mut cies = BTreeMap::new();
+    let mut entries = frame.entries(&bases);
+    while let Some(entry) = entries.next().map_err(|e| e.to_string())? {
+        let CieOrFde::Fde(partial) = entry else {
+            continue;
+        };
+        let fde = partial
+            .parse(EhFrame::cie_from_offset)
+            .map_err(|e| e.to_string())?;
+        let Some(&index) = indexes.get(&fde.initial_address()) else {
+            continue;
+        };
+        let region = &mut regions[index];
+        if region.unwind.is_some() || fde.len() > region.code.len() as u64 {
+            return Err("overlapping or oversized profiling FDE".into());
+        }
+        let original = fde.cie();
+        let cie = if let Some(cie) = cies.get(&original.offset()) {
+            cie
+        } else {
+            let mut cie = CommonInformationEntry::new(
+                gimli::Encoding {
+                    format: gimli::Format::Dwarf32,
+                    ..original.encoding()
+                },
+                original
+                    .code_alignment_factor()
+                    .try_into()
+                    .map_err(|_| "CFI code alignment overflow")?,
+                original
+                    .data_alignment_factor()
+                    .try_into()
+                    .map_err(|_| "CFI data alignment overflow")?,
+                original.return_address_register(),
+            );
+            // Profiling never runs exception handlers. Omit personality and LSDA
+            // references so this table is independent of the runtime allocation.
+            cie.fde_address_encoding = gimli::DW_EH_PE_pcrel | gimli::DW_EH_PE_sdata4;
+            cie.signal_trampoline = original.is_signal_trampoline();
+            for (offset, instruction) in
+                instructions(original.instructions(&frame, &bases), original, &frame)?
+            {
+                if offset != 0 {
+                    return Err("location change in profiling CIE".into());
+                }
+                cie.add_instruction(instruction);
+            }
+            cies.entry(original.offset()).or_insert(cie)
+        };
+        // perf inject gives each region an ELF file of its own, with the code
+        // at address 0, the unwind table where the code ends, rounded up to
+        // 8 bytes, and the search header straight after the table. The
+        // addresses below are in that file; gimli writes an address as if
+        // the table itself starts at 0.
+        let text_address = 0u64;
+        let eh_frame_address = region
+            .code
+            .len()
+            .checked_next_multiple_of(8)
+            .ok_or("code length overflow")? as u64;
+        let mut copy = FrameDescriptionEntry::new(
+            Address::Constant(text_address.wrapping_sub(eh_frame_address)),
+            fde.len().try_into().map_err(|_| "FDE length overflow")?,
+        );
+        for (offset, instruction) in
+            instructions(fde.instructions(&frame, &bases), original, &frame)?
+        {
+            if u64::from(offset) > fde.len() {
+                return Err("CFI instruction outside function".into());
+            }
+            copy.add_instruction(offset, instruction);
+        }
+        let mut table = FrameTable::default();
+        let cie = table.add_cie(cie.clone());
+        table.add_fde(cie, copy);
+        let mut output = write::EhFrame(EndianVec::new(LittleEndian));
+        table
+            .write_eh_frame(&mut output)
+            .map_err(|e| e.to_string())?;
+        let mut unwind = output.0.into_vec();
+        let fde_address = eh_frame_address + only_fde_offset(&unwind)?;
+        // A zero length ends the table, and the header starts on the next
+        // 8-byte boundary.
+        unwind.extend_from_slice(&[0; 4]);
+        unwind.resize(unwind.len().next_multiple_of(8), 0);
+        let header_address = eh_frame_address + unwind.len() as u64;
+        push_search_header(
+            &mut unwind,
+            header_address,
+            eh_frame_address,
+            text_address,
+            fde_address,
+        )?;
+        region.unwind = Some(unwind);
+    }
+    Ok(())
+}
+
+/// The offset within `table` of the single FDE written for one region.
+fn only_fde_offset(table: &[u8]) -> Result<u64, String> {
+    let mut frame = EhFrame::new(table, LittleEndian);
+    frame.set_address_size(8);
+    let bases = BaseAddresses::default().set_eh_frame(0);
+    let mut entries = frame.entries(&bases);
+    while let Some(entry) = entries.next().map_err(|e| e.to_string())? {
+        if let CieOrFde::Fde(partial) = entry {
+            let fde = partial
+                .parse(EhFrame::cie_from_offset)
+                .map_err(|e| e.to_string())?;
+            return Ok(fde.offset() as u64);
+        }
+    }
+    Err("profiling unwind table has no FDE".into())
+}
+
+/// Append an `.eh_frame_hdr` for a table holding one FDE: the format
+/// version, the encodings of the fields that follow, a pointer to the table
+/// relative to that pointer's own field, the entry count, and one search
+/// entry of the code's address and the FDE's address, both relative to the
+/// start of the header.
+fn push_search_header(
+    unwind: &mut Vec<u8>,
+    header_address: u64,
+    eh_frame_address: u64,
+    text_address: u64,
+    fde_address: u64,
+) -> Result<(), String> {
+    let relative = |target: u64, base: u64| {
+        i32::try_from(target.wrapping_sub(base) as i64)
+            .map_err(|_| "profiling unwind table is too large".to_string())
+    };
+    let table_pointer = relative(eh_frame_address, header_address + 4)?;
+    let initial_location = relative(text_address, header_address)?;
+    let fde = relative(fde_address, header_address)?;
+    unwind.extend_from_slice(&[
+        1,
+        (gimli::DW_EH_PE_pcrel | gimli::DW_EH_PE_sdata4).0,
+        gimli::DW_EH_PE_udata4.0,
+        (gimli::DW_EH_PE_datarel | gimli::DW_EH_PE_sdata4).0,
+    ]);
+    unwind.extend_from_slice(&table_pointer.to_le_bytes());
+    unwind.extend_from_slice(&1u32.to_le_bytes());
+    unwind.extend_from_slice(&initial_location.to_le_bytes());
+    unwind.extend_from_slice(&fde.to_le_bytes());
+    Ok(())
+}
+
+fn instructions(
+    mut input: gimli::CallFrameInstructionIter<'_, Reader<'_>>,
+    cie: &gimli::CommonInformationEntry<Reader<'_>>,
+    frame: &EhFrame<Reader<'_>>,
+) -> Result<Vec<(u32, Instruction)>, String> {
+    let mut result = Vec::new();
+    let mut location = 0u32;
+    let signed = |value: i128| i32::try_from(value).map_err(|_| "CFI offset overflow".to_string());
+    let factored = |value: i128| signed(value * i128::from(cie.data_alignment_factor()));
+    let expression = |value: gimli::UnwindExpression<usize>| -> Result<write::Expression, String> {
+        let value = value.get(frame).map_err(|e| e.to_string())?;
+        let mut operations = value.operations(cie.encoding());
+        while let Some(operation) = operations.next().map_err(|e| e.to_string())? {
+            use gimli::Operation::*;
+            match operation {
+                Address { .. }
+                | AddressIndex { .. }
+                | ConstantIndex { .. }
+                | Call { .. }
+                | ImplicitPointer { .. }
+                | EntryValue { .. }
+                | ParameterRef { .. }
+                | TypedLiteral { .. }
+                | Convert { .. }
+                | Reinterpret { .. } => {
+                    return Err("CFI expression refers outside its frame table".into());
+                }
+                Deref { base_type, .. } | RegisterOffset { base_type, .. } if base_type.0 != 0 => {
+                    return Err("typed CFI expression refers outside its frame table".into());
+                }
+                _ => {}
+            }
+        }
+        Ok(write::Expression::raw(value.0.slice().to_vec()))
+    };
+    while let Some(instruction) = input.next().map_err(|e| e.to_string())? {
+        use ReadInstruction::*;
+        let instruction = match instruction {
+            Nop => continue,
+            AdvanceLoc { delta } => {
+                let advance = u64::from(delta)
+                    .checked_mul(cie.code_alignment_factor())
+                    .ok_or("CFI location overflow")?;
+                location = location
+                    .checked_add(advance.try_into().map_err(|_| "CFI location overflow")?)
+                    .ok_or("CFI location overflow")?;
+                continue;
+            }
+            SetLoc { .. } => return Err("absolute CFI locations are unsupported".into()),
+            DefCfa { register, offset } => Instruction::Cfa(register, signed(i128::from(offset))?),
+            DefCfaSf {
+                register,
+                factored_offset,
+            } => Instruction::Cfa(register, factored(i128::from(factored_offset))?),
+            DefCfaRegister { register } => Instruction::CfaRegister(register),
+            DefCfaOffset { offset } => Instruction::CfaOffset(signed(i128::from(offset))?),
+            DefCfaOffsetSf { factored_offset } => {
+                Instruction::CfaOffset(factored(i128::from(factored_offset))?)
+            }
+            DefCfaExpression { expression: value } => {
+                Instruction::CfaExpression(expression(value)?)
+            }
+            Undefined { register } => Instruction::Undefined(register),
+            SameValue { register } => Instruction::SameValue(register),
+            Offset {
+                register,
+                factored_offset,
+            } => Instruction::Offset(register, factored(i128::from(factored_offset))?),
+            OffsetExtendedSf {
+                register,
+                factored_offset,
+            } => Instruction::Offset(register, factored(i128::from(factored_offset))?),
+            ValOffset {
+                register,
+                factored_offset,
+            } => Instruction::ValOffset(register, factored(i128::from(factored_offset))?),
+            ValOffsetSf {
+                register,
+                factored_offset,
+            } => Instruction::ValOffset(register, factored(i128::from(factored_offset))?),
+            Register {
+                dest_register,
+                src_register,
+            } => Instruction::Register(dest_register, src_register),
+            Expression {
+                register,
+                expression: value,
+            } => Instruction::Expression(register, expression(value)?),
+            ValExpression {
+                register,
+                expression: value,
+            } => Instruction::ValExpression(register, expression(value)?),
+            Restore { register } => Instruction::Restore(register),
+            RememberState => Instruction::RememberState,
+            RestoreState => Instruction::RestoreState,
+            ArgsSize { size } => {
+                Instruction::ArgsSize(size.try_into().map_err(|_| "CFI argument size overflow")?)
+            }
+            NegateRaState => Instruction::NegateRaState,
+        };
+        result.push((location, instruction));
+    }
+    Ok(result)
+}
