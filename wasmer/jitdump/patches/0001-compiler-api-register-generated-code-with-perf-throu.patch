+use super::{CodeRegion, ProfileMode, Registration};
+use std::{
+    fs::{File, OpenOptions},
+    io::{self, Write},
+    path::Path,
+    sync::{
+        Arc, Mutex, Once, Weak,
+        atomic::{AtomicU32, Ordering},
+    },
+};
+
+static OWNER: AtomicU32 = AtomicU32::new(0);
+static EXIT: Once = Once::new();
+
+static PROCESS: Mutex<Process> = Mutex::new(Process {
+    pid: 0,
+    dump: None,
+    map: None,
+    failed: false,
+    live: Vec::new(),
+    prune_at: 256,
+});
+
+struct Process {
+    pid: u32,
+    dump: Option<Dump>,
+    map: Option<File>,
+    failed: bool,
+    live: Vec<Weak<Registration>>,
+    prune_at: usize,
+}
+
+struct Dump {
+    file: File,
+    _marker: memmap2::Mmap,
+    next_index: u64,
+}
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
+
+fn now() -> io::Result<u64> {
+    let mut time = std::mem::MaybeUninit::uninit();
+    if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, time.as_mut_ptr()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let time = unsafe { time.assume_init() };
+    Ok(time.tv_sec as u64 * 1_000_000_000 + time.tv_nsec as u64)
+}
+
+fn record(id: u32, size: usize) -> io::Result<Vec<u8>> {
+    let size = u32::try_from(size).map_err(|_| invalid("jitdump record exceeds u32"))?;
+    let mut bytes = Vec::new();
+    bytes.extend_from_slice(&id.to_le_bytes());
+    bytes.extend_from_slice(&size.to_le_bytes());
+    bytes.extend_from_slice(&now()?.to_le_bytes());
+    Ok(bytes)
+}
+
+impl Dump {
+    fn new(pid: u32) -> io::Result<Self> {
+        // perf's libdw backend identifies packed JIT mappings by the literal
+        // prefix /tmp/jitted-. This must cover the directory as well as the
+        // synthetic DSO basename; other roots silently lose unwind frames.
+        Self::new_in(pid, Path::new("/tmp"))
+    }
+
+    fn new_in(pid: u32, root: &Path) -> io::Result<Self> {
+        let machine: u32 = if cfg!(target_arch = "x86_64") {
+            62
+        } else if cfg!(target_arch = "aarch64") {
+            183
+        } else {
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "jitdump requires x86-64 or AArch64",
+            ));
+        };
+        // Unique directories prevent PID reuse from destroying recordings. Keep
+        // the file after engine/process exit: perf inject reads it afterwards.
+        let directory = tempfile::Builder::new()
+            .prefix("jitted-wasmer-")
+            .tempdir_in(root)?
+            .keep();
+        let mut file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .open(directory.join(format!("jit-{pid}.dump")))?;
+        let mut header = Vec::with_capacity(40);
+        for field in [0x4a695444, 1, 40, machine, 0, pid] {
+            header.extend_from_slice(&field.to_le_bytes());
+        }
+        header.extend_from_slice(&now()?.to_le_bytes());
+        header.extend_from_slice(&0u64.to_le_bytes());
+        file.write_all(&header)?;
+        // The executable mapping is perf's jitdump discovery marker; never call it.
+        let marker = unsafe { memmap2::MmapOptions::new().len(40).map_exec(&file)? };
+        EXIT.call_once(|| unsafe {
+            libc::atexit(close);
+        });
+        Ok(Self {
+            file,
+            _marker: marker,
+            next_index: 1,
+        })
+    }
+
+    fn load(&mut self, pid: u32, region: &CodeRegion) -> io::Result<()> {
+        let next = self
+            .next_index
+            .checked_add(1)
+            .ok_or_else(|| invalid("jitdump index exhausted"))?;
+        let size = 56usize
+            .checked_add(region.name.len())
+            .and_then(|n| n.checked_add(1))
+            .and_then(|n| n.checked_add(region.code.len()))
+            .ok_or_else(|| invalid("jitdump size overflow"))?;
+        let mut bytes = record(0, size)?;
+        bytes.extend_from_slice(&pid.to_le_bytes());
+        bytes.extend_from_slice(&(unsafe { libc::syscall(libc::SYS_gettid) } as u32).to_le_bytes());
+        for field in [
+            region.address as u64,
+            region.address as u64,
+            region.code.len() as u64,
+            self.next_index,
+        ] {
+            bytes.extend_from_slice(&field.to_le_bytes());
+        }
+        bytes.extend_from_slice(region.name.as_bytes());
+        bytes.push(0);
+        // No trailing padding: perf locates code at the end of this record.
+        bytes.extend_from_slice(&region.code);
+        if let Some(unwind) = &region.unwind {
+            let mut metadata = record(
+                4,
+                40usize
+                    .checked_add(unwind.len())
+                    .ok_or_else(|| invalid("unwind size overflow"))?,
+            )?;
+            for field in [unwind.len() as u64, 20, 0] {
+                metadata.extend_from_slice(&field.to_le_bytes());
+            }
+            // perf's generator consumes .eh_frame followed by .eh_frame_hdr.
+            metadata.extend_from_slice(unwind);
+            self.file.write_all(&metadata)?;
+        }
+        bytes[8..16].copy_from_slice(&now()?.to_le_bytes());
+        self.file.write_all(&bytes)?;
+        self.next_index = next;
+        Ok(())
+    }
+}
+
+impl Process {
+    fn emit(&mut self, registration: &Registration) -> io::Result<()> {
+        if self.failed {
+            return Err(invalid(
+                "profiling disabled after an earlier output failure",
+            ));
+        }
+        let result = (|| {
+            match registration.mode {
+                ProfileMode::Off => {}
+                ProfileMode::JitDump => {
+                    if self.dump.is_none() {
+                        self.dump = Some(Dump::new(self.pid)?);
+                    }
+                    for region in &registration.regions {
+                        self.dump.as_mut().unwrap().load(self.pid, region)?;
+                    }
+                }
+                ProfileMode::PerfMap => {
+                    if self.map.is_none() {
+                        self.map = Some(
+                            OpenOptions::new()
+                                .append(true)
+                                .create(true)
+                                .open(format!("/tmp/perf-{}.map", self.pid))?,
+                        );
+                    }
+                    // One append per registration keeps its lines together.
+                    let lines: String = registration
+                        .regions
+                        .iter()
+                        .map(|region| {
+                            format!("{:x} {:x} {}\n", region.address, region.length, region.name)
+                        })
+                        .collect();
+                    self.map.as_mut().unwrap().write_all(lines.as_bytes())?;
+                }
+            }
+            Ok(())
+        })();
+        if result.is_err() {
+            self.failed = true;
+        }
+        result
+    }
+}
+
+pub(super) fn register(registration: &Arc<Registration>) -> io::Result<()> {
+    let pid = std::process::id();
+    let owner = OWNER
+        .compare_exchange(0, pid, Ordering::AcqRel, Ordering::Acquire)
+        .unwrap_or_else(|pid| pid);
+    // Do not touch a possibly locked inherited mutex before an explicit hook.
+    if owner != 0 && owner != pid {
+        return Err(invalid(
+            "profiling requires explicit initialization after fork",
+        ));
+    }
+    let mut process = PROCESS
+        .lock()
+        .map_err(|_| invalid("profiling mutex poisoned"))?;
+    if process.pid == 0 {
+        process.pid = pid;
+    }
+    if process.pid != pid {
+        return Err(invalid(
+            "profiling requires explicit initialization after fork",
+        ));
+    }
+    process.emit(registration)?;
+    process.live.push(Arc::downgrade(registration));
+    // Amortize collection of expired weak entries across registrations.
+    if process.live.len() >= process.prune_at {
+        process.live.retain(|entry| entry.strong_count() != 0);
+        process.prune_at = process.live.len().saturating_mul(2).max(256);
+    }
+    Ok(())
+}
+
+extern "C" fn close() {
+    if OWNER.load(Ordering::Acquire) != std::process::id() {
+        return;
+    }
+    if let Ok(mut process) = PROCESS.try_lock() {
+        if !process.failed
+            && let Some(mut dump) = process.dump.take()
+            && let Ok(record) = record(3, 16)
+        {
+            let _ = dump.file.write_all(&record);
+        }
+    }
+}
+
+pub(super) unsafe fn after_fork() -> io::Result<()> {
+    let pid = std::process::id();
+    if OWNER.load(Ordering::Acquire) == pid {
+        return Ok(());
+    }
+    // The caller guarantees this mutex and the registry were quiescent at fork.
+    let mut process = PROCESS
+        .lock()
+        .map_err(|_| invalid("profiling mutex poisoned"))?;
+    // File is unbuffered, and Dump has no destructor that writes a CLOSE record.
+    process.dump = None;
+    process.map = None;
+    process.pid = pid;
+    process.failed = false;
+    OWNER.store(pid, Ordering::Release);
+    let live: Vec<_> = process.live.iter().filter_map(Weak::upgrade).collect();
+    process.live.retain(|entry| entry.strong_count() != 0);
+    process.prune_at = process.live.len().saturating_mul(2).max(256);
+    for registration in live {
+        process.emit(&registration)?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::{Read, Seek};
+
+    fn region() -> CodeRegion {
+        CodeRegion {
+            address: 0x1000,
+            length: 3,
+            name: "odd_size".into(),
+            code: vec![0x90, 0xc3, 0],
+            unwind: Some(vec![0; 20]),
+        }
+    }
+
+    #[test]
+    fn records_have_exact_sizes_ordered_timestamps_and_unique_indexes() {
+        let root = tempfile::tempdir().unwrap();
+        let mut dump = Dump::new_in(std::process::id(), root.path()).unwrap();
+        for _ in 0..8 {
+            dump.load(std::process::id(), &region()).unwrap();
+        }
+        dump.file.rewind().unwrap();
+        let mut bytes = Vec::new();
+        dump.file.read_to_end(&mut bytes).unwrap();
+        assert_eq!(
+            &bytes[..12],
+            &[0x44, 0x54, 0x69, 0x4a, 1, 0, 0, 0, 40, 0, 0, 0]
+        );
+        assert_eq!(
+            u32::from_le_bytes(bytes[12..16].try_into().unwrap()),
+            if cfg!(target_arch = "x86_64") {
+                62
+            } else {
+                183
+            }
+        );
+        let mut offset = 40;
+        let mut time = u64::from_le_bytes(bytes[24..32].try_into().unwrap());
+        for index in 1..=8u64 {
+            for (kind, size) in [(4, 60), (0, 68)] {
+                assert_eq!(
+                    u32::from_le_bytes(bytes[offset..offset + 4].try_into().unwrap()),
+                    kind
+                );
+                assert_eq!(
+                    u32::from_le_bytes(bytes[offset + 4..offset + 8].try_into().unwrap()),
+                    size as u32
+                );
+                let timestamp =
+                    u64::from_le_bytes(bytes[offset + 8..offset + 16].try_into().unwrap());
+                assert!(timestamp >= time);
+                time = timestamp;
+                if kind == 0 {
+                    assert_eq!(
+                        u64::from_le_bytes(bytes[offset + 48..offset + 56].try_into().unwrap()),
+                        index
+                    );
+                    assert_eq!(&bytes[offset + 56..offset + 65], b"odd_size\0");
+                    assert_eq!(&bytes[offset + 65..offset + 68], &region().code);
+                }
+                offset += size;
+            }
+        }
+        assert_eq!(offset, bytes.len());
+        dump.next_index = u64::MAX;
+        assert!(dump.load(std::process::id(), &region()).is_err());
+        assert_eq!(dump.file.metadata().unwrap().len(), bytes.len() as u64);
+        assert!(record(0, usize::MAX).is_err());
+    }
+
+    #[test]
+    fn output_failure_poisoning_prevents_later_records() {
+        let root = tempfile::tempdir().unwrap();
+        let mut dump = Dump::new_in(std::process::id(), root.path()).unwrap();
+        dump.file = OpenOptions::new().write(true).open("/dev/full").unwrap();
+        let mut process = Process {
+            pid: std::process::id(),
+            dump: Some(dump),
+            map: None,
+            failed: false,
+            live: Vec::new(),
+            prune_at: 256,
+        };
+        let registration = Registration {
+            mode: ProfileMode::JitDump,
+            regions: vec![region()],
+        };
+        assert!(process.emit(&registration).is_err());
+        assert!(process.failed);
+        assert!(
+            process
+                .emit(&registration)
+                .unwrap_err()
+                .to_string()
+                .contains("earlier output failure")
+        );
+    }
+}
