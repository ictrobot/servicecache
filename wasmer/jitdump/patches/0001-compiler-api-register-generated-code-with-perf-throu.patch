+use super::*;
+use gimli::{
+    BaseAddresses, CieOrFde, EhFrame, LittleEndian, UnwindSection,
+    write::{
+        Address, CallFrameInstruction as Cfi, CommonInformationEntry, EndianVec,
+        FrameDescriptionEntry, FrameTable,
+    },
+};
+
+fn cie() -> CommonInformationEntry {
+    let mut cie = CommonInformationEntry::new(
+        gimli::Encoding {
+            format: gimli::Format::Dwarf32,
+            version: 1,
+            address_size: 8,
+        },
+        1,
+        -8,
+        gimli::X86_64::RA,
+    );
+    cie.add_instruction(Cfi::Cfa(gimli::X86_64::RSP, 8));
+    cie.add_instruction(Cfi::Offset(gimli::X86_64::RA, -8));
+    cie
+}
+
+#[test]
+fn independent_frames_preserve_distinct_rules_and_remove_exception_references() {
+    let mut table = FrameTable::default();
+    let mut common = cie();
+    common.personality = Some((gimli::DW_EH_PE_absptr, Address::Constant(0x1234)));
+    common.lsda_encoding = Some(gimli::DW_EH_PE_absptr);
+    let common = table.add_cie(common);
+    for (address, stack) in [(0x1000, 32), (0x2000, 64)] {
+        let mut frame = FrameDescriptionEntry::new(Address::Constant(address), 16);
+        frame.lsda = Some(Address::Constant(0x5678));
+        frame.add_instruction(4, Cfi::CfaOffset(stack));
+        table.add_fde(common, frame);
+    }
+    let mut pc_relative = cie();
+    pc_relative.fde_address_encoding = gimli::DW_EH_PE_pcrel | gimli::DW_EH_PE_sdata4;
+    let pc_relative = table.add_cie(pc_relative);
+    table.add_fde(
+        pc_relative,
+        FrameDescriptionEntry::new(Address::Constant(0x4000), 16),
+    );
+    let mut input = gimli::write::EhFrame(EndianVec::new(LittleEndian));
+    table.write_eh_frame(&mut input).unwrap();
+    let bytes = input.0.into_vec();
+    let mut regions: Vec<_> = [0x1000, 0x2000, bytes.as_ptr() as usize + 0x4000]
+        .into_iter()
+        .map(|address| CodeRegion {
+            address,
+            length: 16,
+            name: "test".into(),
+            code: vec![0; 16],
+            unwind: None,
+        })
+        .collect();
+    unwind::attach(&mut regions, &bytes).unwrap();
+    for (index, region) in regions.iter().enumerate() {
+        let bytes = region.unwind.as_ref().unwrap();
+        let mut frame = EhFrame::new(&bytes[..bytes.len() - 20], LittleEndian);
+        frame.set_address_size(8);
+        // Synthetic code begins at 0x1000, followed by its aligned frame table.
+        let bases = BaseAddresses::default().set_eh_frame(0x1010);
+        let mut entries = frame.entries(&bases);
+        assert!(matches!(entries.next().unwrap(), Some(CieOrFde::Cie(_))));
+        let Some(CieOrFde::Fde(fde)) = entries.next().unwrap() else {
+            panic!("missing FDE")
+        };
+        let fde = fde.parse(EhFrame::cie_from_offset).unwrap();
+        assert_eq!(fde.initial_address(), 0x1000);
+        assert_eq!(fde.len(), 16);
+        assert!(fde.cie().personality().is_none());
+        assert!(fde.lsda().is_none());
+        let mut context = gimli::UnwindContext::new();
+        let row = fde
+            .unwind_info_for_address(&frame, &bases, &mut context, 0x1004)
+            .unwrap();
+        assert_eq!(
+            *row.cfa(),
+            gimli::CfaRule::RegisterAndOffset {
+                register: gimli::X86_64::RSP,
+                offset: [32, 64, 8][index]
+            }
+        );
+        assert!(entries.next().unwrap().is_none());
+    }
+    assert!(
+        unwind::attach(&mut regions, &bytes).is_err(),
+        "duplicate FDE must be rejected"
+    );
+    assert!(unwind::attach(&mut [], &[0xff; 12]).is_err());
+}
+
+#[test]
+fn search_header_leads_to_the_region_table_at_perf_addresses() {
+    let mut table = FrameTable::default();
+    let common = table.add_cie(cie());
+    let mut frame = FrameDescriptionEntry::new(Address::Constant(0x3000), 13);
+    frame.add_instruction(4, Cfi::CfaOffset(24));
+    table.add_fde(common, frame);
+    let mut input = gimli::write::EhFrame(EndianVec::new(LittleEndian));
+    table.write_eh_frame(&mut input).unwrap();
+    let bytes = input.0.into_vec();
+    let mut regions = vec![CodeRegion {
+        address: 0x3000,
+        length: 13,
+        name: "test".into(),
+        code: vec![0; 13],
+        unwind: None,
+    }];
+    unwind::attach(&mut regions, &bytes).unwrap();
+
+    // In the file perf builds for this region, the code starts at 0, the
+    // table at 16, and the 20-byte header follows the table.
+    let unwind = regions[0].unwind.as_ref().unwrap();
+    let (eh_frame, header) = unwind.split_at(unwind.len() - 20);
+    let bases = BaseAddresses::default()
+        .set_text(0)
+        .set_eh_frame(16)
+        .set_eh_frame_hdr(16 + eh_frame.len() as u64);
+    let header = gimli::EhFrameHdr::new(header, LittleEndian)
+        .parse(&bases, 8)
+        .unwrap();
+    assert_eq!(header.eh_frame_ptr(), gimli::Pointer::Direct(16));
+    let mut frame = EhFrame::new(eh_frame, LittleEndian);
+    frame.set_address_size(8);
+    let fde = header
+        .table()
+        .unwrap()
+        .fde_for_address(&frame, &bases, 5, EhFrame::cie_from_offset)
+        .unwrap();
+    assert_eq!(fde.initial_address(), 0);
+    assert_eq!(fde.len(), 13);
+    let mut context = gimli::UnwindContext::new();
+    let row = fde
+        .unwind_info_for_address(&frame, &bases, &mut context, 5)
+        .unwrap();
+    assert_eq!(
+        *row.cfa(),
+        gimli::CfaRule::RegisterAndOffset {
+            register: gimli::X86_64::RSP,
+            offset: 24
+        }
+    );
+}
+
+#[test]
+fn names_use_full_indexes_and_deterministic_exports() {
+    let mut module = ModuleInfo::default();
+    module.num_imported_functions = 2;
+    let local = LocalFunctionIndex::from_u32(0);
+    let index = module.func_index(local);
+    assert_eq!(FunctionNames::new(&module).get(local), "wasm[2]");
+    module
+        .exports
+        .insert("z".into(), ExportIndex::Function(index));
+    module
+        .exports
+        .insert("a".into(), ExportIndex::Function(index));
+    assert_eq!(FunctionNames::new(&module).get(local), "a");
+    module.function_names.insert(index, "named".into());
+    assert_eq!(FunctionNames::new(&module).get(local), "named");
+}
