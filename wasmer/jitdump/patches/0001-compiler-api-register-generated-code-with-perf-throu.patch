index 0000000..cc5e739
--- /dev/null
+++ b/lib/compiler/src/profile/mod.rs
@@ -0,0 +1,157 @@
+//! Profiling of final, executable code, independent of compilation.
+
+use std::{collections::HashMap, sync::Arc};
+use wasmer_types::{ExportIndex, FunctionIndex, LocalFunctionIndex, ModuleInfo};
+
+#[cfg(target_os = "linux")]
+mod linux;
+#[cfg(all(test, target_os = "linux", target_arch = "x86_64"))]
+mod tests;
+mod unwind;
+
+/// Native code profiler selected when an engine loads an artifact.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum ProfileMode {
+    /// Do not register generated code with a profiler.
+    #[default]
+    Off,
+    /// Append symbols to `/tmp/perf-PID.map`.
+    PerfMap,
+    /// Write Linux perf jitdump records using CLOCK_MONOTONIC.
+    /// Tested on x86-64 with perf's libdw unwinder; AArch64 output is untested.
+    /// Record with `perf record -k 1 --call-graph dwarf`, then `perf inject --jit`.
+    JitDump,
+}
+
+/// Initialize profiling in a forked child and replay all inherited live code.
+/// Call before executing guest code, even if the child loads no new modules.
+/// Repeated calls in the same process are harmless.
+///
+/// # Safety
+/// At fork, all engine/code-loading and profiling operations, and engine
+/// destruction, must be quiescent. The child must call this before starting
+/// threads or using inherited engines. This does not repair locks inherited
+/// from arbitrary multithreaded forks or make other runtime state fork-safe.
+pub unsafe fn profile_after_fork() -> std::io::Result<()> {
+    #[cfg(target_os = "linux")]
+    unsafe {
+        linux::after_fork()?;
+    }
+    Ok(())
+}
+
+pub(crate) struct CodeRegion {
+    pub address: usize,
+    pub length: usize,
+    pub name: String,
+    pub code: Vec<u8>,
+    pub unwind: Option<Vec<u8>>,
+}
+
+impl CodeRegion {
+    /// The caller guarantees that the finalized allocation contains this range.
+    pub unsafe fn new(address: usize, length: usize, name: String) -> Self {
+        Self {
+            address,
+            length,
+            name: name.replace(['\0', '\r', '\n'], "_"),
+            code: unsafe { std::slice::from_raw_parts(address as *const u8, length) }.to_vec(),
+            unwind: None,
+        }
+    }
+}
+
+pub(crate) struct FunctionNames<'a> {
+    module: &'a ModuleInfo,
+    exports: HashMap<FunctionIndex, &'a str>,
+}
+
+impl<'a> FunctionNames<'a> {
+    pub fn new(module: &'a ModuleInfo) -> Self {
+        // Index exports once, including the deterministic choice among aliases.
+        // Scanning the entire export table per unnamed function is quadratic.
+        let mut exports: HashMap<_, &str> = HashMap::new();
+        for (name, export) in &module.exports {
+            if let ExportIndex::Function(index) = export
+                && !name.is_empty()
+            {
+                exports
+                    .entry(*index)
+                    .and_modify(|old| *old = (*old).min(name.as_str()))
+                    .or_insert(name);
+            }
+        }
+        Self { module, exports }
+    }
+
+    pub fn get(&self, index: LocalFunctionIndex) -> String {
+        let index = self.module.func_index(index);
+        self.module
+            .function_names
+            .get(&index)
+            .filter(|name| !name.is_empty())
+            .map(String::as_str)
+            .or_else(|| self.exports.get(&index).copied())
+            .map(str::to_owned)
+            .unwrap_or_else(|| format!("wasm[{}]", index.as_u32()))
+    }
+}
+
+// Owned snapshots allow replay without reading executable memory. Engines retain
+// these for exactly as long as their allocations; the process registry uses Weak.
+pub(crate) struct Registration {
+    mode: ProfileMode,
+    regions: Vec<CodeRegion>,
+}
+
+pub(crate) fn register(
+    mode: ProfileMode,
+    mut regions: Vec<CodeRegion>,
+    eh_frame: Option<&[u8]>,
+) -> std::io::Result<Arc<Registration>> {
+    if mode == ProfileMode::JitDump
+        && let Some(frame) = eh_frame
+    {
+        unwind::attach(&mut regions, frame).map_err(std::io::Error::other)?;
+    }
+    if mode != ProfileMode::JitDump {
+        // Only jitdump records code bytes. A perf map needs each region's
+        // extent and name, so the registration keeps no copy of the code.
+        for region in &mut regions {
+            region.code = Vec::new();
+        }
+    }
+    let registration = Arc::new(Registration { mode, regions });
+    #[cfg(target_os = "linux")]
+    linux::register(&registration)?;
+    #[cfg(not(target_os = "linux"))]
+    match mode {
+        // Other hosts still get a perf map. The jitdump discovery protocol
+        // and replay after fork are Linux-only.
+        ProfileMode::PerfMap => {
+            use std::io::Write;
+            static MAP: std::sync::Mutex<()> = std::sync::Mutex::new(());
+            let lines: String = registration
+                .regions
+                .iter()
+                .map(|region| format!("{:x} {:x} {}\n", region.address, region.length, region.name))
+                .collect();
+            let _guard = MAP
+                .lock()
+                .map_err(|_| std::io::Error::other("perf-map mutex poisoned"))?;
+            std::fs::OpenOptions::new()
+                .append(true)
+                .create(true)
+                .open(format!("/tmp/perf-{}.map", std::process::id()))?
+                .write_all(lines.as_bytes())?;
+        }
+        ProfileMode::JitDump => {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::Unsupported,
+                "jitdump is only supported on Linux",
+            ));
+        }
+        ProfileMode::Off => {}
+    }
+    Ok(registration)
+}
