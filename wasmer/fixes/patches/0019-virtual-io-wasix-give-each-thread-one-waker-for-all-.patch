+/// The length at which a thread's signal subscription records a debug event
+/// as it grows. A waiter registers its OS thread's waker, which the dedupe
+/// below recognises, so the list holds one entry per waiting thread.
+const SUBSCRIBER_WARNING: usize = 64;
+
+/// Adds `waker` to a thread's signal subscription unless a waker that wakes
+/// the same task is already in it.
+fn subscribe(subscribers: &mut Vec<Waker>, waker: &Waker) {
+    if subscribers.iter().any(|w| w.will_wake(waker)) {
+        return;
+    }
+    subscribers.push(waker.clone());
+    if subscribers.len() == SUBSCRIBER_WARNING {
+        tracing::debug!(
+            wakers = subscribers.len(),
+            "many wakers subscribed to a thread's signals"
+        );
+    }
+}
