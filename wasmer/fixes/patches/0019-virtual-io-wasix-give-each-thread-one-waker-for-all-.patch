+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::pin::Pin;
+
+    /// A future that is pending on its first poll and wakes itself from
+    /// another thread, so the wait driving it really parks.
+    struct PendsOnce {
+        polls: usize,
+    }
+
+    impl Future for PendsOnce {
+        type Output = usize;
+
+        fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<usize> {
+            self.polls += 1;
+            if self.polls > 1 {
+                return Poll::Ready(self.polls);
             }
-            Poll::Ready(ret) => {
-                return ret;
+            let waker = cx.waker().clone();
+            std::thread::spawn(move || waker.wake());
+            Poll::Pending
+        }
+    }
+
+    #[test]
+    fn a_thread_keeps_one_waker_for_every_wait_it_makes() {
+        let first = thread_waker();
+        for _ in 0..10_000 {
+            assert!(thread_waker().will_wake(&first));
+        }
+        // A second thread's waker is its own, so two threads waiting on one
+        // source register one waker each rather than sharing one.
+        let other = std::thread::spawn(thread_waker).join().unwrap();
+        assert!(!other.will_wake(&first));
+    }
+
+    #[test]
+    fn a_wait_that_is_ready_at_once_never_parks() {
+        assert_eq!(block_on(async { 7 }), 7);
+    }
+
+    #[test]
+    fn a_wait_woken_from_another_thread_completes() {
+        assert_eq!(block_on(PendsOnce { polls: 0 }), 2);
+    }
+
+    #[test]
+    fn a_nested_wait_leaves_its_caller_the_token_its_event_left() {
+        // The outer wait is woken while its poll is still running, and the
+        // wait that poll starts parks before the outer loop does. If the
+        // two shared a parker the inner park would consume the outer's
+        // token and the outer would park for ever; the outer's second poll
+        // is the proof that it did not.
+        struct Outer {
+            polls: usize,
+        }
+
+        impl Future for Outer {
+            type Output = usize;
+
+            fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<usize> {
+                self.polls += 1;
+                if self.polls > 1 {
+                    return Poll::Ready(self.polls);
+                }
+                // The event this wait is waiting for, arriving during the
+                // poll: legal, and it leaves a token on the parker.
+                cx.waker().wake_by_ref();
+                // A wait started inside the poll, which parks.
+                assert_eq!(block_on(PendsOnce { polls: 0 }), 2);
+                Poll::Pending
             }
         }
+
+        assert_eq!(block_on(Outer { polls: 0 }), 2);
     }
