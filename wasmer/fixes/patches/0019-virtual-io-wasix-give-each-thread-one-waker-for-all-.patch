+/// What an OS thread parks on while a wait it is driving makes progress,
+/// and the waker built from it. One exists per thread for the life of the
+/// thread, and every wait the thread drives clones its waker: the clones
+/// share one data pointer, so the lists a poll registers on - a source's
+/// waker slot, a thread's signal subscription - recognise them with
+/// `Waker::will_wake` and hold one entry per waiting thread rather than one
+/// per poll. A pair built per wait is recognised by nothing, and those
+/// lists grow by an entry on every poll until their source fires.
+struct ThreadPark {
+    parker: parking::Parker,
+    waker: Waker,
+    /// Set while a wait on this thread is parking on the parker. A parker's
+    /// token says only that something woke the thread, so a wait nested
+    /// inside another's poll cannot share it: it would consume the token
+    /// the outer wait's event left. The nested wait builds a private pair.
+    lent: Cell<bool>,
+}
+
+thread_local! {
+    static THREAD_PARK: ThreadPark = {
+        let (parker, unparker) = parking::pair();
+        ThreadPark {
+            parker,
+            waker: Waker::from(unparker),
+            lent: Cell::new(false),
+        }
+    };
+}
+
+/// Returns the parker's lending flag when the wait is over, however it
+/// ends.
+struct Returned;
+
+impl Drop for Returned {
+    fn drop(&mut self) {
+        let _ = THREAD_PARK.try_with(|park| park.lent.set(false));
+    }
+}
+
+/// A clone of this thread's waker. Every clone wakes the same parker, so
+/// `Waker::will_wake` holds between any two of them.
+#[cfg(test)]
+pub(crate) fn thread_waker() -> Waker {
+    THREAD_PARK.with(|park| park.waker.clone())
+}
+
+/// Polls until `poll` reports the wait finished, parking the OS thread in
+/// between. The thread's own parker is used when it is free; see
+/// `ThreadPark`.
+fn park_until_done(poll: &mut dyn FnMut(&mut Context<'_>) -> bool) {
+    let borrowed = THREAD_PARK.try_with(|park| {
+        if park.lent.replace(true) {
+            return false;
+        }
+        let _returned = Returned;
+        let waker = park.waker.clone();
+        let mut cx = Context::from_waker(&waker);
+        while !poll(&mut cx) {
+            park.parker.park();
+        }
+        true
+    });
+    if matches!(borrowed, Ok(true)) {
+        return;
+    }
+    // Either a wait further up this thread's stack holds the parker, or the
+    // thread is being torn down and its locals are gone.
     let (parker, unparker) = parking::pair();
-    let waker = Waker::from(unparker.clone());
+    let waker = Waker::from(unparker);
     let mut cx = Context::from_waker(&waker);
+    while !poll(&mut cx) {
+        parker.park();
+    }
+}
 
+pub fn block_on<'a, A>(task: impl Future<Output = A> + 'a) -> A {
     let mut task = Box::pin(task);
-    loop {
-        match task.as_mut().poll(&mut cx) {
-            Poll::Pending => {
-                parker.park();
+    let mut output = None;
+    park_until_done(&mut |cx| match task.as_mut().poll(cx) {
+        Poll::Ready(value) => {
+            output = Some(value);
+            true
+        }
+        Poll::Pending => false,
+    });
+    output.expect("a wait that finished produced no output")
+}
