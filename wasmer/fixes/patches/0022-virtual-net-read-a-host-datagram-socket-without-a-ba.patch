+        let sender = std::net::UdpSocket::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        sender.send_to(b"hello", addr).unwrap();
+        let waker = std::task::Waker::noop();
+        let mut cx = std::task::Context::from_waker(waker);
+        while !matches!(socket.poll_read_ready(&mut cx), Poll::Ready(Ok(1))) {
+            std::thread::sleep(Duration::from_millis(5));
+        }
+
+        let mut one = [MaybeUninit::new(0u8); 1];
+        let (amt, from) = socket.try_recv_from(&mut one, true).unwrap();
+        assert_eq!((amt, from), (1, sender.local_addr().unwrap()));
+        let mut buf = [MaybeUninit::new(0u8); 8];
+        let (amt, from) = socket.try_recv_from(&mut buf, false).unwrap();
+        assert_eq!((amt, from), (5, sender.local_addr().unwrap()));
+        assert!(matches!(
+            socket.try_recv_from(&mut buf, false),
+            Err(NetworkError::WouldBlock)
+        ));
+    }
