+/// Straight out of the kernel into `buf`, or peeked and left there. A buffer
+/// shorter than the datagram gets its first bytes, as recvfrom(2) gives
+/// them.
+#[cfg(not(target_os = "windows"))]
+fn recv_from(
+    socket: &mio::net::UdpSocket,
+    buf: &mut [u8],
+    peek: bool,
+) -> io::Result<(usize, SocketAddr)> {
+    if peek {
+        socket.peek_from(buf)
+    } else {
+        socket.recv_from(buf)
+    }
+}
+
+/// Winsock answers a buffer shorter than the datagram with WSAEMSGSIZE and
+/// reports no sender, so the datagram is received or peeked whole into a
+/// buffer the thread keeps for this, and what fits is copied out.
+#[cfg(target_os = "windows")]
+fn recv_from(
+    socket: &mio::net::UdpSocket,
+    buf: &mut [u8],
+    peek: bool,
+) -> io::Result<(usize, SocketAddr)> {
+    thread_local! {
+        static WHOLE: std::cell::RefCell<Vec<u8>> = const { std::cell::RefCell::new(Vec::new()) };
+    }
+    WHOLE.with(|whole| {
+        let mut whole = whole.borrow_mut();
+        whole.resize(MAX_SOCKET_PAYLOAD, 0);
+        let (len, addr) = if peek {
+            socket.peek_from(&mut whole[..])?
+        } else {
+            socket.recv_from(&mut whole[..])?
+        };
+        let amt = buf.len().min(len);
+        buf[..amt].copy_from_slice(&whole[..amt]);
+        Ok((amt, addr))
+    })
+}
