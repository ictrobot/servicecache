+    /// A waiting datagram is readiness the kernel holds: asking leaves it in
+    /// the kernel, where a second handle on the same socket can receive it,
+    /// and the socket is then not ready.
+    #[test]
+    fn a_datagram_socket_leaves_a_datagram_in_the_kernel() {
+        let socket = std::net::UdpSocket::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let addr = socket.local_addr().unwrap();
+        socket.set_nonblocking(true).unwrap();
+        let queue = socket.try_clone().unwrap();
+        let mut socket = LocalUdpSocket {
+            socket: mio::net::UdpSocket::from_std(socket),
+            addr,
+            selector: Selector::new(),
+            handler_guard: HandlerGuardState::None,
+            ruleset: None,
+        };
+        let waker = std::task::Waker::noop();
+        let mut cx = std::task::Context::from_waker(waker);
+        assert!(matches!(socket.poll_read_ready(&mut cx), Poll::Pending));
+
+        let sender = std::net::UdpSocket::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        sender.send_to(b"hello", addr).unwrap();
+        while !matches!(socket.poll_read_ready(&mut cx), Poll::Ready(Ok(1))) {
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        assert!(matches!(
+            socket.poll_read_ready(&mut cx),
+            Poll::Ready(Ok(1))
+        ));
+        // The other handle shares the kernel's queue and nothing else, so
+        // the datagram it receives is the one the poll saw.
+        let mut buf = [0u8; 8];
+        assert_eq!(queue.recv_from(&mut buf).unwrap().0, 5);
+        assert!(matches!(socket.poll_read_ready(&mut cx), Poll::Pending));
+    }
+
