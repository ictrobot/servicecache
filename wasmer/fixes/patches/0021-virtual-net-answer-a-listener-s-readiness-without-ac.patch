+    /// A pending connection is readiness the kernel holds: asking leaves it
+    /// in the accept queue, where a second handle on the same socket can
+    /// take it, and the listener is then not ready.
+    #[test]
+    fn a_listener_leaves_a_pending_connection_in_the_kernel() {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let addr = listener.local_addr().unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let queue = listener.try_clone().unwrap();
+        let mut listener = LocalTcpListener {
+            stream: mio::net::TcpListener::from_std(listener),
+            selector: Selector::new(),
+            handler_guard: HandlerGuardState::None,
+            no_delay: None,
+            keep_alive: None,
+            ruleset: None,
+        };
+        let waker = std::task::Waker::noop();
+        let mut cx = std::task::Context::from_waker(waker);
+        assert!(matches!(listener.poll_read_ready(&mut cx), Poll::Pending));
+
+        let _client = TcpStream::connect(addr).unwrap();
+        while !matches!(listener.poll_read_ready(&mut cx), Poll::Ready(Ok(1))) {
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        assert!(matches!(
+            listener.poll_read_ready(&mut cx),
+            Poll::Ready(Ok(1))
+        ));
+        // The other handle shares the kernel's queue and nothing else, so
+        // the connection it accepts is the one the poll saw.
+        queue.accept().unwrap();
+        assert!(matches!(listener.poll_read_ready(&mut cx), Poll::Pending));
+        assert!(matches!(
+            listener.try_accept(),
+            Err(NetworkError::WouldBlock)
+        ));
+    }
+
