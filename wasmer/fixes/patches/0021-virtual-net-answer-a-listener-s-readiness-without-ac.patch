+/// Whether the kernel holds a connection for a listening socket, asked with
+/// a zero-timeout poll so that the connection stays where it is.
+#[cfg(not(target_os = "windows"))]
+fn connection_pending(listener: &mio::net::TcpListener) -> bool {
+    libc_poll(listener.as_raw_fd(), libc::POLLIN).is_some_and(|events| events & libc::POLLIN != 0)
+}
+
+#[cfg(target_os = "windows")]
+fn connection_pending(listener: &mio::net::TcpListener) -> bool {
+    use windows_sys::Win32::Networking::WinSock::{POLLRDNORM, WSAPOLLFD, WSAPoll};
+    let mut fds = [WSAPOLLFD {
+        fd: listener.as_raw_socket() as _,
+        events: POLLRDNORM,
+        revents: 0,
+    }];
+    // SAFETY: the array is this frame's, and the socket is the listener's.
+    let ret = unsafe { WSAPoll(fds.as_mut_ptr(), 1, 0) };
+    ret == 1 && fds[0].revents & POLLRDNORM != 0
+}
