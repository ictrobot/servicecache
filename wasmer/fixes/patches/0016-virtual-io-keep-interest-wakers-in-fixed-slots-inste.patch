+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::AtomicUsize;
+
+    #[derive(Debug, Default)]
+    struct Woken(AtomicUsize);
+
+    impl Woken {
+        fn count(&self) -> usize {
+            self.0.load(Ordering::Acquire)
+        }
+    }
+
+    impl futures::task::ArcWake for Woken {
+        fn wake_by_ref(arc_self: &Arc<Self>) {
+            arc_self.0.fetch_add(1, Ordering::AcqRel);
+        }
+    }
+
+    fn counting_waker() -> (Arc<Woken>, Waker) {
+        let woken = Arc::new(Woken::default());
+        let waker = futures::task::waker(woken.clone());
+        (woken, waker)
+    }
+
+    const ALL: [InterestType; InterestType::COUNT] = [
+        InterestType::Readable,
+        InterestType::Writable,
+        InterestType::Closed,
+        InterestType::Error,
+    ];
+
+    #[test]
+    fn every_interest_has_its_own_slot_and_bit() {
+        let mut seen = 0u8;
+        for interest in ALL {
+            assert!(interest.index() < InterestType::COUNT);
+            assert_eq!(interest.bit(), 1u8 << interest.index());
+            assert_eq!(seen & interest.bit(), 0, "{interest:?} shares a bit");
+            seen |= interest.bit();
+        }
+    }
+
+    #[test]
+    fn an_interest_pushed_with_nothing_waiting_waits_to_be_popped() {
+        let mut map = InterestWakerMap::default();
+        map.push_interest(InterestType::Readable);
+
+        assert!(map.has_interest(InterestType::Readable));
+        assert!(!map.has_interest(InterestType::Writable));
+
+        // A poll arriving afterwards registers its waker and still sees the
+        // interest, which is how a caller that checks has_interest after
+        // add cannot miss the event.
+        let (woken, waker) = counting_waker();
+        map.add(InterestType::Readable, &waker);
+        assert!(map.has_interest(InterestType::Readable));
+        assert!(map.pop(InterestType::Readable));
+        assert!(!map.pop(InterestType::Readable));
+        assert_eq!(woken.count(), 0);
+    }
+
+    #[test]
+    fn one_interest_pushed_leaves_the_others_alone() {
+        let map = InterestWakerMap::default();
+        assert!(map.push(InterestType::Closed));
+        assert!(!map.push(InterestType::Closed));
+        assert!(map.push(InterestType::Error));
+
+        assert!(map.pop(InterestType::Closed));
+        assert!(!map.pop(InterestType::Closed));
+        assert!(map.pop(InterestType::Error));
+    }
+
+    #[test]
+    fn a_waiting_waker_is_woken_once_and_takes_the_interest_with_it() {
+        let mut map = InterestWakerMap::default();
+        let (woken, waker) = counting_waker();
+        map.add(InterestType::Readable, &waker);
+
+        map.push_interest(InterestType::Readable);
+        assert_eq!(woken.count(), 1);
+        // The event went to the waker, so nothing is left to pop.
+        assert!(!map.has_interest(InterestType::Readable));
+        assert!(!map.pop(InterestType::Readable));
+
+        // The waker was consumed with the event: the next one has nothing
+        // to wake and is recorded instead.
+        map.push_interest(InterestType::Readable);
+        assert_eq!(woken.count(), 1);
+        assert!(map.pop(InterestType::Readable));
+    }
+
+    #[test]
+    fn a_waker_registered_twice_is_woken_once() {
+        let mut map = InterestWakerMap::default();
+        let (woken, waker) = counting_waker();
+        map.add(InterestType::Writable, &waker);
+        map.add(InterestType::Writable, &waker.clone());
+
+        map.push_interest(InterestType::Writable);
+        assert_eq!(woken.count(), 1);
+    }
+
+    #[test]
+    fn distinct_wakers_on_one_interest_are_all_woken() {
+        let mut map = InterestWakerMap::default();
+        let (first, first_waker) = counting_waker();
+        let (second, second_waker) = counting_waker();
+        map.add(InterestType::Writable, &first_waker);
+        map.add(InterestType::Writable, &second_waker);
+
+        map.push_interest(InterestType::Writable);
+        assert_eq!(first.count(), 1);
+        assert_eq!(second.count(), 1);
+    }
+
+    #[test]
+    fn a_waker_is_only_woken_by_the_interest_it_waits_on() {
+        let mut map = InterestWakerMap::default();
+        let (woken, waker) = counting_waker();
+        map.add(InterestType::Readable, &waker);
+
+        map.push_interest(InterestType::Writable);
+        assert_eq!(woken.count(), 0);
+        assert!(map.pop(InterestType::Writable));
+
+        map.push_interest(InterestType::Readable);
+        assert_eq!(woken.count(), 1);
+    }
+
+    #[test]
+    fn an_event_racing_a_poll_is_never_lost() {
+        // A poll registers its waker while the event lands, in whichever
+        // order the two threads happen to run. Either the waker is woken or
+        // the interest is left for the poll to see, never neither.
+        for _ in 0..500 {
+            let map = InterestWakerMap::default();
+            let (woken, waker) = counting_waker();
+
+            let mut pusher = map.clone();
+            let event = std::thread::spawn(move || {
+                pusher.push_interest(InterestType::Readable);
+            });
+
+            map.add(InterestType::Readable, &waker);
+            let seen = map.has_interest(InterestType::Readable);
+
+            event.join().unwrap();
+            assert!(
+                seen || woken.count() == 1,
+                "the event woke nothing and left nothing behind"
+            );
+        }
     }
 }
