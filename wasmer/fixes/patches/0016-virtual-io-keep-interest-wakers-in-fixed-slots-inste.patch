+impl InterestType {
+    /// The number of interests, and so the number of slots a handler that
+    /// keeps one piece of state per interest needs.
+    const COUNT: usize = 4;
+
+    /// The slot this interest occupies, in `0..COUNT`.
+    const fn index(self) -> usize {
+        match self {
+            InterestType::Readable => 0,
+            InterestType::Writable => 1,
+            InterestType::Closed => 2,
+            InterestType::Error => 3,
+        }
+    }
+
+    /// The bit this interest occupies in a mask of interests.
+    const fn bit(self) -> u8 {
+        1u8 << self.index()
+    }
+}
