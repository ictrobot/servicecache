+                            barrier.wait();
+                            fs.new_open_options()
+                                .write(true)
+                                .create_new(true)
+                                .open(path!("/race.txt"))
+                                .is_ok() as usize
+                        })
+                    })
+                    .collect();
+                racers.into_iter().map(|racer| racer.join().unwrap()).sum()
+            });
+            assert_eq!(winners, 1, "an exclusive create succeeded {winners} times");
+            fs.remove_file(path!("/race.txt"))
