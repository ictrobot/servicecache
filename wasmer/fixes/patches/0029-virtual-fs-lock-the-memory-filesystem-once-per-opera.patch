+    #[test]
+    fn test_create_dir_is_exclusive_across_threads() {
+        // Threads race to create one directory, round after round: exactly
+        // one of them may succeed, and the parent must list it once.
+        const THREADS: usize = 8;
+        const ROUNDS: usize = 200;
+        let fs = FileSystem::default();
+        for _ in 0..ROUNDS {
+            let barrier = std::sync::Barrier::new(THREADS);
+            let winners: usize = std::thread::scope(|scope| {
+                let racers: Vec<_> = (0..THREADS)
+                    .map(|_| {
+                        scope.spawn(|| {
+                            barrier.wait();
+                            fs.create_dir(path!("/race")).is_ok() as usize
+                        })
+                    })
+                    .collect();
+                racers.into_iter().map(|racer| racer.join().unwrap()).sum()
+            });
+            assert_eq!(
+                winners, 1,
+                "create_dir succeeded {winners} times for one name"
+            );
+            let listed = fs.read_dir(path!("/")).unwrap().count();
+            assert_eq!(listed, 1, "the parent lists {listed} entries");
+            fs.remove_dir(path!("/race"))
+                .expect("remove the winner's directory");
+        }
+    }
+
+    #[test]
