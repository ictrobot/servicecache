+    #[test]
+    fn socket_closes_when_its_last_handle_is_removed() {
+        let close_calls = Arc::new(AtomicUsize::new(0));
+        let mut first = FdList::new();
+        first.insert_first_free(socket_fd(close_calls.clone()));
+        let mut second = first.clone();
+
+        first.remove(0).unwrap();
+        assert_eq!(close_calls.load(Ordering::Relaxed), 0);
+
+        second.remove(0).unwrap();
+        assert_eq!(close_calls.load(Ordering::Relaxed), 1);
+    }
+
