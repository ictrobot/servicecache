@@ -87,6 +87,16 @@ impl CloseFdOutcome {
     }
 }
 
+/// Flush a file's shared host handle, holding its lock across the whole flush
+/// as a write does. The handle's flush can wait on a write still under way;
+/// had the lock been released between polls, a write from another thread could
+/// take over that wait's wakeup, and the flush would never be polled again.
+#[allow(clippy::await_holding_lock)]
+pub(crate) async fn flush_file(file: VirtualFileLock) -> Result<(), Errno> {
+    let mut file = file.write().unwrap();
+    file.flush().await.map_err(|_| Errno::Io)
+}
+
 impl Future for FlushPoller {
     type Output = Result<(), Errno>;
 
