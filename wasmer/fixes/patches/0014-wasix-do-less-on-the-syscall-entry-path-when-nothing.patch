+    #[test]
+    fn timed_signals_are_announced_without_the_inner_lock() {
+        let plane = WasiControlPlane::default();
+        let process = plane.new_process(ModuleHash::random()).unwrap();
+        assert!(!process.has_signal_intervals());
+
+        process.signal_interval(Signal::Sigalrm, Some(Duration::from_millis(10)), true);
+        assert!(process.has_signal_intervals());
+        assert_eq!(process.lock().signal_intervals.len(), 1);
+
+        // A second clock does not hide the first when it is taken away.
+        process.signal_interval(Signal::Sigvtalrm, Some(Duration::from_millis(20)), false);
+        process.signal_interval(Signal::Sigalrm, None, false);
+        assert!(process.has_signal_intervals());
+        assert_eq!(process.lock().signal_intervals.len(), 1);
+
+        process.signal_interval(Signal::Sigvtalrm, None, false);
+        assert!(!process.has_signal_intervals());
+        assert!(process.lock().signal_intervals.is_empty());
+    }
+
+    #[test]
+    fn timed_signals_are_announced_to_every_handle_of_the_process() {
+        let plane = WasiControlPlane::default();
+        let process = plane.new_process(ModuleHash::random()).unwrap();
+        let other_handle = process.clone();
+
+        process.signal_interval(Signal::Sigalrm, Some(Duration::from_millis(10)), true);
+        assert!(other_handle.has_signal_intervals());
+
+        other_handle.signal_interval(Signal::Sigalrm, None, false);
+        assert!(!process.has_signal_intervals());
+    }
+
+    #[test]
+    fn a_removed_timed_signal_that_was_never_there_announces_nothing() {
+        let plane = WasiControlPlane::default();
+        let process = plane.new_process(ModuleHash::random()).unwrap();
+
+        process.signal_interval(Signal::Sigalrm, None, false);
+        assert!(!process.has_signal_intervals());
+    }
 }
