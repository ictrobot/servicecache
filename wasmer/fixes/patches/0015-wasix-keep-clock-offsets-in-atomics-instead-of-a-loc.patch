+/// The number of clocks a guest can put an offset on, one slot each.
+const ADJUSTABLE_CLOCKS: usize = 4;
+
+/// The slot in `WasiState::clock_offsets` that holds the given clock's
+/// offset, or None for a clock that cannot carry one.
+fn clock_slot(clock_id: Snapshot0Clockid) -> Option<usize> {
+    match clock_id {
+        Snapshot0Clockid::Realtime => Some(0),
+        Snapshot0Clockid::Monotonic => Some(1),
+        Snapshot0Clockid::ProcessCputimeId => Some(2),
+        Snapshot0Clockid::ThreadCputimeId => Some(3),
+        // Unknown, and anything the enum gains later: reading such a clock
+        // fails in the platform call before an offset is consulted, and
+        // setting one fails there before an offset is stored.
+        _ => None,
+    }
+}
+
 /// Top level data type containing all* the state with which WASI can
 /// interact.
 ///
@@ -131,7 +152,11 @@ pub(crate) struct WasiState {
     pub fs: WasiFs,
     pub inodes: WasiInodes,
     pub futexs: Mutex<WasiFutexState>,
-    pub clock_offset: Mutex<HashMap<Snapshot0Clockid, i64>>,
+    /// The offset the guest has put on each clock it can set, indexed by
+    /// `clock_slot`, in nanoseconds; zero, the value every clock starts
+    /// with, means the clock is read as the host reports it. Reached
+    /// through `clock_offset` and `set_clock_offset` only.
+    clock_offsets: [AtomicI64; ADJUSTABLE_CLOCKS],
     pub args: Mutex<Vec<String>>,
     pub envs: Mutex<Vec<Vec<u8>>>,
     pub signals: Mutex<HashMap<Signal, Disposition>>,
@@ -151,10 +176,36 @@ impl WasiState {
     //         preopen: Vec::new(),
     //         threading: Default::default(),
     //         futexs: Default::default(),
-    //         clock_offset: Default::default(),
+    //         clock_offsets: Default::default(),
     //         envs: Vec::new(),
     //     }
     // }
+
+    /// The offset the guest has put on the given clock, in nanoseconds, or
+    /// zero if it has not set that clock.
+    ///
+    /// Relaxed is enough on both sides: the offset is a value in its own
+    /// right and orders nothing else, and a reading taken while another
+    /// thread is setting the clock may be taken either side of the set,
+    /// as one taken an instant earlier would have been.
+    pub fn clock_offset(&self, clock_id: Snapshot0Clockid) -> i64 {
+        match clock_slot(clock_id) {
+            Some(slot) => self.clock_offsets[slot].load(Ordering::Relaxed),
+            None => 0,
+        }
+    }
+
+    /// Puts the given offset, in nanoseconds, on the given clock.
+    pub fn set_clock_offset(&self, clock_id: Snapshot0Clockid, offset: i64) {
+        if let Some(slot) = clock_slot(clock_id) {
+            self.clock_offsets[slot].store(offset, Ordering::Relaxed);
+        }
+    }
+
+    /// The offsets of this state, for a state being made from it.
+    fn copy_clock_offsets(&self) -> [AtomicI64; ADJUSTABLE_CLOCKS] {
+        std::array::from_fn(|slot| AtomicI64::new(self.clock_offsets[slot].load(Ordering::Relaxed)))
+    }
 }
 
