+#[cfg(all(test, not(target_arch = "wasm32")))]
+mod tests {
+    use super::*;
+
+    fn new_init() -> WasiEnvInit {
+        WasiEnvBuilder::new("clock-offset")
+            .engine(wasmer::Engine::default())
+            .build_init()
+            .unwrap()
+    }
+
+    fn new_state() -> WasiState {
+        new_init().state
+    }
+
+    #[tokio::test]
+    async fn an_offset_set_on_a_clock_is_read_back() {
+        let state = new_state();
+        assert_eq!(state.clock_offset(Snapshot0Clockid::Realtime), 0);
+
+        state.set_clock_offset(Snapshot0Clockid::Realtime, 5_000);
+        assert_eq!(state.clock_offset(Snapshot0Clockid::Realtime), 5_000);
+        // Each clock carries its own offset, and one the guest has not set
+        // carries none.
+        assert_eq!(state.clock_offset(Snapshot0Clockid::Monotonic), 0);
+
+        state.set_clock_offset(Snapshot0Clockid::Realtime, -1);
+        assert_eq!(state.clock_offset(Snapshot0Clockid::Realtime), -1);
+    }
+
+    #[tokio::test]
+    async fn a_clock_that_cannot_carry_an_offset_reads_as_the_host_reports_it() {
+        let state = new_state();
+        state.set_clock_offset(Snapshot0Clockid::Unknown, 5_000);
+        assert_eq!(state.clock_offset(Snapshot0Clockid::Unknown), 0);
+    }
+
+    #[tokio::test]
+    async fn a_fork_keeps_the_offsets_of_the_state_it_came_from() {
+        let state = new_state();
+        assert_eq!(state.fork().clock_offset(Snapshot0Clockid::Realtime), 0);
+
+        state.set_clock_offset(Snapshot0Clockid::Realtime, 7_000);
+        let forked = state.fork();
+        assert_eq!(forked.clock_offset(Snapshot0Clockid::Realtime), 7_000);
+
+        // The two states diverge from there.
+        forked.set_clock_offset(Snapshot0Clockid::Monotonic, 9);
+        assert_eq!(state.clock_offset(Snapshot0Clockid::Monotonic), 0);
+    }
+
+    #[tokio::test]
+    async fn a_duplicated_init_keeps_them_as_well() {
+        let init = new_init();
+        init.state
+            .set_clock_offset(Snapshot0Clockid::Realtime, 3_000);
+
+        let duplicate = init.duplicate();
+        assert_eq!(
+            duplicate.state.clock_offset(Snapshot0Clockid::Realtime),
+            3_000
+        );
+    }
+}
diff --git a/lib/wasix/src/syscalls/wasi/clock_time_get.rs b/lib/wasix/src/syscalls/wasi/clock_time_get.rs
index 2a77e9a..2c88778 100644
--- a/lib/wasix/src/syscalls/wasi/clock_time_get.rs
+++ b/lib/wasix/src/syscalls/wasi/clock_time_get.rs
@@ -36,12 +36,8 @@ pub fn clock_time_get<M: MemorySize>(
     let memory = unsafe { env.memory_view(&ctx) };
 
     let mut t_out = wasi_try_ok!(platform_clock_time_get(clock_id, precision));
-    {
-        let guard = env.state.clock_offset.lock().unwrap();
-        if let Some(offset) = guard.get(&clock_id) {
-            t_out += *offset;
-        }
-    };
+    // One atomic load, and zero unless the guest has set this clock.
+    t_out += env.state.clock_offset(clock_id);
     wasi_try_mem_ok!(time.write(&memory, t_out as Timestamp));
     Ok(Errno::Success)
 }
