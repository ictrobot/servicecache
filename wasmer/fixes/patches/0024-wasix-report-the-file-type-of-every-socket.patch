         inner.poll_read_ready(cx)
diff --git a/lib/wasix/src/syscalls/wasi/fd_filestat_get.rs b/lib/wasix/src/syscalls/wasi/fd_filestat_get.rs
index b1974c3..65cac9f 100644
--- a/lib/wasix/src/syscalls/wasi/fd_filestat_get.rs
+++ b/lib/wasix/src/syscalls/wasi/fd_filestat_get.rs
@@ -55,8 +55,13 @@ pub(crate) fn fd_filestat_get_internal(
         return Err(Errno::Access);
     }
 
-    let guard = fd_entry.inode.stat.read().unwrap();
-    Ok(*guard.deref())
+    let mut stat = *fd_entry.inode.stat.read().unwrap();
+    // A socket's inode keeps the default stat it was created with, whose type
+    // is unknown; the socket says what it is.
+    if let Kind::Socket { socket } = fd_entry.inode.read().deref() {
+        stat.st_filetype = socket.filetype();
+    }
+    Ok(stat)
 }
 
