+    /// The socket's file type, as fd_fdstat_get and fd_filestat_get report
+    /// it: the type its kind implies, or the one it was created with.
+    pub(crate) fn filetype(&self) -> Filetype {
+        match &self.inner.protected.read().unwrap().kind {
+            InodeSocketKind::TcpStream { .. } | InodeSocketKind::TcpListener { .. } => {
+                Filetype::SocketStream
+            }
+            InodeSocketKind::UdpSocket { .. } => Filetype::SocketDgram,
+            InodeSocketKind::Raw(_) => Filetype::SocketRaw,
+            InodeSocketKind::PreSocket { props, .. }
+            | InodeSocketKind::BoundTcp { props, .. }
+            | InodeSocketKind::RemoteSocket { props, .. } => match props.ty {
+                Socktype::Stream => Filetype::SocketStream,
+                Socktype::Dgram => Filetype::SocketDgram,
+                Socktype::Raw => Filetype::SocketRaw,
+                Socktype::Seqpacket => Filetype::SocketSeqpacket,
+                _ => Filetype::Unknown,
+            },
+            // An ICMP socket may be a datagram or a raw one, which its kind
+            // does not record.
+            InodeSocketKind::Icmp(_) => Filetype::Unknown,
+        }
+    }
+
     pub fn poll_read_ready(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<usize>> {
