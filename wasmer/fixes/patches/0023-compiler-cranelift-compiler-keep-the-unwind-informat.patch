diff --git a/lib/compiler-cranelift/src/elf.rs b/lib/compiler-cranelift/src/elf.rs
index 0684304..fb605d1 100644
--- a/lib/compiler-cranelift/src/elf.rs
+++ b/lib/compiler-cranelift/src/elf.rs
@@ -37,6 +37,47 @@ use wasmer_compiler::{
 };
 use wasmer_types::{CompileError, LocalFunctionIndex, target::Target};
 
+pub(crate) fn emit_trampoline(
+    #[cfg(feature = "unwind")] isa: &dyn TargetIsa,
+    target: &Target,
+    kind: &CompiledKind,
+    trampoline: &crate::trampoline::CompiledTrampoline,
+) -> Result<Vec<u8>, CompileError> {
+    #[allow(unused_mut, unused_variables)]
+    let (mut object, symbol) =
+        wasmer_compiler::elf::function_body_object(target, kind, &trampoline.body)?;
+    #[cfg(feature = "unwind")]
+    if let Some(fde) = &trampoline.fde
+        && let Some(mut cie) = isa.create_systemv_cie()
+    {
+        cie.fde_address_encoding = constants::DW_EH_PE_pcrel | constants::DW_EH_PE_sdata4;
+        let mut table = FrameTable::default();
+        let cie = table.add_cie(cie);
+        table.add_fde(
+            cie,
+            fde.to_fde(Address::Symbol {
+                symbol: WriterRelocate::FUNCTION_SYMBOL,
+                addend: 0,
+            }),
+        );
+        let mut frame = EhFrame(EhFrameWriter::new());
+        table
+            .write_eh_frame(&mut frame)
+            .map_err(|e| CompileError::Codegen(format!("failed to write trampoline CFI: {e}")))?;
+        let relocations = std::mem::take(&mut frame.0.relocs);
+        emit_eh_frame_section(
+            &mut object,
+            &frame.0.into_bytes(),
+            &relocations,
+            symbol,
+            None,
+        )?;
+    }
+    object
+        .write()
+        .map_err(|e| CompileError::Codegen(format!("failed to serialize trampoline: {e}")))
+}
