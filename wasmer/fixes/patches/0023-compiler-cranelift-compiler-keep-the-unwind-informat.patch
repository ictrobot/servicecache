+/// A trampoline and the System V unwind program collected during codegen.
+/// The FDE is attached to its final symbol when the module is assembled.
+pub(crate) struct CompiledTrampoline {
+    pub body: FunctionBody,
+    #[cfg(feature = "unwind")]
+    pub fde: Option<cranelift_codegen::isa::unwind::systemv::UnwindInfo>,
+}
+
+impl CompiledTrampoline {
+    pub fn new(body: Vec<u8>, unwind: CraneliftUnwindInfo) -> Self {
+        #[cfg(feature = "unwind")]
+        if let CraneliftUnwindInfo::Fde(fde) = unwind {
+            return Self {
+                body: FunctionBody {
+                    body,
+                    unwind_info: None,
+                },
+                fde: Some(fde),
+            };
+        }
+        Self {
+            body: FunctionBody {
+                body,
+                unwind_info: unwind.maybe_into_to_windows_unwind(),
+            },
+            #[cfg(feature = "unwind")]
+            fde: None,
+        }
+    }
+}
