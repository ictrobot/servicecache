+#[cfg(all(test, feature = "unwind", target_os = "linux"))]
+mod tests {
+    use super::*;
+    use cranelift_codegen::gimli::{BaseAddresses, CieOrFde, EhFrame, LittleEndian, UnwindSection};
+    use object::{Object, ObjectSection};
+    use wasmer_compiler::ModuleEnvironment;
+
+    fn fde_count(bytes: &[u8]) -> usize {
+        let mut frame = EhFrame::new(bytes, LittleEndian);
+        frame.set_address_size(8);
+        let bases = BaseAddresses::default().set_eh_frame(0);
+        let mut entries = frame.entries(&bases);
+        let mut count = 0;
+        while let Some(entry) = entries.next().unwrap() {
+            if let CieOrFde::Fde(fde) = entry {
+                let fde = fde.parse(EhFrame::cie_from_offset).unwrap();
+                assert!(fde.len() > 0);
+                count += 1;
+            }
+        }
+        count
+    }
+
+    #[test]
+    fn import_only_module_retains_both_trampoline_fdes() {
+        // (module (import "env" "f" (func))) -- no local function bodies.
+        let wasm = b"\0asm\x01\0\0\0\x01\x04\x01\x60\0\0\x02\x09\x01\x03env\x01f\0\0";
+        let translation = ModuleEnvironment::new().translate(wasm).unwrap();
+        let info = CompileModuleInfo {
+            module: Arc::new(translation.module),
+            features: Default::default(),
+            memory_styles: Default::default(),
+            table_styles: Default::default(),
+            function_max_stack_usage: Default::default(),
+        };
+        let result = CraneliftCompiler::new(Cranelift::default())
+            .compile_module(
+                &Target::default(),
+                &info,
+                &[],
+                translation.module_translation_state.as_ref().unwrap(),
+                translation.function_body_inputs,
+                None,
+            )
+            .unwrap();
+        let Compilation::Rkyv { compilation, .. } = result else {
+            panic!("expected rkyv");
+        };
+        let frame = &compilation.custom_sections[compilation.unwind_info.eh_frame.unwrap()];
+        assert_eq!(fde_count(frame.bytes.as_slice()), 2);
+        for target in [
+            RelocationTarget::FunctionCallTrampoline(SignatureIndex::from_u32(0)),
+            RelocationTarget::DynamicTrampoline(FunctionIndex::from_u32(0)),
+        ] {
+            assert!(frame.relocations.iter().any(|r| r.reloc_target == target));
+        }
+        for body in compilation
+            .function_call_trampolines
+            .values()
+            .chain(compilation.dynamic_function_trampolines.values())
+        {
+            assert_eq!(body.unwind_info, Some(CompiledFunctionUnwindInfo::Dwarf));
+        }
+    }
+
+    #[test]
+    fn native_trampolines_have_relocatable_cfi() {
+        for triple in ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"] {
+            let mut cpu_features = wasmer_types::target::CpuFeature::set();
+            if triple.starts_with("x86_64") {
+                cpu_features.insert(wasmer_types::target::CpuFeature::SSE2);
+            }
+            let target = Target::new(triple.parse().unwrap(), cpu_features);
+            let isa = Cranelift::default().isa(&target).unwrap();
+            let signature = wasmer_types::FunctionType::new(
+                [wasmer_types::Type::I64; 10],
+                [wasmer_types::Type::I64],
+            );
+            let mut context = FunctionBuilderContext::new();
+            let call = wasmer_compiler::misc::CompiledKind::FunctionCallTrampoline(
+                SignatureIndex::from_u32(0),
+                signature.clone(),
+            );
+            let dynamic = wasmer_compiler::misc::CompiledKind::DynamicFunctionTrampoline(
+                FunctionIndex::from_u32(0),
+                signature.clone(),
+            );
+            let call_body = compile_trampoline_function_call(
+                &None,
+                &*isa,
+                target.triple().architecture,
+                &mut context,
+                &call,
+                &signature,
+                &None,
+            )
+            .unwrap();
+            let dynamic_body = make_trampoline_dynamic_function(
+                &None,
+                &*isa,
+                target.triple().architecture,
+                &wasmer_types::VMOffsets::new_for_trampolines(8),
+                &mut context,
+                &dynamic,
+                &signature,
+                &None,
+            )
+            .unwrap();
+            for (kind, body) in [(call, call_body), (dynamic, dynamic_body)] {
+                assert!(body.fde.is_some(), "{triple}: {kind:?}");
+                let bytes = crate::elf::emit_trampoline(&*isa, &target, &kind, &body).unwrap();
+                let object = object::File::parse(bytes.as_slice()).unwrap();
+                let frame = object.section_by_name(".eh_frame").unwrap();
+                assert_eq!(fde_count(frame.data().unwrap()), 1);
+                assert_eq!(frame.relocations().count(), 1);
+            }
+        }
+    }
+}
