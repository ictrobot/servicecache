+/// Whether the kernel holds bytes for a connected socket, asked without
+/// taking any.
+#[cfg(not(target_os = "windows"))]
+fn bytes_pending(stream: &mio::net::TcpStream) -> bool {
+    libc_poll(stream.as_raw_fd(), libc::POLLIN).is_some_and(|events| events & libc::POLLIN != 0)
+}
+
+/// One byte peeked through mio, so that a socket found empty re-arms mio's
+/// one-shot readiness by answering WouldBlock.
+#[cfg(target_os = "windows")]
+fn bytes_pending(stream: &mio::net::TcpStream) -> bool {
+    let mut probe = [0u8; 1];
+    matches!(stream.peek(&mut probe), Ok(n) if n > 0)
+}
