+    /// Accepts one connection on a fresh listener and hands back both
+    /// ends, with the listener kept alive so the connection stays up.
+    fn connected_pair(
+        selector: &Arc<Selector>,
+    ) -> (
+        LocalTcpListener,
+        TcpStream,
+        Box<dyn VirtualTcpSocket + Sync>,
+    ) {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let addr = listener.local_addr().unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let mut listener = LocalTcpListener {
+            stream: mio::net::TcpListener::from_std(listener),
+            selector: selector.clone(),
+            handler_guard: HandlerGuardState::None,
+            no_delay: None,
+            keep_alive: None,
+            backlog: Default::default(),
+            ruleset: None,
+        };
+        let client = TcpStream::connect(addr).unwrap();
+        let stream = loop {
+            match listener.try_accept() {
+                Ok((stream, _)) => break stream,
+                Err(_) => std::thread::sleep(Duration::from_millis(5)),
+            }
+        };
+        (listener, client, stream)
+    }
+
+    /// Readiness is the kernel's, peeked rather than taken: an empty
+    /// socket is not ready, and one holding bytes says so without moving
+    /// any of them out of the kernel, so the stream holds nothing of its
+    /// own and a wait on its descriptor sees everything.
+    #[test]
+    fn a_stream_is_ready_when_the_kernel_holds_bytes() {
+        let selector = Selector::new();
+        let (_listener, mut client, mut stream) = connected_pair(&selector);
+        let waker = std::task::Waker::noop();
+        let mut cx = std::task::Context::from_waker(waker);
+
+        assert!(matches!(stream.poll_read_ready(&mut cx), Poll::Pending));
+
+        client.write_all(b"hello").unwrap();
+        loop {
+            match stream.poll_read_ready(&mut cx) {
+                Poll::Ready(Ok(1)) => break,
+                Poll::Pending => std::thread::sleep(Duration::from_millis(5)),
+                other => panic!("unexpected readiness {other:?}"),
+            }
+        }
+
+        // Asking did not take the bytes: the receive that follows gets all
+        // of them, and the socket is then not ready again.
+        let mut buf = [MaybeUninit::new(0u8); 8];
+        assert_eq!(stream.try_recv(&mut buf, false).unwrap(), 5);
+        assert!(matches!(stream.poll_read_ready(&mut cx), Poll::Pending));
+        selector.shutdown();
+    }
+
+    /// A peer that has gone away leaves a socket that holds no bytes and
+    /// is still ready: the peek reports nothing, and the receive that
+    /// follows reports the end of the stream.
+    #[test]
+    fn a_stream_whose_peer_has_gone_is_an_end_of_stream() {
+        let selector = Selector::new();
+        let (_listener, client, mut stream) = connected_pair(&selector);
+        let waker = std::task::Waker::noop();
+        let mut cx = std::task::Context::from_waker(waker);
+
+        assert!(matches!(stream.poll_read_ready(&mut cx), Poll::Pending));
+        drop(client);
+        loop {
+            match stream.poll_read_ready(&mut cx) {
+                Poll::Ready(Ok(0)) => break,
+                Poll::Pending => std::thread::sleep(Duration::from_millis(5)),
+                other => panic!("unexpected readiness {other:?}"),
+            }
+        }
+        let mut buf = [MaybeUninit::new(0u8); 8];
+        assert_eq!(stream.try_recv(&mut buf, false).unwrap(), 0);
+        selector.shutdown();
+    }
+
+    /// mio reports transitions and the guest's epoll is level triggered,
+    /// so a receive that cannot have drained the socket asserts what is
+    /// left rather than waiting for an edge that will not come: a read
+    /// that filled the buffer it was given, and a peek, which takes
+    /// nothing at all. A read that emptied the socket asserts nothing.
+    #[test]
+    fn a_receive_that_leaves_bytes_behind_reasserts_readability() {
+        let selector = Selector::new();
+        let (_listener, mut client, mut stream) = connected_pair(&selector);
+        let (sender, receiver) = mpsc::channel();
+        stream
+            .set_handler(Box::new(ChannelHandler(sender)))
+            .unwrap();
+
+        client.write_all(b"abcd").unwrap();
+        expect_readable(&receiver);
+        while receiver.try_recv().is_ok() {}
+
+        let mut buf = [MaybeUninit::new(0u8); 2];
+        assert_eq!(stream.try_recv(&mut buf, true).unwrap(), 2);
+        expect_readable(&receiver);
+        while receiver.try_recv().is_ok() {}
+
+        assert_eq!(stream.try_recv(&mut buf, false).unwrap(), 2);
+        expect_readable(&receiver);
+        while receiver.try_recv().is_ok() {}
+
+        let mut rest = [MaybeUninit::new(0u8); 8];
+        assert_eq!(stream.try_recv(&mut rest, false).unwrap(), 2);
+        assert!(receiver.try_recv().is_err());
+        selector.shutdown();
+    }
