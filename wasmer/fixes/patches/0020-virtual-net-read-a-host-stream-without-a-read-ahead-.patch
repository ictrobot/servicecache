+    /// receive on such a socket costs no syscall for this.
+    fn reassert_readable_if_ready(&mut self) {
+        let guard = match &mut self.handler_guard {
+            HandlerGuardState::ExternalHandler(guard) | HandlerGuardState::WakerMap(guard, _) => {
+                guard
+            }
