+
+    /// A task manager that counts the timers it is asked to arm. A deadline
+    /// only ever sleeps, so nothing else is expected of it.
+    #[cfg(feature = "sys")]
+    #[derive(Debug, Default)]
+    struct CountingSleeps(AtomicUsize);
+
+    #[cfg(feature = "sys")]
+    impl CountingSleeps {
+        fn armed(&self) -> usize {
+            self.0.load(Ordering::Relaxed)
+        }
+    }
+
+    #[cfg(feature = "sys")]
+    impl crate::runtime::task_manager::VirtualTaskManager for CountingSleeps {
+        fn sleep_now(
+            &self,
+            time: Duration,
+        ) -> Pin<Box<dyn std::future::Future<Output = ()> + Send + Sync + 'static>> {
+            self.0.fetch_add(1, Ordering::Relaxed);
+            Box::pin(tokio::time::sleep(time))
+        }
+
+        fn task_shared(
+            &self,
+            _task: Box<dyn FnOnce() -> futures::future::BoxFuture<'static, ()> + Send + 'static>,
+        ) -> Result<(), crate::os::task::thread::WasiThreadError> {
+            unreachable!("a deadline only sleeps")
+        }
+
+        fn task_wasm(
+            &self,
+            _task: crate::runtime::task_manager::TaskWasm,
+        ) -> Result<(), crate::os::task::thread::WasiThreadError> {
+            unreachable!("a deadline only sleeps")
+        }
+
+        fn task_dedicated(
+            &self,
+            _task: Box<dyn FnOnce() + Send + 'static>,
+        ) -> Result<(), crate::os::task::thread::WasiThreadError> {
+            unreachable!("a deadline only sleeps")
+        }
+
+        fn thread_parallelism(&self) -> Result<usize, crate::os::task::thread::WasiThreadError> {
+            Ok(1)
+        }
+    }
+
+    #[cfg(feature = "sys")]
+    #[tokio::test(flavor = "current_thread")]
+    async fn deadline_without_a_timeout_arms_no_timer() {
+        let tasks = CountingSleeps::default();
+        let mut deadline = Box::pin(super::deadline(&tasks, None));
+
+        let waker = futures::task::noop_waker();
+        let mut cx = Context::from_waker(&waker);
+        // No timer is armed, so nothing can ever make it ready: the operation
+        // it guards waits for as long as it takes.
+        assert!(deadline.as_mut().poll(&mut cx).is_pending());
+        assert!(deadline.as_mut().poll(&mut cx).is_pending());
+        assert_eq!(
+            tasks.armed(),
+            0,
+            "a deadline without a timeout armed a timer"
+        );
+    }
+
+    #[cfg(feature = "sys")]
+    #[tokio::test(flavor = "current_thread")]
+    async fn deadline_with_a_timeout_expires() {
+        let tasks = CountingSleeps::default();
+        super::deadline(&tasks, Some(Duration::from_millis(1))).await;
+        assert_eq!(tasks.armed(), 1, "a deadline with a timeout arms one timer");
+    }
 }
