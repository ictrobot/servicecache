+/// The deadline of a socket operation whose timeout may be unset.
+///
+/// A socket that carries no timeout for an operation blocks until the
+/// operation completes, as it does on Linux when the matching socket option
+/// was never set, so this future simply never completes and the operation it
+/// is selected against decides on its own. Nothing is armed in that case: a
+/// timeout costs a timer registration in the task manager on every call, and
+/// the sockets that guests use most - the ones an event loop drives with no
+/// timeout at all - would pay it for a deadline that cannot be reached.
+async fn deadline(tasks: &dyn VirtualTaskManager, timeout: Option<Duration>) {
+    match timeout {
+        Some(timeout) => tasks.sleep_now(timeout).await,
+        None => std::future::pending().await,
+    }
+}
