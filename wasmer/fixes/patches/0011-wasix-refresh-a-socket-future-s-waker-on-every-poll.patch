+    /// A listener that never has a connection, and keeps whatever handler
+    /// it was last given so a test can fire it.
+    #[derive(Debug)]
+    struct BlockedListener {
+        handler: Arc<std::sync::Mutex<Option<Box<dyn InterestHandler + Send + Sync>>>>,
+        registrations: Arc<AtomicUsize>,
+    }
+
+    impl VirtualIoSource for BlockedListener {
+        fn remove_handler(&mut self) {
+            *self.handler.lock().unwrap() = None;
+        }
+
+        fn poll_read_ready(&mut self, _cx: &mut Context<'_>) -> Poll<NetResult<usize>> {
+            Poll::Pending
+        }
+
+        fn poll_write_ready(&mut self, _cx: &mut Context<'_>) -> Poll<NetResult<usize>> {
+            Poll::Pending
+        }
+    }
+
+    impl virtual_net::VirtualTcpListener for BlockedListener {
+        fn try_accept(&mut self) -> NetResult<(Box<dyn VirtualTcpSocket + Sync>, SocketAddr)> {
+            Err(NetworkError::WouldBlock)
+        }
+
+        fn set_handler(
+            &mut self,
+            handler: Box<dyn InterestHandler + Send + Sync>,
+        ) -> NetResult<()> {
+            self.registrations.fetch_add(1, Ordering::Relaxed);
+            *self.handler.lock().unwrap() = Some(handler);
+            Ok(())
+        }
+
+        fn addr_local(&self) -> NetResult<SocketAddr> {
+            Ok(SocketAddr::from((Ipv4Addr::LOCALHOST, 0)))
+        }
+
+        fn set_ttl(&mut self, _ttl: u8) -> NetResult<()> {
+            Ok(())
+        }
+
+        fn ttl(&self) -> NetResult<u8> {
+            Ok(64)
+        }
+    }
+
+    /// A waker that records that it was woken.
+    #[derive(Debug, Default)]
+    struct Flag(std::sync::atomic::AtomicBool);
+
+    impl Flag {
+        fn woken(&self) -> bool {
+            self.0.load(Ordering::SeqCst)
+        }
+    }
+
+    impl std::task::Wake for Flag {
+        fn wake(self: Arc<Self>) {
+            self.wake_by_ref();
+        }
+
+        fn wake_by_ref(self: &Arc<Self>) {
+            self.0.store(true, Ordering::SeqCst);
+        }
+    }
+
+    /// A pending accept must register the waker of the poll it is pending
+    /// on, not the waker of the poll that first found the socket empty.
+    /// Whoever polls it last is who is waiting: a future is not promised to
+    /// the task that polled it first, and a handler left naming an earlier
+    /// task wakes nobody who cares.
+    #[cfg(feature = "sys")]
+    #[tokio::test(flavor = "current_thread")]
+    async fn accept_registers_the_waker_of_every_poll() {
+        use std::future::Future;
+
+        let handler = Arc::new(std::sync::Mutex::new(None));
+        let registrations = Arc::new(AtomicUsize::new(0));
+        let inode = InodeSocket::new(InodeSocketKind::TcpListener {
+            socket: Box::new(BlockedListener {
+                handler: handler.clone(),
+                registrations: registrations.clone(),
+            }),
+            accept_timeout: None,
+        });
+        let tasks = crate::runtime::task_manager::tokio::TokioTaskManager::default();
+
+        let first = Arc::new(Flag::default());
+        let second = Arc::new(Flag::default());
+        let mut accept = Box::pin(inode.accept(&tasks, false, None));
+        assert!(
+            accept
+                .as_mut()
+                .poll(&mut Context::from_waker(&std::task::Waker::from(
+                    first.clone()
+                )))
+                .is_pending()
+        );
+        assert!(registrations.load(Ordering::Relaxed) >= 1);
+        // The second poll stands for a poll made by another task, such as
+        // a coroutine resumed on a thread of its own after the thread that
+        // polled first has gone.
+        assert!(
+            accept
+                .as_mut()
+                .poll(&mut Context::from_waker(&std::task::Waker::from(
+                    second.clone()
+                )))
+                .is_pending()
+        );
+
+        handler
+            .lock()
+            .unwrap()
+            .as_mut()
+            .expect("a pending accept registers a handler")
+            .push_interest(virtual_mio::InterestType::Readable);
+        assert!(second.woken(), "the latest poll's waker was not registered");
+        assert!(!first.woken(), "the stale waker was woken instead");
+    }
 }
