+/// One registration. Each handler carries its own lock so that dispatch
+/// can call it with the registry lock released.
+type Registration = Arc<StdMutex<Box<dyn InterestHandler>>>;
+
+#[derive(Debug, Default)]
+struct EpollInterestRegistryInner {
+    next_id: u64,
+    handlers: FnvHashMap<u64, Registration>,
+}
+
+/// Fans readiness from a source's single handler slot out to every epoll
+/// instance watching that open file description.
+#[derive(Debug, Default)]
+pub(crate) struct EpollInterestRegistry {
+    inner: StdMutex<EpollInterestRegistryInner>,
+}
+
+impl EpollInterestRegistry {
+    fn subscribe<E, F>(
+        self: &Arc<Self>,
+        handler: Box<dyn InterestHandler>,
+        install: F,
+    ) -> Result<u64, E>
+    where
+        F: FnOnce(Box<dyn InterestHandler>) -> Result<(), E>,
+    {
+        let id = {
+            let mut inner = self.inner.lock().unwrap();
+            let id = inner.next_id;
+            inner.next_id = inner.next_id.wrapping_add(1);
+            inner.handlers.insert(id, Arc::new(StdMutex::new(handler)));
+            id
+        };
+
+        // The dispatcher is installed on the source for every subscription,
+        // not only the first: installing is what replays the source's
+        // current readiness, and a registration added later — an interest
+        // switch on a live descriptor — must observe the level-triggered
+        // state it joined. The replay reaches every registration, and the
+        // spurious level events the others receive are within epoll
+        // semantics. The lock is not held across the install, because the
+        // replay re-enters the registry to dispatch.
+        match install(Box::new(EpollInterestDispatcher::new(self.clone()))) {
+            Ok(()) => Ok(id),
+            Err(error) => {
+                self.inner.lock().unwrap().handlers.remove(&id);
+                Err(error)
+            }
+        }
+    }
+
+    fn unsubscribe(&self, id: u64) {
+        self.inner.lock().unwrap().handlers.remove(&id);
+    }
+
+    /// Copies the registrations to call into the caller's buffer. Dispatch
+    /// must not hold the registry lock while a handler runs: an
+    /// EpollHandler upgrades its weak references, and when the guest has
+    /// just closed that epoll set the upgrade it drops at the end of the
+    /// call is the last strong reference, so the drop runs the set's join
+    /// guards, each of which unsubscribes here. Taking the lock again on
+    /// the dispatching thread would deadlock the selector and silence
+    /// every socket in the process, so the registrations are copied out,
+    /// the lock released, and each handler called under its own lock. A
+    /// registration removed in the meantime may still be called once, which
+    /// is harmless: its weak references fail to upgrade once the epoll set
+    /// is gone, and an event queued for a deleted subscription is dropped as
+    /// stale when the set is drained.
+    fn snapshot_into(&self, out: &mut Vec<Registration>) {
+        out.clear();
+        out.extend(self.inner.lock().unwrap().handlers.values().cloned());
+    }
+
+    #[cfg(test)]
+    fn handler_count(&self) -> usize {
+        self.inner.lock().unwrap().handlers.len()
+    }
+}
+
+#[derive(Debug)]
+struct EpollInterestDispatcher {
+    registry: Arc<EpollInterestRegistry>,
+    /// The registrations of the dispatch in progress. Kept between events
+    /// so that the steady state allocates nothing, and emptied again at
+    /// the end of every dispatch so that it holds no registration alive.
+    /// One small buffer per watched source.
+    scratch: Vec<Registration>,
+}
+
+impl EpollInterestDispatcher {
+    fn new(registry: Arc<EpollInterestRegistry>) -> Self {
+        Self {
+            registry,
+            scratch: Vec::new(),
+        }
+    }
+}
+
+impl InterestHandler for EpollInterestDispatcher {
+    fn push_interest(&mut self, interest: InterestType) {
+        self.registry.snapshot_into(&mut self.scratch);
+        for handler in &self.scratch {
+            handler.lock().unwrap().push_interest(interest);
+        }
+        self.scratch.clear();
+    }
+
+    fn pop_interest(&mut self, interest: InterestType) -> bool {
+        self.registry.snapshot_into(&mut self.scratch);
+        let mut popped = false;
+        for handler in &self.scratch {
+            popped |= handler.lock().unwrap().pop_interest(interest);
+        }
+        self.scratch.clear();
+        popped
+    }
+
+    fn has_interest(&self, interest: InterestType) -> bool {
+        // The one path without a buffer to reuse, and the rare one.
+        let mut handlers = Vec::new();
+        self.registry.snapshot_into(&mut handlers);
+        handlers
+            .into_iter()
+            .any(|handler| handler.lock().unwrap().has_interest(interest))
+    }
+}
