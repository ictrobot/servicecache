+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::os::task::control_plane::WasiControlPlane;
+    use wasmer_types::ModuleHash;
+
+    fn new_thread() -> WasiThreadHandle {
+        let plane = WasiControlPlane::default();
+        let process = plane.new_process(ModuleHash::random()).unwrap();
+        process
+            .new_thread(WasiMemoryLayout::default(), ThreadStartType::MainThread)
+            .unwrap()
+    }
+
+    #[test]
+    fn a_signal_queued_after_a_pop_is_seen_by_the_next_one() {
+        let handle = new_thread();
+        let thread = handle.as_thread();
+
+        assert!(thread.pop_signals().is_empty());
+        thread.signal(Signal::Sigusr1);
+        assert_eq!(thread.pop_signals(), vec![Signal::Sigusr1]);
+        assert!(thread.pop_signals().is_empty());
+
+        thread.signal(Signal::Sigusr2);
+        assert_eq!(thread.pop_signals(), vec![Signal::Sigusr2]);
+        assert!(thread.pop_signals().is_empty());
+    }
+
+    #[test]
+    fn a_subscribing_pop_leaves_nothing_behind_either() {
+        let handle = new_thread();
+        let thread = handle.as_thread();
+        let waker = Waker::noop();
+
+        assert!(thread.pop_signals_or_subscribe(waker).is_none());
+        thread.signal(Signal::Sigusr1);
+        assert_eq!(
+            thread.pop_signals_or_subscribe(waker),
+            Some(vec![Signal::Sigusr1])
+        );
+        assert!(thread.pop_signals().is_empty());
+
+        thread.signal(Signal::Sigusr2);
+        assert_eq!(thread.pop_signals(), vec![Signal::Sigusr2]);
+    }
+
+    #[test]
+    fn a_finished_thread_is_seen_by_a_join_that_follows() {
+        let handle = new_thread();
+        let thread = handle.as_thread();
+
+        assert!(thread.try_join().is_none());
+        thread.set_status_running();
+        assert!(thread.try_join().is_none());
+
+        thread.set_status_finished(Ok(ExitCode::from(5)));
+        assert_eq!(thread.try_join().unwrap().unwrap(), ExitCode::from(5));
+    }
+}
