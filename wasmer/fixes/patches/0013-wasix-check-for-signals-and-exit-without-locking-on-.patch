+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_finished_task_is_seen_without_reading_the_watch() {
+        let status = OwnedTaskStatus::default();
+        assert!(status.try_finished().is_none());
+        status.set_running();
+        assert!(status.try_finished().is_none());
+
+        status.set_finished(Ok(ExitCode::from(3)));
+        assert_eq!(status.try_finished().unwrap().unwrap(), ExitCode::from(3));
+        // The first result stands, as it does in the watched status.
+        status.set_finished(Ok(ExitCode::from(4)));
+        assert_eq!(status.try_finished().unwrap().unwrap(), ExitCode::from(3));
+    }
+
+    #[test]
+    fn a_task_that_starts_finished_is_seen_the_same_way() {
+        let status = OwnedTaskStatus::new_finished_with_code(ExitCode::from(7));
+        assert_eq!(status.try_finished().unwrap().unwrap(), ExitCode::from(7));
+    }
+}
