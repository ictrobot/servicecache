+/// Whether `address` belongs to a linear-memory reservation whose base can
+/// never move. The caller separately validates that the word is currently
+/// accessible and aligned.
+pub(crate) fn stable_futex_address(address: *const u32) -> bool {
+    let start = address as usize;
+    if start % std::mem::align_of::<u32>() != 0 {
+        return false;
+    }
+    let Some(end) = start.checked_add(size_of::<u32>()) else {
+        return false;
+    };
+    LINEAR_MEMORIES
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .iter()
+        .filter_map(|entry| entry.stable_range)
+        .any(|(base, len)| {
+            base.checked_add(len)
+                .is_some_and(|memory_end| base <= start && end <= memory_end)
+        })
+}
