+impl SuspendedFutex {
+    fn result(self) -> Option<HostFutexResult> {
+        match unsafe { self.result.as_ref() }.load(Ordering::Acquire) {
+            FUTEX_PENDING => None,
+            value => Some(
+                HostFutexResult::try_from(value)
+                    .unwrap_or_else(|()| panic!("invalid stored futex result {value}")),
+            ),
