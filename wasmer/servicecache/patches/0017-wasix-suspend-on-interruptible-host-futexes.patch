+/// Waits on a direct host futex without remaining active while blocked. A
+/// gated top-level coroutine retires instead of completing the wait when a
+/// freeze starts.
+fn wait_futex(wait: SuspendedFutex, gate: Option<&mut dyn TopLevelCoro>) {
+    if wait.result().is_some() {
+        return;
+    }
+    loop {
+        if !try_enter(gate.is_some()) {
+            retire(gate.expect("only gated loops are refused"));
+        }
+        let gate_expected = GATE_EPOCH.load(Ordering::SeqCst);
+        if gate.is_some() && GATE_CLOSED.load(Ordering::SeqCst) {
+            leave();
+            retire(gate.expect("a closed gate only retires a gated loop"));
+        }
+        let hooks = FUTEX_HOOKS
+            .get()
+            .expect("a futex wait was yielded without host hooks");
+        let request = HostFutexWait {
+            futex: wait
+                .futex
+                .map(|(address, expected)| (address.as_ptr().cast_const(), expected)),
+            interrupt: wait.interrupt.as_ptr().cast(),
+            interrupt_expected: wait.interrupt_expected,
+            gate: (&GATE_EPOCH as *const AtomicU32).cast(),
+            gate_expected,
+            deadline: wait.deadline,
+        };
+        // The atomic vector wait itself must not count as active: the gate
+        // generation makes closing the gate race-free while it is asleep.
+        leave();
+        let result = (hooks.wait)(request);
+        if gate.is_some() && GATE_CLOSED.load(Ordering::SeqCst) {
+            retire(gate.expect("a closed gate only retires a gated loop"));
+        }
+        wait.complete(result);
+        return;
+    }
+}
