Subject: virtual-net: adopt a listening socket

A host that creates a guest's listening socket itself needs to hand it
to the guest as a `LocalTcpListener`: `from_std_listener` wraps a socket
that is already listening, and `LocalNetworking::selector` exposes the
selector it registers with.

diff --git a/lib/virtual-net/src/host.rs b/lib/virtual-net/src/host.rs
index 86f5499..85f847e 100644
--- a/lib/virtual-net/src/host.rs
+++ b/lib/virtual-net/src/host.rs
@@ -61,6 +61,11 @@ impl LocalNetworking {
             ruleset: Some(ruleset),
         }
     }
+
+    /// The selector this networking registers its sockets with.
+    pub fn selector(&self) -> &Arc<Selector> {
+        &self.selector
+    }
 }
 
 impl Drop for LocalNetworking {
@@ -304,6 +309,25 @@ pub struct LocalTcpListener {
 }
 
 impl LocalTcpListener {
+    /// Wraps a socket that is already listening, so that a host can give a
+    /// guest a listener it created itself.
+    pub fn from_std_listener(
+        listener: std::net::TcpListener,
+        selector: Arc<Selector>,
+    ) -> io::Result<Self> {
+        listener.set_nonblocking(true)?;
+        tracing::debug!(addr = ?listener.local_addr().ok(), "adopted a listening socket");
+        Ok(Self {
+            stream: mio::net::TcpListener::from_std(listener),
+            selector,
+            handler_guard: HandlerGuardState::None,
+            no_delay: None,
+            keep_alive: None,
+            backlog: Default::default(),
+            ruleset: None,
+        })
+    }
+
     /// mio delivers readiness transitions, while WASIX epoll is level
     /// triggered. If another connection remains after one accept, synthesize
     /// the level event that the guest's next epoll_wait expects.
