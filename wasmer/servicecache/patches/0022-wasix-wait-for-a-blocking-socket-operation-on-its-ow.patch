+/// Whether the calling thread can wait for a connection itself.
+fn direct_connect(env: &WasiEnv, nonblocking: bool) -> bool {
+    direct_socket_eligible(env, nonblocking)
+}
+
+/// Waits on this thread for a connection that has been started, and says
+/// how it ended.
+///
+/// A connecting descriptor becomes writable when its handshake finishes,
+/// whether it succeeded or not, and the socket's status is what tells the
+/// two apart: it reads the error the kernel latched (`SO_ERROR`) before
+/// it looks at the peer. The deadline is the connect timeout the caller
+/// read before the connection was started. `None` means this thread
+/// cannot do the wait and the existing one must.
+#[cfg(all(unix, feature = "direct-waits"))]
+fn direct_connect_finish(
+    env: &WasiEnv,
+    sock: WasiFd,
+    deadline: Option<Instant>,
+) -> Result<Option<Result<(), Errno>>, WasiError> {
+    let DirectSocketTarget::Wait(socket, _) = direct_socket_target(
+        env,
+        sock,
+        Rights::empty(),
+        crate::net::socket::TimeType::ConnectTimeout,
+    ) else {
+        return Ok(None);
+    };
+    loop {
+        match socket.status() {
+            Ok(crate::net::socket::WasiSocketStatus::Opened) => return Ok(Some(Ok(()))),
+            Ok(crate::net::socket::WasiSocketStatus::Opening) => {}
+            Ok(_) => {
+                // The error the kernel latched, which the status above
+                // has just read off the socket. A handshake that ended
+                // badly always has one; refusal is what a socket that
+                // cannot name its own failure is reported as.
+                let err = match socket.last_error() {
+                    Ok(Errno::Success) | Err(_) => Errno::Connrefused,
+                    Ok(err) => err,
+                };
+                return Ok(Some(Err(err)));
+            }
+            Err(err) => return Ok(Some(Err(err))),
+        }
+        match direct_socket_wait(
+            &env.thread,
+            &|| env.should_exit().is_some(),
+            &socket,
+            DirectSocketDirection::Write,
+            deadline,
+        ) {
+            Some(DirectSocketWait::Ready) => {}
+            Some(DirectSocketWait::TimedOut) => return Ok(Some(Err(Errno::Timedout))),
+            _ => return Ok(None),
+        }
+    }
+}
+
+#[cfg(not(all(unix, feature = "direct-waits")))]
+fn direct_connect_finish(
+    _env: &WasiEnv,
+    _sock: WasiFd,
+    _deadline: Option<Instant>,
+) -> Result<Option<Result<(), Errno>>, WasiError> {
+    Ok(None)
+}
+
+/// Waits for a started connection through the shared event selector, as
+/// the connect itself does when it is the one waiting, until the deadline
+/// the connect timeout set when the connection was started: a direct wait
+/// that was interrupted has used some of it, and only the rest is left.
+fn connect_wait_writable(
+    env: &WasiEnv,
+    sock: WasiFd,
+    deadline: Option<Instant>,
+) -> Result<(), Errno> {
+    let remaining = deadline.map(|deadline| deadline.saturating_duration_since(Instant::now()));
+    if remaining == Some(Duration::ZERO) {
+        return Err(Errno::Timedout);
+    }
+    let tasks = env.tasks().clone();
+    __sock_asyncify(env, sock, Rights::empty(), |mut socket, _| async move {
+        let writable = futures::future::poll_fn(|cx| Pin::new(&mut socket).poll_write_ready(cx));
+        match remaining {
+            Some(remaining) => tokio::select! {
+                res = writable => res.map(|_| ()).map_err(Errno::from),
+                _ = tasks.sleep_now(remaining) => Err(Errno::Timedout),
+            },
+            None => writable.await.map(|_| ()).map_err(Errno::from),
+        }
+    })
+}
