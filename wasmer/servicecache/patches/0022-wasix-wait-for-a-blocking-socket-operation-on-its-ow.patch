+/// Which readiness a blocking socket operation is waiting for.
+///
+/// Hangup and error are not named here: every kernel reports them whether
+/// or not they were asked for, and either one means the operation should
+/// be attempted again so that it can answer with the real error.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum DirectSocketDirection {
+    /// The operation is waiting for something to arrive: a byte, a
+    /// connection, or the end of the stream.
+    Read,
+    /// The operation is waiting for room to write, or for a connection in
+    /// progress to finish.
+    Write,
+}
+
+#[cfg(all(unix, feature = "direct-waits"))]
+impl DirectSocketDirection {
+    /// The readiness to ask the kernel for. A read also asks about the
+    /// peer shutting its writing half down, which is a level the
+    /// operation's own retry turns into an end of file.
+    fn wanted(self) -> u16 {
+        match self {
+            Self::Read => wasmer_vm::HOST_POLL_READ | wasmer_vm::HOST_POLL_RDHUP,
+            Self::Write => wasmer_vm::HOST_POLL_WRITE,
+        }
+    }
+}
+
+/// What one direct wait on a socket's own descriptor did.
+#[cfg(all(unix, feature = "direct-waits"))]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum DirectSocketWait {
+    /// Something happened on the descriptor, or the backend was already
+    /// holding readiness: attempt the operation again.
+    Ready,
+    /// The socket's own timeout elapsed first.
+    TimedOut,
+    /// A signal is queued, or a producer the descriptor cannot see ended
+    /// the wait.
+    Interrupted,
+    /// This thread cannot wait on the descriptor; the caller's existing
+    /// wait runs instead.
+    Unavailable,
+}
+
+/// The descriptor a wait would name, the readiness it would ask for, and
+/// whether the backend is already holding some of it.
+///
+/// `None` is a socket with no host descriptor at all: nothing here can
+/// wait for it. Readiness the backend holds - an accepted connection, a
+/// datagram already read, a recorded shutdown - is not a level `ppoll`
+/// would see, so it is reported at once rather than slept through, and
+/// hangup and error count whatever was asked for, because the operation
+/// itself is what turns them into the guest's answer.
+#[cfg(all(unix, feature = "direct-waits"))]
+fn direct_socket_descriptor(
+    socket: &InodeSocket,
+    direction: DirectSocketDirection,
+) -> Option<(std::os::fd::RawFd, u16)> {
+    Some((socket.host_fd()?, direction.wanted()))
+}
+
+/// Waits for one socket on the thread that needs it.
+///
+/// Nothing is claimed and nothing is kept. A blocking socket operation
+/// names its socket at the call, waits for it here, and has answered the
+/// guest by the time it returns, so the rule is local to one operation: a
+/// socket waited on here is being waited on by this thread until the call
+/// returns, and a wait that cannot be done reaches the caller's existing
+/// future, which registers the socket with the shared selector exactly as
+/// it always has. That is why there is no demotion: nothing was taken
+/// away from the selector to give back.
+///
+/// The socket must be held alive by the caller for the whole wait: another
+/// guest thread closing the fd must not leave this one blocked on a number
+/// the kernel has since given to something else.
+#[cfg(all(unix, feature = "direct-waits"))]
+pub(crate) fn direct_socket_wait(
+    thread: &WasiThread,
+    exiting: &dyn Fn() -> bool,
+    socket: &InodeSocket,
+    direction: DirectSocketDirection,
+    deadline: Option<Instant>,
+) -> Option<DirectSocketWait> {
+    let (host_fd, wanted) = direct_socket_descriptor(socket, direction)?;
+
+    // Captured before the checks below and before the wait, so that
+    // anything arriving in between changes it and the wait returns at once
+    // instead of sleeping through it. A termination moves it without
+    // queueing a signal, which is why a finished thread is asked about too.
+    let interrupt = thread.wait_interrupt();
+    if thread.signals_pending() || exiting() {
+        return Some(DirectSocketWait::Interrupted);
+    }
+
+    let mut fds = [wasmer_vm::HostPollFd {
+        fd: host_fd,
+        events: wanted,
+        revents: 0,
+        nbytes: 0,
+    }];
+    let epoch = wasmer_vm::pollfd_epoch();
+    // SAFETY: the descriptor belongs to a socket the caller holds for the
+    // whole wait, and the interrupt word belongs to this thread, which is
+    // the one suspending.
+    let result =
+        unsafe { wasmer_vm::try_suspend_on_pollfd(&mut fds, interrupt.0, interrupt.1, deadline) };
+    Some(match result {
+        // Which levels fired is not read: the operation itself is what
+        // reports what the socket can do now, and it runs next.
+        Some(wasmer_vm::HostPollFdResult::Ready) => DirectSocketWait::Ready,
+        Some(wasmer_vm::HostPollFdResult::TimedOut) => DirectSocketWait::TimedOut,
+        Some(wasmer_vm::HostPollFdResult::Interrupted) => DirectSocketWait::Interrupted,
+        Some(wasmer_vm::HostPollFdResult::Unavailable) | None => {
+            // A fork rebuilt the networking under the wait, so the
+            // descriptor is resolved again rather than given up on.
+            if wasmer_vm::pollfd_epoch() != epoch {
+                DirectSocketWait::Ready
+            } else {
+                DirectSocketWait::Unavailable
+            }
+        }
+    })
+}
+
+/// What an operation that would block can do about the descriptor it
+/// would have blocked on.
+#[cfg(all(unix, feature = "direct-waits"))]
+pub(crate) enum DirectSocketTarget {
+    /// A socket this thread can wait for, and when the wait runs out.
+    Wait(InodeSocket, Option<Instant>),
+    /// The descriptor is marked non-blocking, so `Again` is the whole
+    /// answer: the existing path would take the same descriptor, make
+    /// the same attempt and report the same thing.
+    Again,
+    /// Nothing here can wait for this descriptor, and the caller's
+    /// existing path must.
+    Fallthrough,
+}
+
+/// The socket a blocking operation on `sock` would wait for, and when its
+/// wait would run out.
+#[cfg(all(unix, feature = "direct-waits"))]
+pub(crate) fn direct_socket_target(
+    env: &WasiEnv,
+    sock: WasiFd,
+    rights: Rights,
+    time: crate::net::socket::TimeType,
+) -> DirectSocketTarget {
+    let Ok(fd_entry) = __sock_check_rights(env, sock, rights) else {
+        return DirectSocketTarget::Fallthrough;
+    };
+    if fd_entry.inner.flags.contains(Fdflags::NONBLOCK) {
+        return DirectSocketTarget::Again;
+    }
+    let socket = {
+        let inode_guard = fd_entry.inode.read();
+        match inode_guard.deref() {
+            Kind::Socket { socket } => socket.clone(),
+            _ => return DirectSocketTarget::Fallthrough,
+        }
+    };
+    // Only a socket whose backend can name a host descriptor, and nothing
+    // is installed on it or read from it to find out.
+    if socket.host_fd().is_none() {
+        return DirectSocketTarget::Fallthrough;
+    }
+    let deadline = match socket.opt_time(time) {
+        Ok(Some(timeout)) => match Instant::now().checked_add(timeout) {
+            Some(deadline) => Some(deadline),
+            None => return DirectSocketTarget::Fallthrough,
+        },
+        _ => None,
+    };
+    DirectSocketTarget::Wait(socket, deadline)
+}
+
+/// The turns of one socket operation that waits on the thread that needs
+/// it: attempt, wait, attempt again.
+///
+/// The attempt must not block - it is the operation the guest asked for,
+/// run as if the descriptor were non-blocking - and `Again` is what says
+/// the wait is needed. A second `Again` after a wait is not a surprise:
+/// another thread on the same socket may have taken what arrived, and the
+/// answer is to wait again rather than to report a level that is gone.
+///
+/// `None` hands the whole call to the caller's existing path, which waits
+/// exactly as it did before. Nothing has to be undone first, because
+/// nothing was claimed. Every interrupt leaves this loop, so anything that
+/// has to reach a thread through its own syscall path - a signal, or the
+/// barrier a dynamic link operation holds the other threads at - gets the
+/// thread out of here and into that path, which is where it was answered
+/// before any of this existed.
+#[cfg(all(unix, feature = "direct-waits"))]
+fn direct_socket_turns<T>(
+    attempt: &mut dyn FnMut() -> Result<Result<T, Errno>, WasiError>,
+    wait: &mut dyn FnMut() -> Option<DirectSocketWait>,
+) -> Result<(Option<Result<T, Errno>>, &'static str), WasiError> {
+    loop {
+        match wait() {
+            Some(DirectSocketWait::Ready) => {}
+            Some(DirectSocketWait::TimedOut) => {
+                return Ok((Some(Err(Errno::Timedout)), "timeout"));
+            }
+            // A signal is the existing path's to deliver, and it does so
+            // for this call exactly as it would have without any of this.
+            Some(DirectSocketWait::Interrupted) => return Ok((None, "interrupted")),
+            Some(DirectSocketWait::Unavailable) | None => return Ok((None, "fallthrough")),
+        }
+        match attempt()? {
+            Err(Errno::Again) => {}
+            answer => return Ok((Some(answer), "waited")),
+        }
+    }
+}
+
+/// One event per socket operation that could have waited, saying which
+/// path answered it and with what, in the shape `poll_oneoff` and
+/// `epoll_wait` report themselves.
+///
+/// `outcome` is `done` for an operation that never had to wait, `again`
+/// for one on a descriptor the guest marked non-blocking, `waited` for
+/// one this thread waited for itself, `timeout` for the socket's own
+/// timeout, and `interrupted` or `fallthrough` for the existing path
+/// taking the call over.
+fn trace_socket_call(op: &'static str, direct: bool, outcome: &'static str) {
+    tracing::trace!(op, direct, outcome, "socket operation answered");
+}
+
+/// Runs a blocking socket operation on the thread that needs it, rather
+/// than handing its wait to the shared selector.
+///
+/// `attempt` is the operation as the guest asked for it, run as if the
+/// descriptor were non-blocking: it is tried first, because an operation
+/// that can be answered at once - which is most of them, the guest having
+/// polled the socket already - must not pay for resolving a wait it never
+/// makes. Only an `Again` looks the socket up, and only then is anything
+/// waited on.
+///
+/// `None` means the caller's existing path runs, unchanged and whole: the
+/// attempt above did nothing that the existing path will not do again.
+pub(crate) fn __sock_direct<T>(
+    env: &WasiEnv,
+    sock: WasiFd,
+    rights: Rights,
+    direction: DirectSocketDirection,
+    time: crate::net::socket::TimeType,
+    op: &'static str,
+    mut attempt: impl FnMut() -> Result<Result<T, Errno>, WasiError>,
+) -> Result<Option<Result<T, Errno>>, WasiError> {
+    #[cfg(not(all(unix, feature = "direct-waits")))]
+    {
+        Ok(None)
+    }
+    #[cfg(all(unix, feature = "direct-waits"))]
+    {
+        __sock_direct_unix(env, sock, rights, direction, time, op, attempt)
+    }
+}
+
+/// The body of [`__sock_direct`] where the descriptor wait exists.
+#[cfg(all(unix, feature = "direct-waits"))]
+fn __sock_direct_unix<T>(
+    env: &WasiEnv,
+    sock: WasiFd,
+    rights: Rights,
+    direction: DirectSocketDirection,
+    time: crate::net::socket::TimeType,
+    op: &'static str,
+    mut attempt: impl FnMut() -> Result<Result<T, Errno>, WasiError>,
+) -> Result<Option<Result<T, Errno>>, WasiError> {
+    match attempt()? {
+        Err(Errno::Again) => {}
+        answer => {
+            trace_socket_call(op, true, "done");
+            return Ok(Some(answer));
+        }
+    }
+    let (socket, deadline) = match direct_socket_target(env, sock, rights, time) {
+        DirectSocketTarget::Wait(socket, deadline) => (socket, deadline),
+        DirectSocketTarget::Again => {
+            trace_socket_call(op, true, "again");
+            return Ok(Some(Err(Errno::Again)));
+        }
+        DirectSocketTarget::Fallthrough => {
+            trace_socket_call(op, false, "fallthrough");
+            return Ok(None);
+        }
+    };
+    let thread = env.thread.clone();
+    let exiting = || env.should_exit().is_some();
+    let (answer, outcome) = direct_socket_turns(&mut attempt, &mut || {
+        direct_socket_wait(&thread, &exiting, &socket, direction, deadline)
+    })?;
+    trace_socket_call(op, answer.is_some(), outcome);
+    Ok(answer)
+}
+
+/// Whether a blocking socket operation can be waited for on the thread
+/// that makes it: this runtime has the descriptor wait, the call is not
+/// journalled - a journalled call records its wait through the existing
+/// path - and the guest did not ask for an answer that never waits, which
+/// needs none of this.
+pub(crate) fn direct_socket_eligible(env: &WasiEnv, nonblocking: bool) -> bool {
+    #[cfg(all(unix, feature = "direct-waits"))]
+    {
+        !nonblocking && wasmer_vm::can_suspend_on_pollfd() && !env.enable_journal
+    }
+    #[cfg(not(all(unix, feature = "direct-waits")))]
+    {
+        false
+    }
+}
+
+/// The direct branch of a socket operation whose attempt answers with one
+/// `Result`, guard included.
+///
+/// `once` is the operation, and its argument says whether this call of it
+/// must not wait. `None` is the existing path, whole and unchanged.
+pub(crate) fn __sock_direct_attempt<T>(
+    env: &WasiEnv,
+    sock: WasiFd,
+    rights: Rights,
+    direction: DirectSocketDirection,
+    time: crate::net::socket::TimeType,
+    op: &'static str,
+    nonblocking: bool,
+    once: &mut dyn FnMut(bool) -> Result<T, Errno>,
+) -> Result<Option<Result<T, Errno>>, WasiError> {
+    if !direct_socket_eligible(env, nonblocking) {
+        return Ok(None);
+    }
+    __sock_direct(env, sock, rights, direction, time, op, || Ok(once(true)))
+}
