+#[cfg(all(test, unix, feature = "direct-waits"))]
+mod direct_socket_tests {
+    use super::*;
+    use crate::net::socket::tests::{
+        close_tracking_socket, host_descriptor_socket_for, watched_host_descriptor_socket,
+    };
+    use std::io::{Read, Write};
+    use std::net::{TcpListener, TcpStream};
+    use std::os::fd::{AsRawFd, RawFd};
+    use std::os::unix::net::UnixStream;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    /// The wait a thread makes, as a test can make it: `poll(2)` on the
+    /// one descriptor with the same deadline.
+    ///
+    /// The real wait also watches the thread's interrupt word and the
+    /// freeze gate, and it can only run inside a coroutine, which no unit
+    /// test has; its interrupted and unavailable answers are handed to
+    /// the loop directly in the tests that want them, and the host's own
+    /// suite is what pins the wait itself.
+    fn poll_once(fd: RawFd, wanted: u16, deadline: Option<Instant>) -> DirectSocketWait {
+        let mut events = 0i16;
+        if wanted & wasmer_vm::HOST_POLL_READ != 0 {
+            events |= libc::POLLIN;
+        }
+        if wanted & wasmer_vm::HOST_POLL_WRITE != 0 {
+            events |= libc::POLLOUT;
+        }
+        #[cfg(any(target_os = "linux", target_os = "android"))]
+        if wanted & wasmer_vm::HOST_POLL_RDHUP != 0 {
+            events |= libc::POLLRDHUP;
+        }
+        let timeout = match deadline {
+            Some(deadline) => deadline
+                .saturating_duration_since(Instant::now())
+                .as_millis() as libc::c_int,
+            None => -1,
+        };
+        let mut entry = libc::pollfd {
+            fd,
+            events,
+            revents: 0,
+        };
+        match unsafe { libc::poll(&mut entry, 1, timeout) } {
+            0 => DirectSocketWait::TimedOut,
+            answer if answer > 0 => DirectSocketWait::Ready,
+            _ => DirectSocketWait::Unavailable,
+        }
+    }
+
+    /// Reads what the kernel has, in the shape an attempt answers in.
+    fn read_attempt(stream: &UnixStream, buf: &mut [u8]) -> Result<usize, Errno> {
+        match (&*stream).read(buf) {
+            Ok(read) => Ok(read),
+            Err(err) if err.kind() == std::io::ErrorKind::WouldBlock => Err(Errno::Again),
+            Err(_) => Err(Errno::Io),
+        }
+    }
+
+    /// Writes what the kernel will take, in the shape an attempt answers
+    /// in.
+    fn write_attempt(stream: &UnixStream, buf: &[u8]) -> Result<usize, Errno> {
+        match (&*stream).write(buf) {
+            Ok(written) => Ok(written),
+            Err(err) if err.kind() == std::io::ErrorKind::WouldBlock => Err(Errno::Again),
+            Err(_) => Err(Errno::Io),
+        }
+    }
+
+    /// Which socket a wait can be made for, what it asks the kernel, and
+    /// what it does not do to the socket to find out.
+    ///
+    /// Deciding this installs no handler and never reads the socket: the
+    /// registration with the shared selector and the read into the
+    /// runtime's buffer are the two costs the path exists to remove, and
+    /// the mock counts both.
+    #[test]
+    fn only_a_socket_with_a_host_descriptor_is_waited_for() {
+        let (socket, handler, reads) = watched_host_descriptor_socket();
+        let (fd, wanted) = direct_socket_descriptor(&socket, DirectSocketDirection::Read).unwrap();
+        assert_eq!(fd, 3);
+        assert_eq!(
+            wanted,
+            wasmer_vm::HOST_POLL_READ | wasmer_vm::HOST_POLL_RDHUP
+        );
+        let (_, wanted) = direct_socket_descriptor(&socket, DirectSocketDirection::Write).unwrap();
+        assert_eq!(wanted, wasmer_vm::HOST_POLL_WRITE);
+        assert!(handler.lock().unwrap().is_none());
+        assert_eq!(reads.load(Ordering::Relaxed), 0);
+
+        // A socket the host cannot name a descriptor for is not one this
+        // thread can wait for at all.
+        let opaque = close_tracking_socket(Arc::new(AtomicUsize::new(0)));
+        assert!(direct_socket_descriptor(&opaque, DirectSocketDirection::Read).is_none());
+    }
+
+    /// A receive on an empty socket: the thread waits for the socket's own
+    /// descriptor and the receive that follows the wait is the one that
+    /// reads what arrived.
+    #[test]
+    fn a_receive_that_would_block_waits_for_the_descriptor() {
+        let (ours, mut peer) = UnixStream::pair().unwrap();
+        ours.set_nonblocking(true).unwrap();
+        let socket = host_descriptor_socket_for(ours.as_raw_fd());
+        let (fd, wanted) = direct_socket_descriptor(&socket, DirectSocketDirection::Read).unwrap();
+        assert_eq!(fd, ours.as_raw_fd());
+
+        let writer = std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(50));
+            peer.write_all(b"hello").unwrap();
+        });
+
+        let mut buf = [0u8; 5];
+        let mut attempts = 0;
+        let (answer, outcome) = direct_socket_turns(
+            &mut || {
+                attempts += 1;
+                Ok(read_attempt(&ours, &mut buf))
+            },
+            &mut || Some(poll_once(fd, wanted, None)),
+        )
+        .unwrap();
+        assert_eq!(answer, Some(Ok(5)));
+        assert_eq!(outcome, "waited");
+        assert_eq!(attempts, 1);
+        assert_eq!(&buf, b"hello");
+        writer.join().unwrap();
+    }
+
+    /// A send on a socket with no room: the thread waits for the
+    /// descriptor and the send that follows the wait is the one that
+    /// writes.
+    #[test]
+    fn a_send_that_would_block_waits_for_room() {
+        let (ours, mut peer) = UnixStream::pair().unwrap();
+        ours.set_nonblocking(true).unwrap();
+        let block = [0u8; 4096];
+        let mut filled = 0usize;
+        loop {
+            match write_attempt(&ours, &block) {
+                Ok(written) => filled += written,
+                Err(Errno::Again) => break,
+                Err(err) => panic!("filling the socket failed: {err:?}"),
+            }
+            assert!(filled < 64 * 1024 * 1024, "the socket never filled up");
+        }
+
+        let socket = host_descriptor_socket_for(ours.as_raw_fd());
+        let (fd, wanted) = direct_socket_descriptor(&socket, DirectSocketDirection::Write).unwrap();
+
+        let reader = std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(50));
+            let mut drain = vec![0u8; filled];
+            peer.read_exact(&mut drain).unwrap();
+            drain.len()
+        });
+
+        let (answer, outcome) =
+            direct_socket_turns(&mut || Ok(write_attempt(&ours, b"x")), &mut || {
+                Some(poll_once(fd, wanted, None))
+            })
+            .unwrap();
+        assert_eq!(answer, Some(Ok(1)));
+        assert_eq!(outcome, "waited");
+        assert_eq!(reader.join().unwrap(), filled);
+    }
+
+    /// An accept with nothing queued: the thread waits for the listener's
+    /// own descriptor and accepts the connection that arrives.
+    #[test]
+    fn an_accept_that_would_block_waits_for_the_connection() {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let addr = listener.local_addr().unwrap();
+        // The mock only names the descriptor; what the operation does
+        // with it is this test's own accept.
+        let socket = host_descriptor_socket_for(listener.as_raw_fd());
+        let (fd, wanted) = direct_socket_descriptor(&socket, DirectSocketDirection::Read).unwrap();
+
+        let client = std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(50));
+            TcpStream::connect(addr).unwrap()
+        });
+
+        let (answer, outcome) = direct_socket_turns(
+            &mut || {
+                Ok(match listener.accept() {
+                    Ok(_) => Ok(1usize),
+                    Err(err) if err.kind() == std::io::ErrorKind::WouldBlock => Err(Errno::Again),
+                    Err(_) => Err(Errno::Io),
+                })
+            },
+            &mut || Some(poll_once(fd, wanted, None)),
+        )
+        .unwrap();
+        assert_eq!(answer, Some(Ok(1)));
+        assert_eq!(outcome, "waited");
+        let _client = client.join().unwrap();
+    }
+
+    /// A connection in progress: the descriptor becomes writable when the
+    /// handshake ends, and the error the kernel latched is what says how
+    /// it ended.
+    #[test]
+    fn a_connection_in_progress_waits_for_writability() {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let fd = unsafe {
+            libc::socket(
+                libc::AF_INET,
+                libc::SOCK_STREAM | libc::SOCK_NONBLOCK | libc::SOCK_CLOEXEC,
+                0,
+            )
+        };
+        assert!(fd >= 0, "could not open a socket");
+        let mut addr: libc::sockaddr_in = unsafe { std::mem::zeroed() };
+        addr.sin_family = libc::AF_INET as libc::sa_family_t;
+        addr.sin_port = port.to_be();
+        addr.sin_addr.s_addr = u32::from_be_bytes([127, 0, 0, 1]).to_be();
+        let started = unsafe {
+            libc::connect(
+                fd,
+                std::ptr::addr_of!(addr).cast(),
+                std::mem::size_of::<libc::sockaddr_in>() as libc::socklen_t,
+            )
+        };
+        if started != 0 {
+            assert_eq!(
+                std::io::Error::last_os_error().raw_os_error(),
+                Some(libc::EINPROGRESS),
+                "the connection neither finished nor started"
+            );
+        }
+
+        // The socket status is `Opening` until the handshake ends, which
+        // is what the call site loops on.
+        let mut answers = 0;
+        let (answer, outcome) = direct_socket_turns(
+            &mut || {
+                answers += 1;
+                Ok(match latched_error(fd) {
+                    0 if connected(fd) => Ok(()),
+                    0 => Err(Errno::Again),
+                    _ => Err(Errno::Connrefused),
+                })
+            },
+            &mut || Some(poll_once(fd, wasmer_vm::HOST_POLL_WRITE, None)),
+        )
+        .unwrap();
+        assert_eq!(answer, Some(Ok(())));
+        assert_eq!(outcome, "waited");
+        assert_eq!(answers, 1);
+        unsafe { libc::close(fd) };
+        drop(listener);
+    }
+
+    /// The error the kernel latched on a connecting socket, which is what
+    /// `SO_ERROR` answers.
+    fn latched_error(fd: RawFd) -> libc::c_int {
+        let mut error: libc::c_int = 0;
+        let mut len = std::mem::size_of::<libc::c_int>() as libc::socklen_t;
+        let answered = unsafe {
+            libc::getsockopt(
+                fd,
+                libc::SOL_SOCKET,
+                libc::SO_ERROR,
+                std::ptr::addr_of_mut!(error).cast(),
+                &mut len,
+            )
+        };
+        assert_eq!(answered, 0, "SO_ERROR could not be read");
+        error
+    }
+
+    /// Whether the handshake has finished, as the backend's own status
+    /// decides it: the socket has a peer.
+    fn connected(fd: RawFd) -> bool {
+        let mut peer: libc::sockaddr_in = unsafe { std::mem::zeroed() };
+        let mut len = std::mem::size_of::<libc::sockaddr_in>() as libc::socklen_t;
+        0 == unsafe { libc::getpeername(fd, std::ptr::addr_of_mut!(peer).cast(), &mut len) }
+    }
+
+    /// A wait that reaches the socket's own timeout is the operation's
+    /// timeout, and the operation is not attempted again.
+    #[test]
+    fn a_wait_that_runs_out_is_the_operations_timeout() {
+        let (ours, _peer) = UnixStream::pair().unwrap();
+        ours.set_nonblocking(true).unwrap();
+        let socket = host_descriptor_socket_for(ours.as_raw_fd());
+        let (fd, wanted) = direct_socket_descriptor(&socket, DirectSocketDirection::Read).unwrap();
+        let started = Instant::now();
+        let deadline = started + Duration::from_millis(50);
+
+        let mut attempts = 0;
+        let mut buf = [0u8; 1];
+        let (answer, outcome) = direct_socket_turns(
+            &mut || {
+                attempts += 1;
+                Ok(read_attempt(&ours, &mut buf))
+            },
+            &mut || Some(poll_once(fd, wanted, Some(deadline))),
+        )
+        .unwrap();
+        assert_eq!(answer, Some(Err(Errno::Timedout)));
+        assert_eq!(outcome, "timeout");
+        assert_eq!(attempts, 0);
+        // `poll(2)` counts whole milliseconds, so it may answer just
+        // inside the deadline; what is pinned is that it slept for it.
+        assert!(started.elapsed() >= Duration::from_millis(45));
+    }
+
+    /// Every way a wait can end without readiness leaves the call to the
+    /// existing path, which waits as it always has, and nothing is
+    /// attempted again on the way out.
+    #[test]
+    fn a_wait_that_cannot_answer_leaves_the_call_to_the_existing_path() {
+        for (wait, outcome) in [
+            (Some(DirectSocketWait::Interrupted), "interrupted"),
+            (Some(DirectSocketWait::Unavailable), "fallthrough"),
+            (None, "fallthrough"),
+        ] {
+            let mut attempts = 0;
+            let (answer, answered) = direct_socket_turns::<usize>(
+                &mut || {
+                    attempts += 1;
+                    Ok(Err(Errno::Again))
+                },
+                &mut || wait,
+            )
+            .unwrap();
+            assert_eq!(answer, None);
+            assert_eq!(answered, outcome);
+            assert_eq!(attempts, 0);
+        }
+    }
+
+    /// Readiness another thread took before this one looked is not an
+    /// answer: the operation would block again, and the loop waits again
+    /// rather than reporting a level that is gone.
+    #[test]
+    fn readiness_another_thread_took_is_waited_for_again() {
+        let waits = std::cell::Cell::new(0);
+        let mut attempts = 0;
+        let (answer, outcome) = direct_socket_turns(
+            &mut || {
+                attempts += 1;
+                Ok(if attempts < 3 {
+                    Err(Errno::Again)
+                } else {
+                    Ok(7usize)
+                })
+            },
+            &mut || {
+                waits.set(waits.get() + 1);
+                Some(DirectSocketWait::Ready)
+            },
+        )
+        .unwrap();
+        assert_eq!(answer, Some(Ok(7)));
+        assert_eq!(outcome, "waited");
+        assert_eq!(attempts, 3);
+        assert_eq!(waits.get(), 3);
+    }
+}
