+#[cfg(all(test, unix, feature = "direct-waits"))]
+mod direct_tests {
+    use super::*;
+    use crate::net::socket::tests::{close_tracking_socket, watched_host_descriptor_socket};
+    use std::sync::atomic::AtomicUsize;
+    use wasmer_wasix_types::wasi::{SubscriptionFsReadwrite, SubscriptionUnion};
+
+    fn fd_sub(type_: Eventtype, fd: WasiFd, userdata: Userdata) -> Subscription {
+        Subscription {
+            userdata,
+            type_,
+            data: SubscriptionUnion {
+                fd_readwrite: SubscriptionFsReadwrite {
+                    file_descriptor: fd,
+                },
+            },
+        }
+    }
+
+    fn clock_sub() -> Subscription {
+        Subscription {
+            userdata: 7,
+            type_: Eventtype::Clock,
+            data: SubscriptionUnion {
+                clock: SubscriptionClock {
+                    clock_id: Clockid::Monotonic,
+                    timeout: 1,
+                    precision: 0,
+                    flags: Subclockflags::empty(),
+                },
+            },
+        }
+    }
+
+    fn readwrite(event: &Event) -> EventFdReadwrite {
+        unsafe { event.u.fd_readwrite }
+    }
+
+    /// Only a socket whose backend names a host descriptor is polled by the
+    /// waiting thread, and deciding that installs nothing on the socket and
+    /// reads nothing from it: the two things the guard path does, and the
+    /// two costs this path exists to remove.
+    #[test]
+    fn only_a_socket_with_a_host_descriptor_is_polled_by_the_thread() {
+        let (socket, handler, reads) = watched_host_descriptor_socket();
+        let read = direct_sub_for(&socket, &fd_sub(Eventtype::FdRead, 4, 11)).unwrap();
+        assert_eq!(
+            read.wanted,
+            wasmer_vm::HOST_POLL_READ | wasmer_vm::HOST_POLL_RDHUP
+        );
+        assert_eq!(read.userdata, 11);
+        let write = direct_sub_for(&socket, &fd_sub(Eventtype::FdWrite, 4, 12)).unwrap();
+        assert_eq!(write.wanted, wasmer_vm::HOST_POLL_WRITE);
+
+        assert!(handler.lock().unwrap().is_none());
+        assert_eq!(reads.load(Ordering::Relaxed), 0);
+
+        // A clock is the deadline, never a descriptor.
+        assert!(direct_sub_for(&socket, &clock_sub()).is_none());
+        assert!(direct_sub_kind(Eventtype::Clock).is_none());
+
+        // A socket the host cannot name, and so anything that is not a
+        // socket at all, keeps its guard and the selector registration that
+        // guard installs.
+        let opaque = close_tracking_socket(Arc::new(AtomicUsize::new(0)));
+        assert!(direct_sub_for(&opaque, &fd_sub(Eventtype::FdRead, 5, 13)).is_none());
+    }
+
+    /// What the kernel reported becomes the event the guard path would have
+    /// built for the same state: a readable descriptor with bytes, an ended
+    /// stream with the hangup flag and no bytes, and an error with a code
+    /// that `poll()` turns into `POLLERR`. A peer that shut its writing half
+    /// down is told apart from a peer that sent a last request and then shut
+    /// it down by the count the wait measured on that turn.
+    #[test]
+    fn readiness_becomes_the_event_the_guard_path_would_report() {
+        let (socket, _handler, _reads) = watched_host_descriptor_socket();
+        let read = direct_sub_for(&socket, &fd_sub(Eventtype::FdRead, 4, 11)).unwrap();
+        let write = direct_sub_for(&socket, &fd_sub(Eventtype::FdWrite, 4, 12)).unwrap();
+
+        let event = direct_sub_event(&read, wasmer_vm::HOST_POLL_READ, 0).unwrap();
+        assert_eq!(event.type_, Eventtype::FdRead);
+        assert_eq!(event.userdata, 11);
+        assert_eq!(event.error, Errno::Success);
+        assert_eq!(readwrite(&event).nbytes, 1);
+        assert_eq!(readwrite(&event).flags, Eventrwflags::empty());
+
+        // The peer shut its writing half down with nothing left unread, and
+        // a peer that has gone away: no bytes and a hangup, which is what an
+        // end-of-file read reports through a guard.
+        for bits in [
+            wasmer_vm::HOST_POLL_READ | wasmer_vm::HOST_POLL_RDHUP,
+            wasmer_vm::HOST_POLL_HUP,
+        ] {
+            let event = direct_sub_event(&read, bits, 0).unwrap();
+            assert_eq!(event.error, Errno::Success);
+            assert_eq!(readwrite(&event).nbytes, 0);
+            assert_eq!(readwrite(&event).flags, Eventrwflags::FD_READWRITE_HANGUP);
+        }
+
+        // The same shutdown with a request still in the socket is a
+        // readable descriptor: the wait says bytes are still unread, and
+        // one is the count every readable descriptor reports.
+        let event = direct_sub_event(
+            &read,
+            wasmer_vm::HOST_POLL_READ | wasmer_vm::HOST_POLL_RDHUP,
+            1,
+        )
+        .unwrap();
+        assert_eq!(event.error, Errno::Success);
+        assert_eq!(readwrite(&event).nbytes, 1);
+        assert_eq!(readwrite(&event).flags, Eventrwflags::empty());
+
+        // A peer that has gone away with a last request still unread is a
+        // readable descriptor until it is drained, as the guard path
+        // reported it; a write subscription is hung up either way.
+        let event = direct_sub_event(
+            &read,
+            wasmer_vm::HOST_POLL_READ | wasmer_vm::HOST_POLL_RDHUP | wasmer_vm::HOST_POLL_HUP,
+            1,
+        )
+        .unwrap();
+        assert_eq!(readwrite(&event).nbytes, 1);
+        assert_eq!(readwrite(&event).flags, Eventrwflags::empty());
+        let event = direct_sub_event(&write, wasmer_vm::HOST_POLL_HUP, 1).unwrap();
+        assert_eq!(readwrite(&event).nbytes, 0);
+        assert_eq!(readwrite(&event).flags, Eventrwflags::FD_READWRITE_HANGUP);
+
+        let event = direct_sub_event(&read, wasmer_vm::HOST_POLL_ERR, 0).unwrap();
+        assert_eq!(event.error, Errno::Io);
+        assert_eq!(readwrite(&event).nbytes, 0);
+        assert_eq!(readwrite(&event).flags, Eventrwflags::FD_READWRITE_HANGUP);
+
+        let event = direct_sub_event(&write, wasmer_vm::HOST_POLL_WRITE, 0).unwrap();
+        assert_eq!(event.type_, Eventtype::FdWrite);
+        assert_eq!(readwrite(&event).nbytes, 1);
+
+        // A level nobody subscribed to is not an event: producing one would
+        // answer a call with something the guest never asked about.
+        assert!(direct_sub_event(&read, wasmer_vm::HOST_POLL_WRITE, 0).is_none());
+        assert!(direct_sub_event(&write, wasmer_vm::HOST_POLL_READ, 0).is_none());
+        assert!(direct_sub_event(&read, 0, 0).is_none());
+    }
+
+    /// A call that has already collected events from its guards and then
+    /// finds a socket it can no longer name answers with what it has: a
+    /// subset is a legal answer, and discarding it would lose whatever the
+    /// guards reported, because a guard that consumed its readiness on the
+    /// poll would not report it again.
+    #[test]
+    fn events_already_collected_are_not_discarded_by_a_fallthrough() {
+        let (socket, _handler, _reads) = watched_host_descriptor_socket();
+        let read = direct_sub_for(&socket, &fd_sub(Eventtype::FdRead, 4, 11)).unwrap();
+        let collected = direct_sub_event(&read, wasmer_vm::HOST_POLL_READ, 0).unwrap();
+
+        assert!(matches!(
+            direct_poll_answer(Vec::new()),
+            DirectPoll::Fallthrough
+        ));
+        let DirectPoll::Events(events) = direct_poll_answer(vec![collected]) else {
+            panic!("the events the guards reported were discarded");
+        };
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].userdata, 11);
+    }
+
+    /// A zero timeout is a probe and never a sleep; no clock is no deadline;
+    /// anything else is the deadline the guest asked for.
+    #[test]
+    fn a_zero_timeout_probes_and_an_absent_clock_never_ends() {
+        let before = Instant::now();
+        assert_eq!(direct_poll_deadline(Duration::MAX), Some(None));
+
+        let probe = direct_poll_deadline(Duration::ZERO).unwrap().unwrap();
+        assert!(probe <= Instant::now());
+
+        let deadline = direct_poll_deadline(Duration::from_millis(50))
+            .unwrap()
+            .unwrap();
+        assert!(deadline >= before + Duration::from_millis(50));
+    }
+
+    /// A deadline that passes answers every clock subscription of the call,
+    /// as the existing timeout path does, and none of the descriptors.
+    #[test]
+    fn a_timeout_answers_every_clock_subscription() {
+        let clock = unsafe { clock_sub().data.clock };
+        let events = direct_clock_events(&[(clock, 21), (clock, 22)]);
+        assert_eq!(events.len(), 2);
+        assert!(events.iter().all(|e| e.type_ == Eventtype::Clock));
+        assert!(events.iter().all(|e| e.error == Errno::Success));
+        assert_eq!(
+            events.iter().map(|e| e.userdata).collect::<Vec<_>>(),
+            vec![21, 22]
+        );
+        assert!(direct_clock_events(&[]).is_empty());
+    }
+
+    #[derive(Default)]
+    struct CountingWaker(AtomicUsize);
+
+    impl std::task::Wake for CountingWaker {
+        fn wake(self: Arc<Self>) {
+            self.0.fetch_add(1, Ordering::SeqCst);
+        }
+        fn wake_by_ref(self: &Arc<Self>) {
+            self.0.fetch_add(1, Ordering::SeqCst);
+        }
+    }
+
+    /// The other half of a mixed call: a pipe keeps its guard, and polling
+    /// that guard with the waiting thread's waker is what registers it, so
+    /// a write to the pipe wakes the thread out of its descriptor wait and
+    /// the next poll of the guard is what produces the event.
+    #[test]
+    fn a_pipe_in_a_mixed_call_wakes_the_thread_and_then_reports() {
+        let (mut tx, rx) = virtual_fs::Pipe::new().split();
+        let kind = Kind::PipeRx { rx };
+        let subscription = fd_sub(Eventtype::FdRead, 6, 31);
+        let guard =
+            InodeValFilePollGuard::new(6, PollEvent::PollIn as PollEventSet, subscription, &kind)
+                .unwrap();
+        let mut join = InodeValFilePollGuardJoin::new(guard);
+
+        let counter = Arc::new(CountingWaker::default());
+        let waker = std::task::Waker::from(counter.clone());
+        let mut cx = Context::from_waker(&waker);
+        assert!(Pin::new(&mut join).poll(&mut cx).is_pending());
+        assert_eq!(counter.0.load(Ordering::SeqCst), 0);
+
+        std::io::Write::write_all(&mut tx, b"x").unwrap();
+        assert!(counter.0.load(Ordering::SeqCst) >= 1);
+
+        let Poll::Ready(events) = Pin::new(&mut join).poll(&mut cx) else {
+            panic!("the pipe's guard reported nothing after a write");
+        };
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].0.type_, Eventtype::FdRead);
+        assert_eq!(events[0].0.userdata, 31);
+    }
+}
