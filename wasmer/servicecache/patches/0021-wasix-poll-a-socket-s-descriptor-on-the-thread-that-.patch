+/// What the direct wait did with a `poll_oneoff` call.
+///
+/// Nothing is claimed and nothing is kept: `poll_oneoff` names its
+/// descriptors afresh on every call, so the rule is local to one call - a
+/// socket this call polls for itself is polled by this thread until the
+/// call returns - and `Fallthrough` needs no undoing, because the existing
+/// path builds a guard for every subscription including the sockets, which
+/// is what registers them with the selector.
+#[cfg(all(unix, feature = "direct-waits"))]
+enum DirectPoll {
+    /// The events to report to the guest.
+    Events(Vec<Event>),
+    /// The deadline passed with nothing ready: the clock events.
+    Timeout(Vec<Event>),
+    /// The call ends with this error code, which processing a signal asked
+    /// for.
+    Errno(Errno),
+    /// The existing path runs exactly as it would have.
+    Fallthrough,
+}
+
+/// One subscription the calling thread polls for itself: a read or a write
+/// on a socket the host can name a descriptor for.
+#[cfg(all(unix, feature = "direct-waits"))]
+struct DirectSub {
+    /// The socket, held for the length of the call. Another guest thread
+    /// closing the fd must not leave this one waiting on a descriptor
+    /// number the kernel has since given to something else.
+    socket: Arc<crate::net::socket::InodeSocketInner>,
+    /// The readiness to ask the kernel for.
+    wanted: u16,
+    type_: Eventtype,
+    userdata: Userdata,
+}
+
+/// Whether one subscription is a socket this thread can poll itself, and
+/// the socket if it is.
+///
+/// The rights are checked exactly as `poll_fd_guard` checks them, so a
+/// subscription that would be an error there is not taken over here: it
+/// gets its guard and the existing path answers it as it always has.
+#[cfg(all(unix, feature = "direct-waits"))]
+fn direct_sub(state: &Arc<WasiState>, fd: WasiFd, s: &Subscription) -> Option<DirectSub> {
+    let (requires_access, _) = direct_sub_kind(s.type_)?;
+    let fd_entry = state.fs.get_fd(fd).ok()?;
+    if !(fd_entry.inner.rights.contains(Rights::POLL_FD_READWRITE)
+        && fd_entry.inner.rights.contains(requires_access))
+    {
+        return None;
+    }
+    let inode_guard = fd_entry.inode.read();
+    let Kind::Socket { socket } = inode_guard.deref() else {
+        return None;
+    };
+    direct_sub_for(socket, s)
+}
+
+/// The access one subscription type needs and the readiness it asks the
+/// kernel for. Anything but a read or a write on a descriptor is not a
+/// subscription this path serves.
+///
+/// Hangup and error are reported whether or not they are asked for. The
+/// peer shutting only its writing half down is not: it has to be requested,
+/// and it is what the guard path reports as a read that reached the end of
+/// the file.
+#[cfg(all(unix, feature = "direct-waits"))]
+fn direct_sub_kind(type_: Eventtype) -> Option<(Rights, u16)> {
+    match type_ {
+        Eventtype::FdRead => Some((
+            Rights::FD_READ,
+            wasmer_vm::HOST_POLL_READ | wasmer_vm::HOST_POLL_RDHUP,
+        )),
+        Eventtype::FdWrite => Some((Rights::FD_WRITE, wasmer_vm::HOST_POLL_WRITE)),
+        _ => None,
+    }
+}
+
+/// The same decision once the descriptor has been resolved to a socket:
+/// only a socket whose backend can name a host descriptor is polled by the
+/// waiting thread. Nothing is installed on the socket and nothing is read
+/// from it here - that is the whole point of the path.
+#[cfg(all(unix, feature = "direct-waits"))]
+fn direct_sub_for(socket: &crate::net::socket::InodeSocket, s: &Subscription) -> Option<DirectSub> {
+    let (_, wanted) = direct_sub_kind(s.type_)?;
+    socket.host_fd()?;
+    Some(DirectSub {
+        socket: socket.inner.clone(),
+        wanted,
+        type_: s.type_,
+        userdata: s.userdata,
+    })
+}
+
+/// The deadline a call's clock subscriptions come to, or nothing when the
+/// call cannot be served this way.
+///
+/// A zero timeout asks what is ready now: the deadline it gets has already
+/// passed, so the descriptors are polled once with a zero timeout and the
+/// guards once, and nothing sleeps. No clock at all, or one the existing
+/// path reads as immediate, is no deadline.
+#[cfg(all(unix, feature = "direct-waits"))]
+fn direct_poll_deadline(time_to_sleep: Duration) -> Option<Option<Instant>> {
+    match time_to_sleep {
+        Duration::MAX => Some(None),
+        Duration::ZERO => Some(Some(Instant::now())),
+        timeout => Instant::now().checked_add(timeout).map(Some),
+    }
+}
+
+/// The event one direct subscription's readiness becomes, or nothing when
+/// it reported none that this subscription asked about.
+///
+/// A readable descriptor reports one byte rather than a count, except on
+/// the turn where the count decides the answer: counting on every turn
+/// would cost a syscall for an answer almost nobody reads. Of the three
+/// places wasix-libc reads a `poll_oneoff` answer,
+/// `poll()` and `pselect()` use only the event's type and its hangup flag
+/// and never the count
+/// (`libc-bottom-half/cloudlibc/src/libc/poll/poll.c` and
+/// `.../sys/select/pselect.c`); `ioctl(FIONREAD)` is the one that reads it.
+///
+/// A peer that has shut its writing half down, or gone away, reports that
+/// with whatever it sent last still unread, so on that turn the wait says
+/// whether bytes remain: with some, a read subscription is an ordinary
+/// readable descriptor, as the guard path reported it; with none it is the
+/// end of the stream, no bytes and the hangup flag, which is what the guard
+/// path reports for a read that returns end of file. A write subscription
+/// is hung up either way. An error reports the hangup flag and an error
+/// code, which `poll()` turns into `POLLERR`.
+#[cfg(all(unix, feature = "direct-waits"))]
+fn direct_sub_event(sub: &DirectSub, revents: u16, nbytes: u32) -> Option<Event> {
+    let ended = revents & (wasmer_vm::HOST_POLL_RDHUP | wasmer_vm::HOST_POLL_HUP) != 0;
+    let failed = revents & wasmer_vm::HOST_POLL_ERR != 0;
+    let ready =
+        revents & sub.wanted & (wasmer_vm::HOST_POLL_READ | wasmer_vm::HOST_POLL_WRITE) != 0;
+    if !failed && !ready && !ended {
+        return None;
+    }
+    let unread = sub.type_ == Eventtype::FdRead && nbytes > 0;
+    let (count, error) = if failed {
+        (0, Errno::Io)
+    } else if ended && !unread {
+        (0, Errno::Success)
+    } else {
+        (1, Errno::Success)
+    };
+    Some(Event {
+        userdata: sub.userdata,
+        error,
+        type_: sub.type_,
+        u: EventUnion {
+            fd_readwrite: EventFdReadwrite {
+                nbytes: count,
+                flags: if count == 0 {
+                    Eventrwflags::FD_READWRITE_HANGUP
+                } else {
+                    Eventrwflags::empty()
+                },
+            },
+        },
+    })
+}
+
+/// What a call answers when it can no longer name one of its sockets.
+///
+/// The existing path, which builds a guard for every subscription
+/// including that one - unless this turn's guards have already reported
+/// something. A subset is a legal `poll_oneoff` answer, and throwing one
+/// away would lose the readiness of any guard that consumed it on the
+/// poll; nothing here does today, and nothing should have to.
+#[cfg(all(unix, feature = "direct-waits"))]
+fn direct_poll_answer(events: Vec<Event>) -> DirectPoll {
+    if events.is_empty() {
+        DirectPoll::Fallthrough
+    } else {
+        DirectPoll::Events(events)
+    }
+}
+
+/// The clock events a deadline that passed produces, as the existing
+/// timeout path produces them.
+#[cfg(all(unix, feature = "direct-waits"))]
+fn direct_clock_events(clock_subs: &[(SubscriptionClock, u64)]) -> Vec<Event> {
+    clock_subs
+        .iter()
+        .map(|(_, userdata)| Event {
+            userdata: *userdata,
+            error: Errno::Success,
+            type_: Eventtype::Clock,
+            u: EventUnion { clock: 0 },
+        })
+        .collect()
+}
+
+/// Waits for the call on the guest thread, polling the host descriptors of
+/// its socket subscriptions itself.
+///
+/// A socket polled here is given no guard and is never asked for its read
+/// readiness, so what the guard path does to it does not happen: it is not
+/// registered with the shared selector, where it would stay for the life
+/// of the socket and cost a selector wake on every event. Every other
+/// subscription - a pipe, an event notification, a
+/// file, a socket with no host descriptor - gets its guard exactly as
+/// before and joins the same wait through this thread's waker. Clock
+/// subscriptions are the deadline.
+///
+/// The data a wait reports is still there when the guest reads it: the same
+/// thread does both and nothing between them consumes anything, so the read
+/// that follows succeeds without registering anything either.
+#[cfg(all(unix, feature = "direct-waits"))]
+fn direct_poll_oneoff(
+    ctx: &mut FunctionEnvMut<'_, WasiEnv>,
+    subs: &[(Option<WasiFd>, PollEventSet, Subscription)],
+    clock_subs: &[(SubscriptionClock, u64)],
+    time_to_sleep: Duration,
+) -> Result<DirectPoll, WasiError> {
+    let state = ctx.data().state.clone();
+
+    // Per subscription, at the call.
+    let mut direct: [Option<DirectSub>; DIRECT_POLL_CAP] = std::array::from_fn(|_| None);
+    let mut ndirect = 0;
+    let mut guarded: Vec<InodeValFilePollGuard> = Vec::new();
+    for (fd, peb, s) in subs {
+        let Some(fd) = *fd else {
+            continue;
+        };
+        match direct_sub(&state, fd, s) {
+            Some(_) if ndirect == DIRECT_POLL_CAP => {
+                // More sockets than the host's wait accepts. The call takes
+                // the existing path whole rather than splitting the set,
+                // which is correct and not fast.
+                return Ok(DirectPoll::Fallthrough);
+            }
+            Some(sub) => {
+                direct[ndirect] = Some(sub);
+                ndirect += 1;
+            }
+            None => match poll_fd_guard(&state, *peb, fd, *s) {
+                Ok(guard) => guarded.push(guard),
+                // The existing path reports this refusal the way it always
+                // has.
+                Err(_) => return Ok(DirectPoll::Fallthrough),
+            },
+        }
+    }
+    if ndirect == 0 {
+        return Ok(DirectPoll::Fallthrough);
+    }
+
+    let Some(deadline) = direct_poll_deadline(time_to_sleep) else {
+        return Ok(DirectPoll::Fallthrough);
+    };
+
+    let mut joins: Vec<InodeValFilePollGuardJoin> = guarded
+        .into_iter()
+        .map(InodeValFilePollGuardJoin::new)
+        .collect();
+    let waker = std::task::Waker::from(Arc::new(DirectPollWaker {
+        thread: ctx.data().thread.clone(),
+    }));
+    let mut fds = [wasmer_vm::HostPollFd::default(); DIRECT_POLL_CAP];
+
+    loop {
+        // A dlopen or dlclose in another thread holds the whole guest at a
+        // barrier that only this call reaches, so it is reached on every
+        // turn: the existing path runs it on every wake for the same
+        // reason.
+        WasiEnv::do_pending_link_operations(ctx, false)?;
+
+        // Captured before anything below registers the waker, so that a
+        // producer arriving between the two changes it and the wait returns
+        // at once instead of sleeping through it.
+        let wait_interrupt = ctx.data().thread.wait_interrupt();
+        let mut events = Vec::new();
+
+        // The runtime objects, polled once each. A guard's poll is both the
+        // check and the registration, so register-then-check is inherent.
+        {
+            let mut cx = Context::from_waker(&waker);
+            for join in joins.iter_mut() {
+                if let Poll::Ready(ready) = Pin::new(join).poll(&mut cx) {
+                    events.extend(ready.into_iter().map(|(event, _)| event.into_event()));
+                }
+            }
+        }
+
+        // The descriptors, resolved again on every turn: a fork can replace
+        // the socket behind one.
+        for (index, sub) in direct[..ndirect].iter().flatten().enumerate() {
+            let Some(host_fd) = sub.socket.protected.read().unwrap().host_fd() else {
+                // The socket is gone or is no longer one the host can name.
+                // The existing path builds it a guard, unless this turn's
+                // guards have already reported something.
+                return Ok(direct_poll_answer(events));
+            };
+            fds[index] = wasmer_vm::HostPollFd {
+                fd: host_fd,
+                events: sub.wanted,
+                revents: 0,
+                nbytes: 0,
+            };
+        }
+        // Events from the guards are answered on this turn, but the sockets
+        // are probed first, with a deadline that has passed: a guard that
+        // stays ready would otherwise hide a socket's readiness on every
+        // call. A signal waits for the next call rather than costing these
+        // events, which the guards will not report twice.
+        let probing = !events.is_empty();
+        let turn_deadline = if probing {
+            Some(Instant::now())
+        } else {
+            deadline
+        };
+
+        // A termination moves the interrupt generation without queueing a
+        // signal, so a finished thread is asked about here too: one that
+        // finished before the capture above would otherwise be slept
+        // through.
+        if !probing && (ctx.data().thread.signals_pending() || ctx.data().should_exit().is_some()) {
+            if let Err(errno) = WasiEnv::process_signals_and_exit(ctx)? {
+                return Ok(DirectPoll::Errno(errno));
+            }
+            if ctx.data().thread.signals_pending() {
+                // A signal the runtime cannot deliver right now stays
+                // queued, and looking at it again here would spin.
+                return Ok(DirectPoll::Fallthrough);
+            }
+            continue;
+        }
+
+        let epoch = wasmer_vm::pollfd_epoch();
+        // SAFETY: every descriptor belongs to a socket held in `direct` for
+        // the whole call, and the interrupt word belongs to this thread,
+        // which is the one suspending.
+        let result = unsafe {
+            wasmer_vm::try_suspend_on_pollfd(
+                &mut fds[..ndirect],
+                wait_interrupt.0,
+                wait_interrupt.1,
+                turn_deadline,
+            )
+        };
+        match result {
+            Some(wasmer_vm::HostPollFdResult::Ready) => {
+                for (slot, sub) in fds[..ndirect]
+                    .iter()
+                    .zip(direct[..ndirect].iter().flatten())
+                {
+                    if let Some(event) = direct_sub_event(sub, slot.revents, slot.nbytes) {
+                        events.push(event);
+                    }
+                }
+                // A pipe or a notification may have fired in the same
+                // instant: its waker is what ended the wait, but only
+                // polling its guard produces the event. A probe has already
+                // polled the guards this turn, and a guard that is still
+                // ready would report the same event twice.
+                if !probing {
+                    let mut cx = Context::from_waker(&waker);
+                    for join in joins.iter_mut() {
+                        if let Poll::Ready(ready) = Pin::new(join).poll(&mut cx) {
+                            events.extend(ready.into_iter().map(|(event, _)| event.into_event()));
+                        }
+                    }
+                }
+                if !events.is_empty() {
+                    return Ok(DirectPoll::Events(events));
+                }
+                // A level nothing subscribed to. Round again.
+            }
+            // A signal, a termination, or a producer's waker. The next turn
+            // finds whatever it left, and was told to look; a probe answers
+            // with what its guards found.
+            Some(wasmer_vm::HostPollFdResult::Interrupted) => {
+                if probing {
+                    return Ok(DirectPoll::Events(events));
+                }
+                if let Err(errno) = WasiEnv::process_signals_and_exit(ctx)? {
+                    return Ok(DirectPoll::Errno(errno));
+                }
+            }
+            Some(wasmer_vm::HostPollFdResult::TimedOut) => {
+                if probing {
+                    return Ok(DirectPoll::Events(events));
+                }
+                return Ok(DirectPoll::Timeout(direct_clock_events(clock_subs)));
+            }
+            Some(wasmer_vm::HostPollFdResult::Unavailable) | None => {
+                if probing {
+                    return Ok(DirectPoll::Events(events));
+                }
+                // A fork rebuilt the networking under the wait, so the
+                // descriptors are resolved again rather than given up on.
+                if wasmer_vm::pollfd_epoch() != epoch {
+                    continue;
+                }
+                return Ok(DirectPoll::Fallthrough);
+            }
+        }
+    }
+}
+
+/// One event per `poll_oneoff` call, saying which path answered it and with
+/// what, in the shape `epoll_wait` reports itself.
+fn trace_poll_call(direct: bool, outcome: &'static str, nfds: usize) {
+    tracing::trace!(direct, outcome, nfds, "poll oneoff answered");
+}
