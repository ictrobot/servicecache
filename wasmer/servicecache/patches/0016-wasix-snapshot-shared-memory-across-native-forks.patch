+fn remember_mapped_object(object: &Arc<SharedMemoryObject>) {
+    let objects = MAPPED_OBJECTS.get_or_init(Default::default);
+    let mut objects = objects.lock().unwrap();
+    objects.retain(|found| found.strong_count() != 0);
+    let object = Arc::downgrade(object);
+    if !objects.iter().any(|found| found.ptr_eq(&object)) {
+        objects.push(object);
