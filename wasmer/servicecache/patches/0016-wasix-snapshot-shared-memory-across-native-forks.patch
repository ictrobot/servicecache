+
+struct SnapshotObject {
+    object: Arc<SharedMemoryObject>,
+    mappings: Vec<RegisteredMapping>,
+}
+
+pub(crate) fn freeze() -> io::Result<SharedMemorySnapshot> {
+    #[cfg(target_os = "linux")]
+    {
+        let objects = MAPPED_OBJECTS.get_or_init(Default::default);
+        let objects = {
+            let mut objects = objects.lock().unwrap();
+            objects.retain(|object| object.strong_count() != 0);
+            objects.iter().filter_map(Weak::upgrade).collect::<Vec<_>>()
+        };
+        let mut snapshot = SharedMemorySnapshot {
+            objects: Vec::new(),
+        };
+        for object in objects {
+            let mappings = object.snapshot_mappings()?;
+            if mappings.is_empty() {
+                continue;
+            }
+            object.replace_backing(&mappings, false)?;
+            snapshot.objects.push(SnapshotObject { object, mappings });
+        }
+        Ok(snapshot)
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "shared-memory snapshots are only supported on Linux",
+    ))
+}
+
+impl SharedMemorySnapshot {
+    pub(crate) fn reshare_after_fork(&self) -> io::Result<usize> {
+        #[cfg(target_os = "linux")]
+        {
+            for snapshot in &self.objects {
+                snapshot.object.replace_backing(&snapshot.mappings, true)?;
+            }
+            Ok(self.objects.len())
+        }
+
+        #[cfg(not(target_os = "linux"))]
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "shared-memory snapshots are only supported on Linux",
+        ))
+    }
+
+    pub(crate) fn len(&self) -> usize {
+        self.objects.len()
+    }
+}
