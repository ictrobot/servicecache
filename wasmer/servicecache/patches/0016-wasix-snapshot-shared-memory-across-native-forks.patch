+/// An opaque snapshot for restoring clone-local sharing after a native fork.
+pub struct SharedMemorySnapshot(fs::shared_memory::SharedMemorySnapshot);
+
+/// Detaches live shared-memory mappings into a frozen snapshot.
+///
+/// # Safety
+///
+/// Every guest thread must be suspended. This replaces live virtual-memory
+/// mappings, and no guest may access them until a forked child has called
+/// [`SharedMemorySnapshot::reshare_after_fork`].
+pub unsafe fn freeze_shared_memory() -> std::io::Result<SharedMemorySnapshot> {
+    fs::shared_memory::freeze().map(SharedMemorySnapshot)
+}
+
+impl SharedMemorySnapshot {
+    /// Replays the recorded mappings with fresh shared backing in a native fork child.
+    ///
+    /// # Safety
+    ///
+    /// This must be called in the child before any guest thread is resumed.
+    pub unsafe fn reshare_after_fork(&self) -> std::io::Result<usize> {
+        self.0.reshare_after_fork()
+    }
+
+    /// The number of distinct shared-memory objects in the snapshot.
+    #[must_use]
+    pub fn len(&self) -> usize {
+        self.0.len()
+    }
+
+    /// Whether this snapshot contains no shared-memory objects.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+}
