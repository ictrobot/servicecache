+
+/// Copies the data of `from` (`len` bytes) into `to`, which is `len` bytes
+/// of holes: only the extents that hold data are read, and an extent's
+/// all-zero 64 KiB chunks are not written, so the copy is as sparse as the
+/// source's contents allow. A shared object is mostly zero in a guest that
+/// has not touched most of it, and every clone copies it. Falls back to a
+/// plain copy where the filesystem cannot report holes.
+#[cfg(target_os = "linux")]
+fn copy_data(from: &std::fs::File, to: &std::fs::File, len: u64) -> io::Result<()> {
+    use std::os::unix::fs::FileExt;
+
+    const CHUNK: usize = 64 * 1024;
+    let mut buffer = vec![0_u8; CHUNK];
+    let mut offset = 0_u64;
+    while offset < len {
+        // The next data extent from `offset`: SEEK_DATA finds its start (or
+        // ENXIO past the last one), SEEK_HOLE its end.
+        let data = unsafe { libc::lseek(from.as_raw_fd(), offset as libc::off_t, libc::SEEK_DATA) };
+        if data < 0 {
+            let error = io::Error::last_os_error();
+            if error.raw_os_error() == Some(libc::ENXIO) {
+                break;
+            }
+            return copy_plain(from, to, offset, len, &mut buffer);
+        }
+        let data = data as u64;
+        let hole = unsafe { libc::lseek(from.as_raw_fd(), data as libc::off_t, libc::SEEK_HOLE) };
+        if hole < 0 || hole as u64 <= data {
+            // No hole reported, or a filesystem that does not see extents:
+            // the rest is data.
+            return copy_plain(from, to, data, len, &mut buffer);
+        }
+        let hole = (hole as u64).min(len);
+        let mut at = data;
+        while at < hole {
+            let amount = usize::try_from((hole - at).min(CHUNK as u64)).unwrap();
+            let read = from.read_at(&mut buffer[..amount], at)?;
+            if read == 0 {
+                return Err(io::Error::new(
+                    io::ErrorKind::UnexpectedEof,
+                    "shared-memory object ended while copying it",
+                ));
+            }
+            if buffer[..read].iter().any(|&byte| byte != 0) {
+                let mut written = 0;
+                while written < read {
+                    let n = to.write_at(&buffer[written..read], at + written as u64)?;
+                    if n == 0 {
+                        return Err(io::ErrorKind::WriteZero.into());
+                    }
+                    written += n;
+                }
+            }
+            at += read as u64;
+        }
+        offset = hole;
+    }
+    Ok(())
+}
+
+/// The plain copy of `[offset, len)` from `from` to `to`.
+#[cfg(target_os = "linux")]
+fn copy_plain(
+    from: &std::fs::File,
+    to: &std::fs::File,
+    mut offset: u64,
+    len: u64,
+    buffer: &mut [u8],
+) -> io::Result<()> {
+    use std::os::unix::fs::FileExt;
+
+    while offset < len {
+        let amount = usize::try_from((len - offset).min(buffer.len() as u64)).unwrap();
+        let read = from.read_at(&mut buffer[..amount], offset)?;
+        if read == 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::UnexpectedEof,
+                "shared-memory object ended while copying it",
+            ));
+        }
+        let mut written = 0;
+        while written < read {
+            let n = to.write_at(&buffer[written..read], offset + written as u64)?;
+            if n == 0 {
+                return Err(io::ErrorKind::WriteZero.into());
+            }
+            written += n;
+        }
+        offset += read as u64;
+    }
+    Ok(())
+}
