+/// The result of a host futex wait.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u8)]
+pub enum HostFutexResult {
+    /// The guest futex was woken or no longer held its expected value.
+    Woken = 1,
+    /// The deadline elapsed.
+    TimedOut = 2,
+    /// The guest thread's interrupt generation changed.
+    Interrupted = 3,
