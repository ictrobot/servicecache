+    /// After `halt` the poll thread is gone; `rebuild_after_fork` re-registers
+    /// the same descriptors on a new poll instance and events flow again.
+    #[test]
+    fn test_halt_and_rebuild_keeps_registrations() {
+        let (mut sender, mut receiver) = mio::unix::pipe::new().unwrap();
+        let (success_sender, success_receiver) = std::sync::mpsc::channel();
+
+        let selector = Selector::new();
+        let handler = Box::new(TestHandler { success_sender });
+        let _token = selector
+            .add(handler, &mut receiver, mio::Interest::READABLE)
+            .unwrap();
+
+        selector.halt();
+        assert!(selector.poll_thread.lock().unwrap().is_none());
+
+        sender.write_all(&[1, 2, 3]).unwrap();
+        sender.flush().unwrap();
+        thread::sleep(Duration::from_millis(10));
+        assert!(
+            success_receiver.try_recv().is_err(),
+            "Received an event while halted"
+        );
+
+        selector.rebuild_after_fork().unwrap();
+        thread::sleep(Duration::from_millis(10));
+        assert!(
+            success_receiver.try_recv().is_ok(),
+            "Did not receive the pending event after the rebuild"
+        );
+
+        sender.write_all(&[4]).unwrap();
+        sender.flush().unwrap();
+        thread::sleep(Duration::from_millis(10));
+        assert!(
+            success_receiver.try_recv().is_ok(),
+            "Did not receive a new event after the rebuild"
+        );
+
+        selector.shutdown();
+    }
