+    /// Stops the poll thread and waits for it to end. Registrations and
+    /// handlers are kept: a later `rebuild_after_fork` starts a new thread
+    /// with them. Sockets keep working for non-blocking operations; nothing
+    /// is woken until then.
+    pub fn halt(&self) {
+        self.shutdown();
+        let handle = self.poll_thread.lock().unwrap().take();
+        if let Some(handle) = handle {
