+    /// In a forked child (or after `halt`): creates a new poll instance,
+    /// registers every known descriptor with it again and starts a new poll
+    /// thread. The previous instance is closed; its thread, if any, belonged
+    /// to the parent.
+    #[cfg(unix)]
+    pub fn rebuild_after_fork(self: &Arc<Self>) -> io::Result<()> {
+        let poll = mio::Poll::new()?;
+        let instance = Self::instance_for(&poll, self.token_wakeup)?;
+        {
+            let sources = self.sources.lock().unwrap();
+            for (token, (fd, interests)) in sources.iter() {
+                poll.registry()
+                    .register(&mut mio::unix::SourceFd(fd), *token, *interests)?;
+            }
+            tracing::debug!(sources = sources.len(), "selector rebuilt after fork");
+        }
+        // Drop the old thread's handle (the thread does not exist here)
+        // before anything can join it.
+        self.poll_thread.lock().unwrap().take();
+        self.close_requested.store(false, Ordering::SeqCst);
+        *self.instance.lock().unwrap() = instance;
+        self.spawn_poll_thread(poll);
+        Ok(())
