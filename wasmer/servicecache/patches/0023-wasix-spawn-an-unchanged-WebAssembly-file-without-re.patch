+/// The length and modification time of a file, as its metadata gave them.
+type FileIdentity = (u64, u64);
+
+/// Modules compiled from plain WebAssembly files, by the path they were
+/// spawned from, each with the identity its file had before it was read.
+///
+/// Spawning a plain WebAssembly file reads all of it and hashes it to find
+/// its compiled module in the runtime's cache, however often the same file is
+/// spawned. A process that starts its own binary for each child pays that for
+/// every child. A file whose length and modification time are unchanged is
+/// taken to hold the same module, so its module is used without reading it.
+#[derive(Debug, Clone, Default)]
+struct WasmModules(Arc<RwLock<HashMap<String, (FileIdentity, Module)>>>);
+
+impl WasmModules {
+    /// The identity of the file at `path`, when it is an absolute path to a
+    /// file.
+    fn identity(path: &str, fs: &dyn FileSystem) -> Option<FileIdentity> {
+        // Only an absolute name is read from the filesystem, so only one can
+        // have a module kept for it; any other name needs no metadata.
+        if !path.starts_with('/') {
+            return None;
+        }
+        let metadata = fs.metadata(Path::new(path)).ok()?;
+        metadata
+            .is_file()
+            .then_some((metadata.len, metadata.modified))
+    }
+
+    fn get(&self, path: &str, identity: FileIdentity) -> Option<Module> {
+        let modules = self.0.read().unwrap();
+        modules
+            .get(path)
+            .filter(|(cached, _)| *cached == identity)
+            .map(|(_, module)| module.clone())
+    }
+
+    fn insert(&self, path: &str, identity: FileIdentity, module: &Module) {
+        let mut modules = self.0.write().unwrap();
+        modules.insert(path.to_string(), (identity, module.clone()));
+    }
+
+    fn remove(&self, path: &str) {
+        self.0.write().unwrap().remove(path);
+    }
+}
