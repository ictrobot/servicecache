+#[cfg(test)]
+mod tests {
+    use virtual_fs::{AsyncWriteExt, mem_fs};
+
+    use super::*;
+
+    async fn write(fs: &mem_fs::FileSystem, path: &str, contents: &[u8]) {
+        let mut file = fs
+            .new_open_options()
+            .write(true)
+            .create(true)
+            .truncate(true)
+            .open(path)
+            .unwrap();
+        file.write_all(contents).await.unwrap();
+        file.flush().await.unwrap();
+    }
+
+    #[tokio::test]
+    async fn a_wasm_module_is_used_until_its_file_changes() {
+        let fs = mem_fs::FileSystem::default();
+        let module = Module::new(&wasmer::Engine::default(), "(module)").unwrap();
+        let modules = WasmModules::default();
+
+        write(&fs, "/tool.wasm", b"first").await;
+        let identity = WasmModules::identity("/tool.wasm", &fs).unwrap();
+        assert!(modules.get("/tool.wasm", identity).is_none());
+        modules.insert("/tool.wasm", identity, &module);
+        let identity = WasmModules::identity("/tool.wasm", &fs).unwrap();
+        assert!(modules.get("/tool.wasm", identity).is_some());
+        assert!(modules.get("/other.wasm", identity).is_none());
+
+        write(&fs, "/tool.wasm", b"a different module").await;
+        let identity = WasmModules::identity("/tool.wasm", &fs).unwrap();
+        assert!(modules.get("/tool.wasm", identity).is_none());
+
+        modules.insert("/tool.wasm", identity, &module);
+        modules.remove("/tool.wasm");
+        assert!(modules.get("/tool.wasm", identity).is_none());
+    }
+
+    #[cfg(feature = "host-fs")]
+    #[tokio::test]
+    async fn only_an_absolute_path_to_a_file_has_an_identity() {
+        let root = tempfile::tempdir().unwrap();
+        std::fs::write(root.path().join("tool.wasm"), b"module").unwrap();
+        std::fs::create_dir(root.path().join("dir")).unwrap();
+        let fs =
+            virtual_fs::host_fs::FileSystem::new(tokio::runtime::Handle::current(), root.path())
+                .unwrap();
+
+        assert_eq!(
+            WasmModules::identity("/tool.wasm", &fs).map(|(len, _)| len),
+            Some(6)
+        );
+        // The host filesystem finds the file by its relative name too, so it
+        // is the name alone that leaves it without an identity.
+        assert!(fs.metadata(Path::new("tool.wasm")).unwrap().is_file());
+        assert!(WasmModules::identity("tool.wasm", &fs).is_none());
+        assert!(WasmModules::identity("/dir", &fs).is_none());
+        assert!(WasmModules::identity("/missing.wasm", &fs).is_none());
+    }
+}
