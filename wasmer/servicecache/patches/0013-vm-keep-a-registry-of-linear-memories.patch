+use std::sync::{Arc, Mutex, RwLock};
 use std::time::Duration;
 use wasmer_types::{Bytes, MemoryError, MemoryStyle, MemoryType, Pages, WASM_PAGE_SIZE};
 
+/// A linear memory alive in this process, as [`linear_memories`] reports it.
+#[derive(Debug, Clone, Copy)]
+pub struct LinearMemoryInfo {
+    /// Start of the accessible bytes.
+    pub base: *mut u8,
+    /// Number of accessible bytes: the memory's current length.
+    pub len: usize,
+    /// The mapping is private and anonymous (`MAP_PRIVATE | MAP_ANONYMOUS`
+    /// with no backing file), so dropping a page with
+    /// `madvise(MADV_DONTNEED)` affects this process alone and the page reads
+    /// as zeros afterwards.
+    pub private_anonymous: bool,
+}
+
+/// A registry entry: where the memory's definition lives, which compiled
+/// code reads too, so that the base and length are always the current ones.
+struct RegisteredMemory {
+    definition: NonNull<VMMemoryDefinition>,
+    private_anonymous: bool,
+}
+
+// SAFETY: the pointer is only dereferenced by `linear_memories`, under its
+// own contract; the registry itself just stores it.
+unsafe impl Send for RegisteredMemory {}
+
+static LINEAR_MEMORIES: Mutex<Vec<RegisteredMemory>> = Mutex::new(Vec::new());
+
+fn register_memory(definition: NonNull<VMMemoryDefinition>, private_anonymous: bool) {
+    LINEAR_MEMORIES
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .push(RegisteredMemory {
+            definition,
+            private_anonymous,
+        });
+}
+
+fn unregister_memory(definition: NonNull<VMMemoryDefinition>) {
+    LINEAR_MEMORIES
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .retain(|entry| entry.definition != definition);
+}
+
+/// Every linear memory alive in this process, with its base and current
+/// length as compiled code sees them.
+///
+/// # Safety
+///
+/// The base and length are read from each memory's definition without
+/// synchronisation, and a memory's definition may live in its instance's
+/// context. The caller must ensure that, while it calls this and uses the
+/// result, no guest code runs, no memory grows and no store is dropped: for
+/// example a process that has been drained to one thread.
+pub unsafe fn linear_memories() -> Vec<LinearMemoryInfo> {
+    LINEAR_MEMORIES
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .iter()
+        .map(|entry| {
+            // SAFETY: the caller guarantees the definition is alive and not
+            // being written.
+            let definition = unsafe { entry.definition.as_ref() };
+            LinearMemoryInfo {
+                base: definition.base,
+                len: definition.current_length,
+                private_anonymous: entry.private_anonymous,
+            }
+        })
+        .collect()
+}
