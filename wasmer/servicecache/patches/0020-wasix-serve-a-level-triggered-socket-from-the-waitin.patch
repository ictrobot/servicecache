+/// The generation of this process's descriptor numbering.
+///
+/// A caller resolves descriptors, waits on them and may be answered
+/// `Unavailable` for two different reasons: the host cannot perform the wait
+/// at all, or a fork rebuilt the networking under it. Comparing this value
+/// from before the wait with this value after tells them apart, so that the
+/// second only costs the caller a fresh resolution rather than its whole
+/// direct path.
+pub fn pollfd_epoch() -> u64 {
+    POLLFD_EPOCH.load(Ordering::SeqCst)
+}
