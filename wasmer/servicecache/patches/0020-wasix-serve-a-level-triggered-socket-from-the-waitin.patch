+    }
+    if bits & wasmer_vm::HOST_POLL_WRITE != 0 && events.contains(EpollType::EPOLLOUT) {
+        readiness |= EpollType::EPOLLOUT;
+    }
+    if bits & wasmer_vm::HOST_POLL_HUP != 0 {
+        readiness |= EpollType::EPOLLHUP;
+    }
+    if bits & wasmer_vm::HOST_POLL_ERR != 0 {
+        readiness |= EpollType::EPOLLERR;
+    }
