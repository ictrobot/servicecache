+/// What a namespace table gives: the one host function a name was asked for, or
+/// every function of the namespace.
+enum HostFunctions {
+    One(Option<wasmer::Extern>),
+    All(Exports),
+}
+
+impl HostFunctions {
+    fn one(self) -> Option<wasmer::Extern> {
+        match self {
+            Self::One(function) => function,
+            Self::All(_) => unreachable!("a table asked for one name gives one function"),
+        }
+    }
+
+    fn all(self) -> Exports {
+        match self {
+            Self::All(namespace) => namespace,
+            Self::One(_) => unreachable!("a table asked for no name gives every function"),
+        }
+    }
+}
+
+/// A namespace table, written as for `namespace!`. Given `Some(name)`, it
+/// creates only the function of that name, if the table has one; given `None`,
+/// it creates every function, as `namespace!` does. Each function created is an
+/// object in the store until the store is dropped.
+macro_rules! host_functions {
+    ($name:expr; $( $import_name:literal => $import_item:expr ),* $(,)?) => {
+        match $name {
+            Some(name) => HostFunctions::One(match name {
+                $( $import_name => Some(wasmer::Extern::from($import_item)), )*
+                _ => None,
+            }),
+            None => {
+                let mut namespace = Exports::new();
+                $( namespace.insert($import_name, $import_item); )*
+                HostFunctions::All(namespace)
+            }
+        }
+    };
+}
+
+/// The WASIX host function `namespace`.`name`, created in `store`, if WASIX
+/// provides one. It is the only function created, so a module's imports are
+/// built one by one rather than by building every namespace they come from.
+fn wasix_import(
+    store: &mut impl AsStoreMut,
+    env: &FunctionEnv<WasiEnv>,
+    namespace: &str,
+    name: &str,
+) -> Option<wasmer::Extern> {
+    let name = Some(name);
+    let functions = match namespace {
+        "wasi" => wasi_exports_generic(store, env, name),
+        "wasi_unstable" => wasi_unstable_exports(store, env, name),
+        "wasi_snapshot_preview1" => wasi_snapshot_preview1_exports(store, env, name),
+        "wasix_32v1" => wasix_exports_32(store, env, name),
+        "wasix_64v1" => wasix_exports_64(store, env, name),
+        "ictrobot_shm_v1" if extension_enabled(store, env, "ictrobot_shm_v1") => {
+            ictrobot_shm_exports(store, env, name)
+        }
+        _ => return None,
+    };
+    functions.one()
+}
