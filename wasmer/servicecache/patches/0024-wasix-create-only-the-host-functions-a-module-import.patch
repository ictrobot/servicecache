+#[cfg(all(test, feature = "sys"))]
+mod import_object_tests {
+    use super::*;
+
+    fn tokio_runtime() -> tokio::runtime::Runtime {
+        tokio::runtime::Builder::new_multi_thread()
+            .enable_all()
+            .build()
+            .unwrap()
+    }
+
+    #[test]
+    fn every_function_of_a_namespace_is_found_by_its_name() {
+        let runtime = tokio_runtime();
+        let _guard = runtime.enter();
+        let engine = wasmer::Engine::default();
+        let mut store = wasmer::Store::new(engine.clone());
+        let func_env = WasiEnv::builder("test_prog")
+            .engine(engine)
+            .finalize(&mut store)
+            .unwrap();
+        let env = &func_env.env;
+
+        let namespaces = [
+            ("wasi", wasi_exports_generic(&mut store, env, None).all()),
+            (
+                "wasi_unstable",
+                wasi_unstable_exports(&mut store, env, None).all(),
+            ),
+            (
+                "wasi_snapshot_preview1",
+                wasi_snapshot_preview1_exports(&mut store, env, None).all(),
+            ),
+            ("wasix_32v1", wasix_exports_32(&mut store, env, None).all()),
+            ("wasix_64v1", wasix_exports_64(&mut store, env, None).all()),
+            (
+                "ictrobot_shm_v1",
+                ictrobot_shm_exports(&mut store, env, None).all(),
+            ),
+        ];
+        for (namespace, functions) in &namespaces {
+            assert!(!functions.is_empty(), "{namespace} is empty");
+            for (name, _) in functions.iter() {
+                assert!(
+                    wasix_import(&mut store, env, namespace, name).is_some(),
+                    "{namespace}.{name} is not found by its name"
+                );
+            }
+        }
+        assert!(wasix_import(&mut store, env, "wasix_32v1", "no_such_function").is_none());
+        assert!(wasix_import(&mut store, env, "no_such_namespace", "args_get").is_none());
+    }
+
+    #[test]
+    fn a_module_is_instantiated_from_its_imports_alone() {
+        let runtime = tokio_runtime();
+        let _guard = runtime.enter();
+        let engine = wasmer::Engine::default();
+        let mut store = wasmer::Store::new(engine.clone());
+        let module = wasmer::Module::new(
+            &engine,
+            r#"(module
+                (import "wasi_snapshot_preview1" "fd_write"
+                    (func (param i32 i32 i32 i32) (result i32)))
+                (memory (export "memory") 1)
+                (func (export "_start")))"#,
+        )
+        .unwrap();
+        let (instance, _func_env) = WasiEnv::builder("test_prog")
+            .engine(engine.clone())
+            .instantiate(module, &mut store)
+            .unwrap();
+        instance
+            .exports
+            .get_function("_start")
+            .unwrap()
+            .call(&mut store, &[])
+            .unwrap();
+
+        // An import no namespace provides fails to link, with the error
+        // instantiating from an import object gives.
+        let module = wasmer::Module::new(
+            &engine,
+            r#"(module
+                (import "wasix_32v1" "no_such_function" (func))
+                (memory (export "memory") 1))"#,
+        )
+        .unwrap();
+        let error = WasiEnv::builder("test_prog")
+            .engine(engine)
+            .instantiate(module, &mut store)
+            .unwrap_err();
+        let WasiRuntimeError::Thread(WasiThreadError::InstanceCreateFailed(error)) = error else {
+            panic!("expected an instantiation failure, got {error}");
+        };
+        assert!(
+            matches!(
+                &*error,
+                wasmer::InstantiationError::Link(wasmer::LinkError::Import(
+                    namespace,
+                    name,
+                    wasmer_types::ImportError::UnknownImport(_),
+                )) if namespace == "wasix_32v1" && name == "no_such_function"
+            ),
+            "{error}"
+        );
+    }
+
+    #[test]
+    fn only_the_functions_a_module_imports_are_created() {
+        let runtime = tokio_runtime();
+        let _guard = runtime.enter();
+        let engine = wasmer::Engine::default();
+        let mut store = wasmer::Store::new(engine.clone());
+        let module = wasmer::Module::new(
+            &engine,
+            r#"(module
+                (import "wasi_snapshot_preview1" "fd_write"
+                    (func (param i32 i32 i32 i32) (result i32)))
+                (import "wasix_32v1" "futex_wait"
+                    (func (param i32 i32 i32 i32) (result i32))))"#,
+        )
+        .unwrap();
+        let func_env = WasiEnv::builder("test_prog")
+            .engine(engine)
+            .finalize(&mut store)
+            .unwrap();
+
+        let imports = import_object_for_all_wasi_versions(&module, &mut store, &func_env.env);
+        let mut names: Vec<_> = imports
+            .iter()
+            .map(|(namespace, name, _)| format!("{namespace}.{name}"))
+            .collect();
+        names.sort();
+        assert_eq!(
+            names,
+            ["wasi_snapshot_preview1.fd_write", "wasix_32v1.futex_wait"]
+        );
+
+        // Without a module, every function of the version is still provided.
+        let all =
+            generate_import_object_from_env(&mut store, &func_env.env, WasiVersion::Wasix32v1);
+        assert!(all.exists("wasix_32v1", "futex_wait"));
+        assert!(all.exists("wasix_32v1", "args_get"));
+        assert!(all.exists("wasi", "thread-spawn"));
+    }
+}
