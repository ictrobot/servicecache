+/// Whether the environment registers an extension namespace: every one the
+/// runtime carries when the embedder set no list, otherwise only the listed
+/// ones, so that anything else fails to instantiate exactly as it would on
+/// a runtime without the extension.
+fn extension_enabled(
+    store: &impl AsStoreMut,
+    ctx: &FunctionEnv<WasiEnv>,
+    namespace: &str,
+) -> bool {
+    ctx.as_ref(store)
+        .capabilities
+        .extensions
+        .as_ref()
+        .is_none_or(|enabled| enabled.contains(namespace))
+}
