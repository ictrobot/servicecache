Subject: wasix: suspend finite clock-only polls directly

A poll_oneoff with one finite clock subscription and nothing else is a
sleep, and the commonest wait in a guest whose threads pace themselves
with short timeouts. It went through the general polling path: the
subscriptions parsed into vectors, a batch of descriptor guards, a
Tokio timer, the future selecting between them and a waker, built and
torn down for every sleep.

Suspend such a call directly instead, before any of that, as the wait
a futex takes but with no guest word: the coroutine yields it to its
host loop, which blocks in the embedder's hook on the WASI thread's
interrupt generation and the freeze-gate generation until the absolute
deadline. Reaching the deadline completes the poll with its clock
event. Anything else falls through to the general path, which handles
it as before: an interrupt finishes the sleep there with the full
signal and termination processing, and a host without the direct wait
never leaves it.

Journaled calls keep the general path, since a replayed poll_oneoff
must first consume its recorded result through handle_rewind. Polls
that mix a clock with descriptors, immediate polls and infinite waits
are unchanged.

diff --git a/lib/wasix/src/syscalls/wasi/poll_oneoff.rs b/lib/wasix/src/syscalls/wasi/poll_oneoff.rs
index 73a96d6..0b6c726 100644
--- a/lib/wasix/src/syscalls/wasi/poll_oneoff.rs
+++ b/lib/wasix/src/syscalls/wasi/poll_oneoff.rs
@@ -92,6 +92,87 @@ pub fn poll_oneoff<M: MemorySize + 'static>(
     ctx = wasi_try_ok!(maybe_snapshot::<M>(ctx)?);
     ctx.data_mut().poll_seed += 1;
 
+    // A single finite clock subscription is a sleep: there is no readiness to
+    // combine with its timeout, and the general path below would parse it
+    // into vectors of subscriptions, clocks and events around a wait that
+    // looks at none of them. Suspend it directly instead, as a futex wait
+    // with no guest word, so the guest thread stays in an interruptible
+    // kernel wait without a Tokio timer, future graph or waker. Anything but
+    // the deadline falls through to the general path: an interrupt, a host
+    // without the direct wait, a journaled call that must first consume its
+    // serialized result through `handle_rewind`, or a clock the general path
+    // treats as immediate (see its reading of `timeout`).
+    #[cfg(feature = "host-futex")]
+    if nsubscriptions_usize == 1 && !ctx.data().enable_journal {
+        let subscription = {
+            let env = ctx.data();
+            let memory = unsafe { env.memory_view(&ctx) };
+            let subscription_array = wasi_try_mem_ok!(in_.slice(&memory, nsubscriptions));
+            wasi_try_mem_ok!(subscription_array.index(0).read())
+        };
+        if subscription.type_ == Eventtype::Clock {
+            let clock = unsafe { subscription.data.clock };
+            if (clock.clock_id == Clockid::Realtime || clock.clock_id == Clockid::Monotonic)
+                && clock.timeout > 1
+            {
+                let timeout = if clock
+                    .flags
+                    .contains(Subclockflags::SUBSCRIPTION_CLOCK_ABSTIME)
+                {
+                    let now = wasi_try_ok!(platform_clock_time_get(Snapshot0Clockid::Monotonic, 1))
+                        as u64;
+                    if clock.timeout <= now {
+                        Duration::ZERO
+                    } else {
+                        Duration::from_nanos(clock.timeout) - Duration::from_nanos(now)
+                    }
+                } else {
+                    Duration::from_nanos(clock.timeout)
+                };
+                if !timeout.is_zero()
+                    && let Some(deadline) = Instant::now().checked_add(timeout)
+                {
+                    {
+                        let env = ctx.data();
+                        let memory = unsafe { env.memory_view(&ctx) };
+                        wasi_try_mem_ok!(nevents.write(&memory, M::ZERO));
+                    }
+                    Span::current().record("timeout_ns", timeout.as_millis());
+                    // Capture before the final signal check, as the general
+                    // path does: a notification already queued is processed
+                    // by the check, and one arriving afterwards changes this
+                    // generation and interrupts the host wait.
+                    let wait_interrupt = ctx.data().thread.wait_interrupt();
+                    wasi_try_ok!(WasiEnv::process_signals_and_exit(&mut ctx)?);
+                    let result = unsafe {
+                        wasmer_vm::try_suspend_on_futex(
+                            None,
+                            wait_interrupt.0,
+                            wait_interrupt.1,
+                            Some(deadline),
+                        )
+                    };
+                    if result == Some(wasmer_vm::HostFutexResult::TimedOut) {
+                        let event = Event {
+                            userdata: subscription.userdata,
+                            error: Errno::Success,
+                            type_: Eventtype::Clock,
+                            u: EventUnion { clock: 0 },
+                        };
+                        let env = ctx.data();
+                        let memory = unsafe { env.memory_view(&ctx) };
+                        let event_array = wasi_try_mem_ok!(out_.slice(&memory, nsubscriptions));
+                        wasi_try_mem_ok!(event_array.index(0).write(event));
+                        let one: M::Offset = 1_u32.into();
+                        wasi_try_mem_ok!(nevents.write(&memory, one));
+                        Span::current().record("seen", "clock");
+                        return Ok(Errno::Success);
+                    }
+                }
+            }
+        }
+    }
+
     let mut env = ctx.data();
     let mut memory = unsafe { env.memory_view(&ctx) };
 
