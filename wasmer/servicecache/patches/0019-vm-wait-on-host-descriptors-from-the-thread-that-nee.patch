+
+        /// Every descriptor of a ready wait is answered, the quiet ones with
+        /// nothing: the caller reads which of them fired out of the array it
+        /// handed over, and never has to ask the descriptors again.
+        #[test]
+        fn a_ready_wait_answers_every_descriptor() {
+            enable();
+            let (quiet, _quiet_peer) = std::os::unix::net::UnixStream::pair().unwrap();
+            let (loud, mut loud_peer) = std::os::unix::net::UnixStream::pair().unwrap();
+            let mut fds = [read_fd(quiet.as_raw_fd()), read_fd(loud.as_raw_fd())];
+            fds[0].revents = u16::MAX;
+            fds[1].revents = u16::MAX;
