+        /// A thread that retires into a freeze leaves through the raw exit
+        /// syscall and runs no destructor, so the descriptor it made is
+        /// closed for it. Leaving it open costs one descriptor per waiting
+        /// guest thread per freeze, without bound.
+        #[test]
+        fn a_retiring_thread_closes_its_interrupt_descriptor() {
+            let retired = thread::spawn(|| {
+                // Nothing to close before one is made, and asking twice
+                // gives the same descriptor.
+                thread_retiring();
+                let fd = interrupt_fd().unwrap();
+                assert_eq!(interrupt_fd(), Some(fd));
+
+                thread_retiring();
+                assert_eq!(INTERRUPT.with(|slot| slot.fd.get()), -1);
+                // SAFETY: a descriptor query with no memory arguments. The
+                // number was this thread's and nothing here reopens one.
+                let still_open = unsafe { libc::fcntl(fd, libc::F_GETFD) } >= 0;
+                assert!(!still_open, "the interrupt descriptor was left open");
+
+                // The next wait on the thread makes another one.
+                interrupt_fd().unwrap()
+            });
+            assert!(retired.join().unwrap() >= 0);
+        }
+
+        /// A wait ended by the interrupt descriptor reads it to zero on its
+        /// way past, so the next wait on the same thread starts clean. The
+        /// second wait here asks only what is ready now: a count left on the
+        /// descriptor would end its poll at once, every turn, and it would
+        /// never answer.
+        #[test]
+        fn an_interrupt_leaves_the_descriptor_clean_for_the_next_wait() {
+            enable();
+            let (a, _b) = std::os::unix::net::UnixStream::pair().unwrap();
+            let words = Words::new();
+            let waiter_words = words.clone();
+            let (tx, rx) = mpsc::channel();
+            let waiter = thread::spawn(move || {
+                let mut fds = [read_fd(a.as_raw_fd())];
+                let first = wait(request(
+                    &waiter_words,
+                    &mut fds,
+                    Some(Instant::now() + Duration::from_secs(10)),
+                ));
+                let mut fds = [read_fd(a.as_raw_fd())];
+                let second = wait(request_expecting(
+                    &waiter_words,
+                    &mut fds,
+                    Some(Instant::now()),
+                    1,
+                ));
+                drop(a);
+                tx.send((first, second)).unwrap();
+            });
+            wait_until_registered();
+            words.interrupt.fetch_add(1, Ordering::SeqCst);
+            wake((&raw const words.interrupt).cast());
+            let (first, second) = rx
+                .recv_timeout(Duration::from_secs(10))
+                .expect("the second wait never answered");
+            assert_eq!(first, HostPollFdResult::Interrupted);
+            assert_eq!(second, HostPollFdResult::TimedOut);
+            waiter.join().unwrap();
+        }
+
