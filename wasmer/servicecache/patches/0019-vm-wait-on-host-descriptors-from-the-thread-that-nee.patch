+
+        /// A signal raised on the waiting thread from another one changes the
+        /// interrupt word and wakes it through the interrupt descriptor.
+        #[test]
+        fn another_thread_ends_the_wait_through_the_interrupt_word() {
+            enable();
+            let (a, _b) = std::os::unix::net::UnixStream::pair().unwrap();
+            let words = Words::new();
+            let waiter_words = words.clone();
+            let waiter = thread::spawn(move || {
+                let mut fds = [read_fd(a.as_raw_fd())];
