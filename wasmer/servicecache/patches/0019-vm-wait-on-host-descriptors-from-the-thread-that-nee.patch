+            // close is all that is left, and it is the end of the stream.
+            let mut buffer = [0u8; 5];
+            std::io::Read::read_exact(&mut &a, &mut buffer).unwrap();
+            let mut fds = [HostPollFd {
+                fd: a.as_raw_fd(),
+                events: HOST_POLL_READ | HOST_POLL_RDHUP,
+                revents: 0,
+                nbytes: 7,
