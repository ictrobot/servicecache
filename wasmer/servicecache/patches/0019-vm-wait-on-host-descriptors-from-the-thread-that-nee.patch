diff --git a/lib/vm/src/trap/pollfd.rs b/lib/vm/src/trap/pollfd.rs
new file mode 100644
index 0000000..98a1155
--- /dev/null
+++ b/lib/vm/src/trap/pollfd.rs
@@ -0,0 +1,1118 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0 WITH LLVM-exception
+// Copyright (c) 2026 Ethan Jones
+
+//! Waiting on host descriptors from the guest thread that needs them.
+//!
+//! A guest thread blocked on a socket goes through the shared event
+//! selector: the kernel wakes the selector's poll thread, which then wakes
+//! the guest thread, so one readiness event requires a handoff through the
+//! selector thread. A wait that names nothing but kernel descriptors does
+//! not need that. When a syscall hands descriptors here, the wait blocks
+//! in `ppoll(2)` on the calling thread, which is the guest thread itself,
+//! so the kernel wakes exactly the thread that wants the event and the
+//! wait reports what each descriptor did.
+//!
+//! The wait owns nothing but one interrupt eventfd per waiting thread: it
+//! names descriptors its caller keeps open for it and writes back what each
+//! one did.
+
+use super::suspend::{
+    HOST_POLL_ERR, HOST_POLL_FDS_MAX, HOST_POLL_HUP, HOST_POLL_RDHUP, HOST_POLL_READ,
+    HOST_POLL_WRITE, HostPollFd, HostPollFdResult, HostPollFdWait,
+};
+
+#[cfg(target_os = "linux")]
+mod linux {
+    use std::io;
+    use std::os::fd::RawFd;
+    use std::sync::atomic::{AtomicU8, AtomicU32, AtomicUsize, Ordering};
+    use std::sync::{Mutex, PoisonError};
+    use std::time::Instant;
+
+    use super::{
+        HOST_POLL_ERR, HOST_POLL_FDS_MAX, HOST_POLL_HUP, HOST_POLL_RDHUP, HOST_POLL_READ,
+        HOST_POLL_WRITE, HostPollFd, HostPollFdResult, HostPollFdWait,
+    };
+
+    /// The wait's state: not yet decided, in use, never available
+    /// (`DISABLE_DIRECT_POLL` is set), or turned off after a call this code
+    /// could not interpret. `ppoll` and `eventfd` are old enough to need no
+    /// probe, so the first wait decides by the variable alone.
+    const UNKNOWN: u8 = 0;
+    const SUPPORTED: u8 = 1;
+    const UNAVAILABLE: u8 = 2;
+    const DISABLED: u8 = 3;
+
+    static SUPPORT: AtomicU8 = AtomicU8::new(UNKNOWN);
+
+    /// The largest wait this accepts: the limit a caller sizes its own
+    /// arrays by, and the interrupt descriptor beside it. A larger one is
+    /// refused rather than truncated, because a truncated wait would sleep
+    /// through the descriptors it dropped.
+    const MAX_POLL_FDS: usize = HOST_POLL_FDS_MAX + 1;
+
+    /// One thread inside a wait.
+    struct Waiter {
+        /// The interrupt word it is watching, as an address, so that the
+        /// list can be held in a static.
+        word: usize,
+        /// Its interrupt descriptor.
+        interrupt: RawFd,
+    }
+
+    /// Every thread currently inside a wait. A thread is in this list only
+    /// while it is between `register` and `unregister` below, so an entry
+    /// never outlives the descriptors or the word it names.
+    static WAITERS: Mutex<Vec<Waiter>> = Mutex::new(Vec::new());
+
+    /// How many entries `WAITERS` holds, so that a wake with nothing to do -
+    /// which is every wake in a process where no thread is waiting directly -
+    /// answers without taking the lock.
+    static WAITER_COUNT: AtomicUsize = AtomicUsize::new(0);
+
+    thread_local! {
+        /// This thread's interrupt descriptor, created on its first direct
+        /// wait and closed when the thread ends, together with what the last
+        /// wait left on it.
+        ///
+        /// A thread that retires into a freeze exits with the raw syscall
+        /// and runs no destructor, so `thread_retiring` below is what
+        /// closes it there.
+        static INTERRUPT: Interrupt = const {
+            Interrupt {
+                fd: std::cell::Cell::new(-1),
+                undrained: std::cell::Cell::new(false),
+            }
+        };
+    }
+
+    struct Interrupt {
+        fd: std::cell::Cell<RawFd>,
+        /// Whether the descriptor is known to hold a count nothing has read.
+        /// A wait that ends while the interrupt slot is readable leaves this
+        /// set rather than paying a `read(2)` for it, and the next wait
+        /// drains it before it sleeps. It is a hint and never more than one:
+        /// `wait_registered` is correct whichever way it is wrong.
+        undrained: std::cell::Cell<bool>,
+    }
+
+    impl Drop for Interrupt {
+        fn drop(&mut self) {
+            let fd = self.fd.replace(-1);
+            if fd >= 0 {
+                // SAFETY: this thread created the descriptor and, having
+                // reached its own destructors, is not inside a wait, so it is
+                // not in `WAITERS` and nothing else can write it.
+                unsafe { libc::close(fd) };
+            }
+        }
+    }
+
+    /// Whether a direct descriptor wait can be made, deciding on the first
+    /// call.
+    pub(crate) fn supported() -> bool {
+        match SUPPORT.load(Ordering::Acquire) {
+            UNKNOWN => decide(),
+            state => state == SUPPORTED,
+        }
+    }
+
+    #[cold]
+    fn decide() -> bool {
+        let state = if std::env::var_os("DISABLE_DIRECT_POLL").is_some() {
+            #[cfg(feature = "tracing")]
+            tracing::warn!("DISABLE_DIRECT_POLL is set; disabling the direct descriptor wait");
+            UNAVAILABLE
+        } else {
+            SUPPORTED
+        };
+        // Only a state still unknown is decided here: a wait that gave up on
+        // the backend has already answered and its answer stands.
+        let _ = SUPPORT.compare_exchange(UNKNOWN, state, Ordering::AcqRel, Ordering::Acquire);
+        SUPPORT.load(Ordering::Acquire) == SUPPORTED
+    }
+
+    /// Closes this thread's interrupt descriptor as the thread retires.
+    ///
+    /// A thread that retires into a freeze leaves through the raw exit
+    /// syscall and runs no destructor, so without this the descriptor is
+    /// leaked: one per waiting guest thread per freeze, which grows without
+    /// bound in a process that freezes again and again. Taking the waiter
+    /// lock is what makes the close safe - a wake only writes descriptors
+    /// it finds while holding it - and a retiring thread left its wait
+    /// before it got here, so it holds no entry in the list.
+    pub(crate) fn thread_retiring() {
+        let _waiters = WAITERS.lock().unwrap_or_else(PoisonError::into_inner);
+        INTERRUPT.with(|slot| {
+            let fd = slot.fd.replace(-1);
+            if fd >= 0 {
+                slot.undrained.set(false);
+                // SAFETY: this thread created the descriptor and is not
+                // inside a wait, so nothing else can write it.
+                unsafe { libc::close(fd) };
+            }
+        });
+    }
+
+    /// This thread's interrupt descriptor, created on first use.
+    ///
+    /// An eventfd is a counter and reads level-triggered, so a wake that
+    /// arrives while the thread is running is still there when it reaches
+    /// `ppoll(2)`, whether or not anything drained it first. That is what
+    /// lets the drain be skipped: see `wait_registered`.
+    fn interrupt_fd() -> Option<RawFd> {
+        INTERRUPT.with(|slot| {
+            let existing = slot.fd.get();
+            if existing >= 0 {
+                return Some(existing);
+            }
+            // SAFETY: a plain constructor call with no pointer arguments.
+            let fd = unsafe { libc::eventfd(0, libc::EFD_CLOEXEC | libc::EFD_NONBLOCK) };
+            if fd < 0 {
+                return None;
+            }
+            slot.fd.set(fd);
+            Some(fd)
+        })
+    }
+
+    fn register(word: *const u32, interrupt: RawFd) {
+        let entry = Waiter {
+            word: word as usize,
+            interrupt,
+        };
+        let mut waiters = WAITERS.lock().unwrap_or_else(PoisonError::into_inner);
+        waiters.push(entry);
+        WAITER_COUNT.store(waiters.len(), Ordering::Release);
+        // This publishes the entry to a waker that has already changed a
+        // generation word and is about to read the count. Releasing the
+        // mutex orders the two stores but not this thread's later load of
+        // the generation, and without that order both sides can miss each
+        // other: the waker reads no waiters and writes nothing, the waiter
+        // reads a generation that has already moved and sleeps anyway.
+        std::sync::atomic::fence(Ordering::SeqCst);
+    }
+
+    fn unregister(word: *const u32, interrupt: RawFd) {
+        let mut waiters = WAITERS.lock().unwrap_or_else(PoisonError::into_inner);
+        if let Some(index) = waiters
+            .iter()
+            .position(|entry| entry.word == word as usize && entry.interrupt == interrupt)
+        {
+            waiters.swap_remove(index);
+        }
+        WAITER_COUNT.store(waiters.len(), Ordering::Release);
+    }
+
+    /// Ends the wait of every thread watching `address`, or of every waiter
+    /// when `address` is null.
+    ///
+    /// This cannot lose a wake. A caller changes the generation word before
+    /// it calls here, and a waiter registers before it reads the generation,
+    /// so a waiter this call does not find has yet to read a value that has
+    /// already changed - which the fence below is what makes true.
+    pub(crate) fn wake(address: *const u32) {
+        // The pair of this is the fence at the end of `register`: between
+        // them, one of the two sides always sees the other's write.
+        std::sync::atomic::fence(Ordering::SeqCst);
+        if WAITER_COUNT.load(Ordering::Acquire) == 0 {
+            return;
+        }
+        let waiters = WAITERS.lock().unwrap_or_else(PoisonError::into_inner);
+        for waiter in waiters.iter() {
+            if !address.is_null() && waiter.word != address as usize {
+                continue;
+            }
+            write_interrupt(waiter.interrupt);
+        }
+    }
+
+    fn write_interrupt(fd: RawFd) {
+        let value: u64 = 1;
+        // SAFETY: the descriptor belongs to a thread still inside its wait,
+        // which holds the entry, and an eventfd write takes eight bytes
+        // from the caller.
+        unsafe {
+            libc::write(fd, std::ptr::from_ref(&value).cast(), 8);
+        }
+    }
+
+    pub(crate) fn wait(request: HostPollFdWait) -> HostPollFdResult {
+        if SUPPORT.load(Ordering::Acquire) != SUPPORTED {
+            return HostPollFdResult::Unavailable;
+        }
+        if request.fd_count == 0 || request.fd_count + 1 > MAX_POLL_FDS {
+            return HostPollFdResult::Unavailable;
+        }
+        let Some(interrupt) = interrupt_fd() else {
+            return disable_after_error(io::Error::last_os_error().raw_os_error());
+        };
+        // SAFETY: the hook contract keeps the array live for this call and
+        // hands it over to be written.
+        let fds = unsafe { std::slice::from_raw_parts_mut(request.fds, request.fd_count) };
+
+        let mut poll_fds = [libc::pollfd {
+            fd: -1,
+            events: 0,
+            revents: 0,
+        }; MAX_POLL_FDS];
+        // The interrupt descriptor goes first so that the descriptors the
+        // guest named keep the order it gave them.
+        poll_fds[0] = libc::pollfd {
+            fd: interrupt,
+            events: libc::POLLIN,
+            revents: 0,
+        };
+        for (slot, wanted) in poll_fds[1..].iter_mut().zip(fds.iter()) {
+            *slot = libc::pollfd {
+                fd: wanted.fd,
+                events: poll_events(*wanted),
+                revents: 0,
+            };
+        }
+        let used = fds.len() + 1;
+
+        // What the last wait on this thread left on the descriptor. It is
+        // carried across calls rather than read away at the end of one,
+        // because a wait that ends on a descriptor the guest asked about is
+        // the common case and it should cost nothing.
+        let mut undrained = INTERRUPT.with(|slot| slot.undrained.get());
+
+        register(request.interrupt, interrupt);
+        let result = wait_registered(
+            &mut poll_fds[..used],
+            fds,
+            &request,
+            interrupt,
+            &mut undrained,
+        );
+        unregister(request.interrupt, interrupt);
+        INTERRUPT.with(|slot| slot.undrained.set(undrained));
+        result
+    }
+
+    /// Maps the requested events. Hangup, error and an invalid descriptor
+    /// are reported by the kernel whether or not they were asked for, so a
+    /// wait for writability still ends when the peer goes away, and a
+    /// descriptor closed under the wait ends it rather than hanging it.
+    /// A peer that has shut only its writing half down is the exception:
+    /// the kernel reports that one only to a caller that asked for it.
+    fn poll_events(wanted: HostPollFd) -> libc::c_short {
+        let mut events = 0;
+        if wanted.events & HOST_POLL_READ != 0 {
+            events |= libc::POLLIN;
+        }
+        if wanted.events & HOST_POLL_WRITE != 0 {
+            events |= libc::POLLOUT;
+        }
+        if wanted.events & HOST_POLL_RDHUP != 0 {
+            events |= libc::POLLRDHUP;
+        }
+        events
+    }
+
+    /// Maps what the kernel reported back into the runtime's bits. An
+    /// invalid descriptor joins the error bit: to the guest both mean the
+    /// socket cannot be waited on and the event must be reported now.
+    fn host_revents(revents: libc::c_short) -> u16 {
+        let mut bits = 0;
+        if revents & libc::POLLIN != 0 {
+            bits |= HOST_POLL_READ;
+        }
+        if revents & libc::POLLOUT != 0 {
+            bits |= HOST_POLL_WRITE;
+        }
+        if revents & libc::POLLHUP != 0 {
+            bits |= HOST_POLL_HUP;
+        }
+        if revents & libc::POLLRDHUP != 0 {
+            bits |= HOST_POLL_RDHUP;
+        }
+        if revents & (libc::POLLERR | libc::POLLNVAL) != 0 {
+            bits |= HOST_POLL_ERR;
+        }
+        bits
+    }
+
+    /// The wait proper, with the thread registered for wakes.
+    ///
+    /// `undrained` says whether the interrupt descriptor is known to hold a
+    /// count, and is left saying so on return. The descriptor is read only
+    /// when it does: on the first turn when the previous wait left one
+    /// behind, and on any later turn when the previous `ppoll` reported the
+    /// slot readable. Reading it on every turn cost a `read(2)` on every
+    /// wait, and skipping it loses no wake:
+    ///
+    /// - a writer changes a generation *before* it writes the descriptor, so
+    ///   a wake that lands while this thread runs - after one `ppoll` and
+    ///   before the next - is seen by the generation check below, which is
+    ///   read after the drain either way. The drain was never what observed
+    ///   a wake; it only kept a spent count from ending the next sleep early.
+    /// - a count nobody drained does exactly that and no more. The next
+    ///   `ppoll` returns at once with the interrupt slot readable and no
+    ///   other descriptor set, which is the bottom of this loop; the turn
+    ///   after drains the count, re-reads the generations and sleeps for
+    ///   what is left of the deadline, which is recomputed each turn and so
+    ///   is never extended. One spurious return per undrained count, and a
+    ///   count is at most one because the descriptor is read to zero.
+    /// - the flag is only ever wrong in the cheap direction. Wrongly set,
+    ///   the drain reads nothing from a non-blocking descriptor. Wrongly
+    ///   clear - a wake written in the window between `ppoll` returning and
+    ///   the thread unregistering - costs the one spurious return above.
+    fn wait_registered(
+        poll_fds: &mut [libc::pollfd],
+        fds: &mut [HostPollFd],
+        request: &HostPollFdWait,
+        interrupt: RawFd,
+        undrained: &mut bool,
+    ) -> HostPollFdResult {
+        loop {
+            // Drained before the generations are read: a wake drained here
+            // changed a generation first, so the read below sees it. A wake
+            // that arrives after the read finds this thread registered and
+            // its write is what ends the poll.
+            if *undrained {
+                drain(interrupt);
+                *undrained = false;
+            }
+            if load(request.gate) != request.gate_expected
+                || load(request.interrupt) != request.interrupt_expected
+            {
+                return HostPollFdResult::Interrupted;
+            }
+            let timeout = match request.deadline {
+                None => None,
+                Some(deadline) => {
+                    // A deadline that has already passed is not a refusal to
+                    // look: the caller asked what is ready now, which is what
+                    // a guest's non-blocking wait is, and a zero timeout
+                    // answers that without blocking. Nothing ready is then
+                    // reported as the deadline it is.
+                    let remaining = deadline.saturating_duration_since(Instant::now());
+                    Some(libc::timespec {
+                        tv_sec: libc::time_t::try_from(remaining.as_secs())
+                            .unwrap_or(libc::time_t::MAX),
+                        tv_nsec: libc::c_long::from(remaining.subsec_nanos()),
+                    })
+                }
+            };
+            for slot in poll_fds.iter_mut() {
+                slot.revents = 0;
+            }
+            // `ppoll` rather than `poll` for the nanosecond timeout: a guest
+            // that asks to sleep for a fraction of a millisecond gets that,
+            // where `poll`'s millisecond timeout would round it up.
+            //
+            // SAFETY: the array is this frame's, the timeout is a local, and
+            // a null signal mask leaves the thread's mask alone.
+            let ready = unsafe {
+                libc::ppoll(
+                    poll_fds.as_mut_ptr(),
+                    poll_fds.len() as libc::nfds_t,
+                    timeout
+                        .as_ref()
+                        .map_or(std::ptr::null(), std::ptr::from_ref),
+                    std::ptr::null(),
+                )
+            };
+            if ready < 0 {
+                match io::Error::last_os_error().raw_os_error() {
+                    // A Unix signal can interrupt the call independently of a
+                    // WASIX one. Recheck the generations and go round again.
+                    Some(libc::EINTR) => continue,
+                    other => return disable_after_error(other),
+                }
+            }
+            if ready == 0 {
+                return HostPollFdResult::TimedOut;
+            }
+            // Whatever the interrupt slot reported is a count left on the
+            // descriptor, for the next turn or the next wait to read away.
+            *undrained = poll_fds[0].revents != 0;
+            if poll_fds[1..].iter().any(|slot| slot.revents != 0) {
+                // Every descriptor is answered, the quiet ones with zero, so
+                // that the caller reads the whole set from the array it gave
+                // and asks no descriptor again.
+                for (slot, out) in poll_fds[1..].iter().zip(fds.iter_mut()) {
+                    out.revents = host_revents(slot.revents);
+                    out.nbytes = if out.revents & (HOST_POLL_RDHUP | HOST_POLL_HUP) != 0 {
+                        still_readable(slot.fd)
+                    } else {
+                        0
+                    };
+                }
+                return HostPollFdResult::Ready;
+            }
+            // Only the interrupt descriptor fired. Every writer of it changes
+            // a generation first, so the next turn of this loop sees the
+            // change and reports it; a write that changed nothing is drained
+            // at the top of that turn and the wait resumes for what is left
+            // of its deadline.
+        }
+    }
+
+    /// One when the descriptor still holds bytes and zero when it does not,
+    /// for the answers that need to know: a peer that has shut its writing
+    /// half down, or gone away altogether, reports the same readiness
+    /// whether or not what it sent last is still unread. One byte peeked
+    /// tells the two apart and takes nothing out of the kernel; a
+    /// descriptor that cannot answer reads as the end of the stream.
+    fn still_readable(fd: RawFd) -> u32 {
+        let mut probe = 0u8;
+        // SAFETY: `MSG_PEEK` copies at most one byte into `probe` and
+        // dequeues nothing, and the descriptor is one this wait was handed.
+        let n = unsafe {
+            libc::recv(
+                fd,
+                (&raw mut probe).cast(),
+                1,
+                libc::MSG_PEEK | libc::MSG_DONTWAIT,
+            )
+        };
+        u32::from(n > 0)
+    }
+
+    fn drain(fd: RawFd) {
+        let mut value: u64 = 0;
+        // SAFETY: an eventfd read takes eight bytes into the caller's buffer,
+        // and the descriptor is non-blocking, so this returns at once.
+        unsafe {
+            libc::read(fd, std::ptr::from_mut(&mut value).cast(), 8);
+        }
+    }
+
+    fn load(address: *const u32) -> u32 {
+        // SAFETY: the hook contract supplies a live and aligned 32-bit word.
+        unsafe { AtomicU32::from_ptr(address.cast_mut()) }.load(Ordering::Acquire)
+    }
+
+    /// Gives up on the backend for the rest of the process after a call this
+    /// code cannot interpret. Every later wait falls back without asking, and
+    /// only the wait that turns it off says so.
+    fn disable_after_error(errno: Option<i32>) -> HostPollFdResult {
+        if SUPPORT.swap(DISABLED, Ordering::AcqRel) == SUPPORTED {
+            report_giving_up(errno);
+        }
+        HostPollFdResult::Unavailable
+    }
+
+    #[cfg(feature = "tracing")]
+    fn report_giving_up(errno: Option<i32>) {
+        tracing::warn!(
+            errno,
+            error = %io::Error::from_raw_os_error(errno.unwrap_or(libc::EIO)),
+            "a direct descriptor wait failed; disabling the direct descriptor wait"
+        );
+    }
+
+    #[cfg(not(feature = "tracing"))]
+    fn report_giving_up(_errno: Option<i32>) {}
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+        use std::io::Write as _;
+        use std::os::fd::AsRawFd;
+        use std::sync::Arc;
+        use std::sync::mpsc;
+        use std::thread;
+        use std::time::Duration;
+
+        struct Words {
+            interrupt: AtomicU32,
+            gate: AtomicU32,
+        }
+
+        impl Words {
+            fn new() -> Arc<Self> {
+                Arc::new(Self {
+                    interrupt: AtomicU32::new(0),
+                    gate: AtomicU32::new(0),
+                })
+            }
+        }
+
+        fn request(
+            words: &Words,
+            fds: &mut [HostPollFd],
+            deadline: Option<Instant>,
+        ) -> HostPollFdWait {
+            request_expecting(words, fds, deadline, 0)
+        }
+
+        /// A request for a thread that has already been interrupted once and
+        /// has taken the new generation as its own.
+        fn request_expecting(
+            words: &Words,
+            fds: &mut [HostPollFd],
+            deadline: Option<Instant>,
+            interrupt_expected: u32,
+        ) -> HostPollFdWait {
+            HostPollFdWait {
+                fd_count: fds.len(),
+                fds: fds.as_mut_ptr(),
+                interrupt: (&raw const words.interrupt).cast(),
+                interrupt_expected,
+                gate: (&raw const words.gate).cast(),
+                gate_expected: 0,
+                deadline,
+            }
+        }
+
+        fn read_fd(fd: RawFd) -> HostPollFd {
+            HostPollFd {
+                fd,
+                events: HOST_POLL_READ,
+                revents: 0,
+                nbytes: 0,
+            }
+        }
+
+        fn enable() {
+            SUPPORT.store(SUPPORTED, Ordering::Release);
+        }
+
+        /// A connected pair with nothing to read: the wait ends at the
+        /// deadline it was given and reports the timeout, which is what turns
+        /// into the guest's clock event.
+        #[test]
+        fn a_wait_with_nothing_ready_ends_at_its_deadline() {
+            enable();
+            let (a, _b) = std::os::unix::net::UnixStream::pair().unwrap();
+            let mut fds = [read_fd(a.as_raw_fd())];
+            let words = Words::new();
+            let started = Instant::now();
+            let result = wait(request(
+                &words,
+                &mut fds,
+                Some(started + Duration::from_millis(120)),
+            ));
+            assert_eq!(result, HostPollFdResult::TimedOut);
+            assert!(started.elapsed() >= Duration::from_millis(100));
+        }
+
+        /// A deadline that has already passed asks what is ready now: the
+        /// poll still runs, so readiness already there is reported rather
+        /// than slept through, and it never blocks. This is what a guest's
+        /// non-blocking wait becomes.
+        #[test]
+        fn an_elapsed_deadline_reports_what_is_ready_without_blocking() {
+            enable();
+            let (quiet, _quiet_peer) = std::os::unix::net::UnixStream::pair().unwrap();
+            let (loud, mut loud_peer) = std::os::unix::net::UnixStream::pair().unwrap();
+            loud_peer.write_all(b"x").unwrap();
+            let words = Words::new();
+
+            let mut fds = [read_fd(loud.as_raw_fd())];
+            let started = Instant::now();
+            let result = wait(request(&words, &mut fds, Some(started)));
+            assert_eq!(result, HostPollFdResult::Ready);
+            assert_eq!(fds[0].revents & HOST_POLL_READ, HOST_POLL_READ);
+
+            let mut fds = [read_fd(quiet.as_raw_fd())];
+            let result = wait(request(&words, &mut fds, Some(Instant::now())));
+            assert_eq!(result, HostPollFdResult::TimedOut);
+            assert!(started.elapsed() < Duration::from_millis(100));
+            drop(loud_peer);
+        }
+
+        /// Data on the descriptor ends the wait, and the descriptor carries
+        /// the events the kernel reported.
+        #[test]
+        fn a_ready_descriptor_ends_the_wait() {
+            enable();
+            let (a, mut b) = std::os::unix::net::UnixStream::pair().unwrap();
+            let mut fds = [read_fd(a.as_raw_fd())];
+            let words = Words::new();
