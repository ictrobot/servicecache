+type ModuleCompilerCallback = dyn Fn(&Engine, &[u8], Option<CompilationProgressCallback>) -> Result<Module, wasmer::CompileError>
+    + Send
+    + Sync;
+
+/// A runtime hook that compiles a module after a module-cache miss.
+///
+/// The hook is synchronous, like Wasmer's built-in compilation path. A host
+/// can use it to choose where compilation runs, for example on a disposable
+/// thread pool that will not outlive the compilation.
+#[derive(Clone)]
+pub struct ModuleCompiler {
+    callback: Arc<ModuleCompilerCallback>,
+}
+
+impl ModuleCompiler {
+    pub fn new(
+        callback: impl Fn(
+            &Engine,
+            &[u8],
+            Option<CompilationProgressCallback>,
+        ) -> Result<Module, wasmer::CompileError>
+        + Send
+        + Sync
+        + 'static,
+    ) -> Self {
+        Self {
+            callback: Arc::new(callback),
+        }
+    }
+
+    fn compile(
+        &self,
+        engine: &Engine,
+        wasm: &[u8],
+        progress: Option<CompilationProgressCallback>,
+    ) -> Result<Module, wasmer::CompileError> {
+        (self.callback)(engine, wasm, progress)
+    }
+}
+
+impl fmt::Debug for ModuleCompiler {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("ModuleCompiler(..)")
+    }
+}
