+    #[test]
+    fn module_compiler_is_used_once_then_the_cache_wins() {
+        let engine = wasmer::Engine::default();
+        let cache = SharedCache::new();
+        let calls = Arc::new(AtomicUsize::new(0));
+        let called = calls.clone();
+        let compiler = ModuleCompiler::new(move |engine, wasm, _progress| {
+            called.fetch_add(1, Ordering::SeqCst);
+            wasmer::Module::new(engine, wasm)
+        });
+        let wasm = b"(module (func (export \"run\")))";
+
+        for _ in 0..2 {
+            virtual_mio::block_on(load_module_with_compiler(
+                &engine,
+                &cache,
+                ModuleInput::Bytes(wasm.as_slice().into()),
+                None,
+                Some(&compiler),
+            ))
+            .unwrap();
+        }
+
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+    }
