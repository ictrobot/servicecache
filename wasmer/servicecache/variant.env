# The runtime the ServiceCache host embeds: the pinned tag plus the fixes
# set, every extension's patch set, the jitdump set and the servicecache
# set. Patch sets apply in the order listed.
WASMER_PATCH_SETS="wasmer/fixes/patches extensions/ictrobot_shm_v1/patches wasmer/jitdump/patches wasmer/servicecache/patches"
