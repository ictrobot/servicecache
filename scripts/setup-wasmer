#!/usr/bin/env bash
set -euo pipefail

# setup-wasmer: check the pinned Wasmer tag out into work/wasmer and apply
# the patch series from patches/wasmer, idempotently. The workspace builds
# the host against the Wasmer crates from that tree ([patch.crates-io] in
# Cargo.toml). The Wasmer CLI under work/toolchains, which builds and
# smoke-tests the guests, is a separate stock installation.

root="$(cd "$(dirname "$0")/.." && pwd)"
source "$root/toolchain/lib.sh"
source "$root/toolchain/versions.sh"

: "${SC_SOURCE_URL:=https://github.com/wasmerio/wasmer.git}"
export SC_SOURCE_URL

sc_clone_tag "v$WASMER_VERSION" "$root/work/wasmer"
sc_apply_series "$root/patches/wasmer" "$root/work/wasmer"
