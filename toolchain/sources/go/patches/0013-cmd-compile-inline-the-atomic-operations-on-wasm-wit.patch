+		{name: "I64AtomicRmw32AndU", asm: "I64AtomicRmw32AndU", argLength: 3, reg: gprmw, typ: "(UInt32,Mem)", faultOnNilArg0: true, hasSideEffects: true},         // *arg0 &= low 32 bits of arg1, arg2=mem, returns the old value and mem
+		{name: "I64AtomicRmwAnd", asm: "I64AtomicRmwAnd", argLength: 3, reg: gprmw, typ: "(UInt64,Mem)", faultOnNilArg0: true, hasSideEffects: true},               // *arg0 &= arg1, arg2=mem, returns the old value and mem
+		{name: "I64AtomicRmw8OrU", asm: "I64AtomicRmw8OrU", argLength: 3, reg: gprmw, typ: "(UInt8,Mem)", faultOnNilArg0: true, hasSideEffects: true},              // *arg0 |= low 8 bits of arg1, arg2=mem, returns the old value and mem
+		{name: "I64AtomicRmw32OrU", asm: "I64AtomicRmw32OrU", argLength: 3, reg: gprmw, typ: "(UInt32,Mem)", faultOnNilArg0: true, hasSideEffects: true},           // *arg0 |= low 32 bits of arg1, arg2=mem, returns the old value and mem
+		{name: "I64AtomicRmwOr", asm: "I64AtomicRmwOr", argLength: 3, reg: gprmw, typ: "(UInt64,Mem)", faultOnNilArg0: true, hasSideEffects: true},                 // *arg0 |= arg1, arg2=mem, returns the old value and mem
+		{name: "I64AtomicRmw32CmpxchgU", asm: "I64AtomicRmw32CmpxchgU", argLength: 4, reg: gpcas, typ: "(UInt32,Mem)", faultOnNilArg0: true, hasSideEffects: true}, // if the low 32 bits of *arg0 == arg1, store the low 32 bits of arg2; arg3=mem, returns the old value and mem
+		{name: "I64AtomicRmwCmpxchg", asm: "I64AtomicRmwCmpxchg", argLength: 4, reg: gpcas, typ: "(UInt64,Mem)", faultOnNilArg0: true, hasSideEffects: true},       // if *arg0 == arg1, store arg2; arg3=mem, returns the old value and mem
