+		{name: "I64AtomicRmw32AddU", asm: "I64AtomicRmw32AddU", argLength: 3, reg: gprmw, typ: "(UInt32,Mem)", faultOnNilArg0: true, hasSideEffects: true},         // *arg0 += low 32 bits of arg1, arg2=mem, returns the old value and mem
