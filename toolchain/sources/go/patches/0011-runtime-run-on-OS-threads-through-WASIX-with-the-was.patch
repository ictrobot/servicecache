+++ b/src/runtime/wasix_off.go
@@ -0,0 +1,11 @@
+//go:build !(wasip1 && wasix && wasm.threads)
+
+package runtime
+
+// wasixThreads is whether a wasm program runs on OS threads through
+// WASIX, which only the wasip1 port with the wasix build tag and
+// GOWASM=threads does; the scheduler's wasm special cases ask it.
+const (
+	wasixThreads    = false
+	wasixThreadsInt = 0 // wasixThreads as an integer, for sizes
+)
