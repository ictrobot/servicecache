diff --git a/src/runtime/os_wasix.go b/src/runtime/os_wasix.go
new file mode 100644
index 0000000..75c3501
--- /dev/null
+++ b/src/runtime/os_wasix.go
@@ -0,0 +1,155 @@
+//go:build wasip1 && wasix && wasm.threads
+
+package runtime
+
+import (
+	"internal/runtime/atomic"
+	"unsafe"
+)
+
+// With the wasix tag and GOWASM=threads the program runs on OS threads.
+// newosproc spawns a WASIX thread, which the runtime runs as another
+// instance of the module over the same memory, entering wasi_thread_start
+// (rt0_wasix_wasm.s); the runtime's locks sleep on WASIX futexes; and the
+// poller has a descriptor another thread can wake it through.
+const (
+	wasixThreads    = true
+	wasixThreadsInt = 1 // wasixThreads as an integer, for sizes
+)
+
+// wasmInitMemoryFlag is the word the module's start function swaps from
+// 0 to 1 when it places the data segments in the shared memory: the main
+// instance does the placing, and the instances that are threads find the
+// flag set. It must start zero and never be reused, which a variable in
+// BSS is.
+var wasmInitMemoryFlag uint32
+
+//go:wasmimport wasix_32v1 thread_spawn_v2
+//go:noescape
+func thread_spawn_v2(start unsafe.Pointer, tid unsafe.Pointer) errno
+
+//go:wasmimport wasix_32v1 futex_wait
+//go:noescape
+func futex_wait(addr unsafe.Pointer, expected uint32, timeout unsafe.Pointer, woken unsafe.Pointer) errno
+
+//go:wasmimport wasix_32v1 futex_wake
+//go:noescape
+func futex_wake(addr unsafe.Pointer, woken unsafe.Pointer) errno
+
+//go:wasmimport wasix_32v1 futex_wake_all
+//go:noescape
+func futex_wake_all(addr unsafe.Pointer, woken unsafe.Pointer) errno
+
+//go:wasmimport wasix_32v1 thread_parallelism
+//go:noescape
+func thread_parallelism(count unsafe.Pointer) errno
+
+//go:wasmimport wasi_snapshot_preview1 sched_yield
+func sched_yield() errno
+
+//go:wasmimport wasix_32v1 thread_exit
+func thread_exit(code int32)
+
+//go:wasmimport wasix_32v1 thread_id
+//go:noescape
+func thread_id(tid unsafe.Pointer) errno
+
+// minit records the thread's WASIX thread id as the M's procid, as the
+// other ports record their thread ids.
+func minit() {
+	var tid uint32
+	if thread_id(unsafe.Pointer(&tid)) == 0 {
+		getg().m.procid = uint64(tid)
+	}
+}
+
+// getCPUCount is the parallelism the runtime offers, which is what
+// wasix-libc's sysconf(_SC_NPROCESSORS_ONLN) reports too; GOMAXPROCS in
+// the environment overrides it. One when the runtime cannot say.
+func getCPUCount() int32 {
+	var count uint32
+	if thread_parallelism(unsafe.Pointer(&count)) != 0 || count == 0 || count > 1<<16 {
+		return 1
+	}
+	return int32(count)
+}
+
+//go:nosplit
+func osyield() {
+	sched_yield()
+}
+
+// exitThread ends the calling thread once it has stored 0 in *wait, as
+// mexit asks; it is in rt0_wasix_wasm.s, since the store frees the M's
+// g0 stack, and then the M, and the thread must touch neither
+// afterwards. The runtime frees nothing else of the thread's but its own
+// handle.
+func exitThread(wait *atomic.Uint32)
+
+// wasixThreadStart is WASIX's thread_start block: what thread_spawn
+// reads, and what the new thread's wasi_thread_start is given.
+type wasixThreadStart struct {
+	stackUpper uint32
+	tlsBase    uint32
+	startFunct uint32
+	startArgs  uint32
+	reserved   [10]uint32
+	stackSize  uint32
+	guardSize  uint32
+}
+
+// wasixOptionTimestamp is WASIX's option_timestamp: a tag, padding to
+// the alignment of the value, and the value in nanoseconds.
+type wasixOptionTimestamp struct {
+	tag uint8
+	_   [7]uint8
+	ns  uint64
+}
+
+// newosproc starts an OS thread for mp, on mp's g0 stack. The start
+// block outlives this call: the runtime reads it when it spawns the
+// thread and the thread reads it on entry, so it is never freed.
+//
+// May run with m.p==nil, so write barriers are not allowed.
+//
+//go:nowritebarrier
+func newosproc(mp *m) {
+	start := (*wasixThreadStart)(persistentalloc(unsafe.Sizeof(wasixThreadStart{}), 8, &memstats.other_sys))
+	start.stackUpper = uint32(mp.g0.stack.hi)
+	start.stackSize = uint32(mp.g0.stack.hi - mp.g0.stack.lo)
+	// The runtime enters the module's wasi_thread_start export, not a
+	// function this names; the linker keeps that export.
+	start.startArgs = uint32(uintptr(unsafe.Pointer(mp)))
+	var tid uint32
+	if e := thread_spawn_v2(unsafe.Pointer(start), unsafe.Pointer(&tid)); e != 0 {
+		print("runtime: thread_spawn failed with errno ", e, "\n")
+		throw("newosproc")
+	}
+}
+
+// futexsleep waits while *addr == val, for at most ns nanoseconds when ns
+// is not negative.
+//
+//go:nosplit
+func futexsleep(addr *uint32, val uint32, ns int64) {
+	var timeout wasixOptionTimestamp
+	if ns >= 0 {
+		timeout.tag = 1
+		timeout.ns = uint64(ns)
+	}
+	var woken uint8
+	futex_wait(unsafe.Pointer(addr), val, unsafe.Pointer(&timeout), unsafe.Pointer(&woken))
+}
+
+// futexwakeup wakes cnt threads waiting on addr; every waiter when cnt is
+// more than one, since WASIX wakes one or all.
+//
+//go:nosplit
+func futexwakeup(addr *uint32, cnt uint32) {
+	var woken uint8
+	if cnt == 1 {
+		futex_wake(unsafe.Pointer(addr), unsafe.Pointer(&woken))
+		return
+	}
+	futex_wake_all(unsafe.Pointer(addr), unsafe.Pointer(&woken))
+}
