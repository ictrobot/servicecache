+
+//go:build wasm && !(wasip1 && wasix && wasm.threads)
+
+package runtime
+
+import "internal/runtime/atomic"
+
+// Without the wasix tag and GOWASM=threads together the program runs on
+// one thread: there is no way to start another, and none to yield to or
+// exit; the bodies in sys_wasm_nothreads.s are unreachable.
+
+// FIXME: wasm doesn't have atomic yet
+func exitThread(wait *atomic.Uint32)
+
+func osyield()
+
+// May run with m.p==nil, so write barriers are not allowed.
+//
+//go:nowritebarrier
+func newosproc(mp *m) {
+	throw("newosproc: not implemented")
+}
+
+func getCPUCount() int32 {
+	return 1
+}
+
+// Called to initialize a new m (including the bootstrap m).
+// Called on the new thread, cannot allocate memory.
+func minit() {
+}
