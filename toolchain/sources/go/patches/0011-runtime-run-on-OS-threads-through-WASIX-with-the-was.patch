@@ -0,0 +1,24 @@
+// Copyright 2018 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build wasm && !(wasip1 && wasix && wasm.threads)
+
+#include "go_asm.h"
+#include "textflag.h"
+
+// On one thread there is no other thread to yield to or to exit.
+
+TEXT runtime·exitThread(SB), NOSPLIT, $0-0
+	UNDEF
+
+TEXT runtime·osyield(SB), NOSPLIT, $0-0
+	UNDEF
+
+// One thread has nothing to yield to within a spin.
+TEXT runtime·procyieldAsm(SB), NOSPLIT, $0-0
+	RET
+
+// One thread publishes to no other.
+TEXT runtime·publicationBarrier(SB), NOSPLIT, $0-0
+	RET
