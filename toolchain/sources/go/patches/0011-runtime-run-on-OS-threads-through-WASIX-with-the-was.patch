diff --git a/src/runtime/rt0_wasix_wasm.s b/src/runtime/rt0_wasix_wasm.s
new file mode 100644
index 0000000..79c1b1d
--- /dev/null
+++ b/src/runtime/rt0_wasix_wasm.s
@@ -0,0 +1,93 @@
+//go:build wasip1 && wasix && wasm.threads
+
+#include "go_asm.h"
+#include "textflag.h"
+
+// wasi_thread_start is the entry of a new thread, called by the runtime
+// on the thread's own instance of the module with the thread id and the
+// address of the start block newosproc filled in: the top of the M's g0
+// stack and, as the argument, the M. It runs on that stack as that M's
+// g0, the way _rt0_wasm_wasip1 runs on m0's, and never returns while the
+// program runs.
+TEXT wasi_thread_start(SB),NOSPLIT,$0
+	// SP = the block's stack_upper, less the words rt0 leaves too.
+	Get R1
+	I32Load $0
+	I32Const $16
+	I32Sub
+	Set SP
+
+	// g = mp.g0, mp being the block's start_args.
+	Get R1
+	I32Load $12
+	I64Load $m_g0
+	Set g
+
+	I32Const $0 // entry PC_B
+	Call runtime·mstart(SB)
+	Drop
+	Call wasm_pc_f_loop(SB)
+
+	Return
+
+// func procyieldAsm(cycles uint32)
+//
+// The pause a spin loop takes between its attempts, as other ports spend
+// a PAUSE instruction: one atomic fence per cycle, tens of cycles each,
+// so that the thread holding the lock has time to release it before the
+// spinner gives up and sleeps in a futex, which is a call into the
+// runtime here.
+TEXT runtime·procyieldAsm(SB), NOSPLIT, $0-4
+	I32Load cycles+0(FP)
+	I64ExtendI32U
+	Set R0
+loop:
+	Loop
+		AtomicFence
+		Get R0
+		I64Const $1
+		I64Sub
+		Set R0
+		Get R0
+		I64Eqz
+		I32Eqz
+		BrIf loop
+	End
+	RET
+
+// publicationBarrier orders the stores that initialize an object before
+// the store that publishes it, which mallocgc requires on a machine with
+// weak memory ordering. The fence is the one barrier wasm has.
+TEXT runtime·publicationBarrier(SB), NOSPLIT, $0-0
+	AtomicFence
+	RET
+
+// The stack exitThread runs on once it has freed its M's g0 stack: the
+// call that ends the thread writes its argument at SP and its return
+// address below SP. Every exiting thread writes the same two words, so
+// one area serves them all.
+GLOBL runtime·exitStack(SB), NOPTR, $64
+
+// func exitThread(wait *atomic.Uint32)
+//
+// Storing 0 to *wait lets another thread free and reuse this M's g0
+// stack at once, and the M itself once nothing refers to it, so the
+// store and the call that follows run on the static exit stack.
+TEXT runtime·exitThread(SB), NOSPLIT|NOFRAME, $0-8
+	I64Load wait+0(FP)
+	Set R0
+	MOVD $runtime·exitStack(SB), R1
+	Get R1
+	I32WrapI64
+	I32Const $56 // the argument takes the area's last 8 bytes
+	I32Add
+	Set SP
+	Get R0
+	I32WrapI64
+	I32Const $0
+	I32AtomicStore $0
+	Get SP
+	I32Const $0
+	I32Store $0
+	CALLNORESUME runtime·thread_exit(SB)
+	UNDEF
