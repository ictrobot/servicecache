+// initMemoryCode is the body of the start function of a module with
+// shared memory: the first instance to swap the runtime's flag from 0 to
+// 1 copies every passive data segment into place; the instances that are
+// threads, created later, find the flag set and do nothing.
+func initMemoryCode(flag int32, segments []*dataSegment) []byte {
+	w := new(bytes.Buffer)
+	writeUleb128(w, 0) // number of sets of locals
+	writeI32Const(w, flag)
+	writeI32Const(w, 0)
+	writeI32Const(w, 1)
+	w.Write([]byte{0xFE, 0x48, 0x02, 0x00}) // i32.atomic.rmw.cmpxchg, 4-byte aligned, offset 0
+	w.WriteByte(0x45)                       // i32.eqz
+	w.Write([]byte{0x04, 0x40})             // if, no result
+	for i, seg := range segments {
+		writeI32Const(w, seg.offset)           // destination
+		writeI32Const(w, 0)                    // offset within the segment
+		writeI32Const(w, int32(len(seg.data))) // length
+		w.Write([]byte{0xFC, 0x08})            // memory.init
+		writeUleb128(w, uint64(i))             // segment
+		w.WriteByte(0x00)                      // memory
+	}
+	w.WriteByte(0x0b) // end if
+	w.WriteByte(0x0b) // end
+	return w.Bytes()
+}
