diff --git a/src/syscall/syscall_wasip1_nothreads.go b/src/syscall/syscall_wasip1_nothreads.go
new file mode 100644
index 0000000..5301075
--- /dev/null
+++ b/src/syscall/syscall_wasip1_nothreads.go
@@ -0,0 +1,10 @@
+//go:build wasip1 && !(wasix && wasm.threads)
+
+package syscall
+
+// On one thread there is no other thread to hand a P to, so the host
+// calls are made bare.
+
+func runtime_entersyscall() {}
+
+func runtime_exitsyscall() {}
diff --git a/src/syscall/syscall_wasix_threads.go b/src/syscall/syscall_wasix_threads.go
new file mode 100644
index 0000000..148e0c6
--- /dev/null
+++ b/src/syscall/syscall_wasix_threads.go
@@ -0,0 +1,17 @@
+//go:build wasip1 && wasix && wasm.threads
+
+package syscall
+
+import _ "unsafe" // for go:linkname
+
+// With OS threads a host call that waits must not hold its P: the calls
+// that can wait are bracketed by the runtime's entersyscall and
+// exitsyscall, as system calls are on Linux, so that the scheduler can
+// hand the P to another thread and a stop-the-world can take it without
+// waiting for the call to return.
+
+//go:linkname runtime_entersyscall runtime.entersyscall
+func runtime_entersyscall()
+
+//go:linkname runtime_exitsyscall runtime.exitsyscall
+func runtime_exitsyscall()
