diff --git a/src/cmd/internal/obj/wasm/wasmobj.go b/src/cmd/internal/obj/wasm/wasmobj.go
index 9b940d3..af1f78b 100644
--- a/src/cmd/internal/obj/wasm/wasmobj.go
+++ b/src/cmd/internal/obj/wasm/wasmobj.go
@@ -1030,6 +1030,7 @@ var notUsePC_B = map[string]bool{
 	"_rt0_wasm_js":            true,
 	"_rt0_wasm_wasip1":        true,
 	"_rt0_wasm_wasip1_lib":    true,
+	"wasi_thread_start":       true,
 	"wasm_export_run":         true,
 	"wasm_export_resume":      true,
 	"wasm_export_getsp":       true,
@@ -1086,7 +1087,7 @@ func assemble(ctxt *obj.Link, s *obj.LSym, newprog obj.ProgAlloc) {
 	// Function starts with declaration of locals: numbers and types.
 	// Some functions use a special calling convention.
 	switch s.Name {
-	case "_rt0_wasm_js", "_rt0_wasm_wasip1", "_rt0_wasm_wasip1_lib",
+	case "_rt0_wasm_js", "_rt0_wasm_wasip1", "_rt0_wasm_wasip1_lib", "wasi_thread_start",
 		"wasm_export_run", "wasm_export_resume", "wasm_export_getsp",
 		"wasm_pc_f_loop", "runtime.wasmDiv", "runtime.wasmTruncS", "runtime.wasmTruncU", "memeqbody":
 		varDecls = []*varDecl{}
@@ -1362,6 +1363,19 @@ func assemble(ctxt *obj.Link, s *obj.LSym, newprog obj.ProgAlloc) {
 			w.WriteByte(0x00)
 			w.WriteByte(0x00)
 
+		case AAtomicFence:
+			w.WriteByte(0x00)
+
+		default:
+			if p.As >= AAtomicNotify && p.As < ALast {
+				// An atomic memory instruction: the natural alignment
+				// of its access and the constant offset it was given.
+				if p.From.Type != obj.TYPE_CONST || p.From.Offset < 0 || p.From.Offset > math.MaxUint32 {
+					ctxt.Diag("bad offset in %v", p)
+				}
+				writeUleb128(w, atomicAlign(p.As))
+				writeUleb128(w, uint64(p.From.Offset))
+			}
 		}
 	}
 
@@ -1370,6 +1384,21 @@ func assemble(ctxt *obj.Link, s *obj.LSym, newprog obj.ProgAlloc) {
 	s.P = w.Bytes()
 }
 
+// atomicAlign is the log2 of the access width of an atomic memory
+// instruction, which the threads proposal requires as its alignment.
+func atomicAlign(as obj.As) uint64 {
+	switch as {
+	case AAtomicNotify, AI32AtomicWait:
+		return 2
+	case AI64AtomicWait:
+		return 3
+	}
+	// From the loads on, each group of seven instructions is the i32 and
+	// i64 forms, then the 8- and 16-bit i32 forms and the 8-, 16- and
+	// 32-bit i64 forms.
+	return [7]uint64{2, 3, 0, 1, 0, 1, 2}[(as-AI32AtomicLoad)%7]
+}
+
 func updateLocalSP(w *bytes.Buffer) {
 	writeOpcode(w, AGlobalGet)
 	writeUleb128(w, 0) // global SP
@@ -1391,9 +1420,12 @@ func writeOpcode(w *bytes.Buffer, as obj.As) {
 		w.WriteByte(byte(as - ALocalGet + 0x20))
 	case as < AI32TruncSatF32S:
 		w.WriteByte(byte(as - AI32Load + 0x28))
-	case as < ALast:
+	case as < AAtomicNotify:
 		w.WriteByte(0xFC)
 		w.WriteByte(byte(as - AI32TruncSatF32S + 0x00))
+	case as < ALast:
+		w.WriteByte(0xFE)
+		w.WriteByte(byte(as - AAtomicNotify + 0x00))
 	default:
 		panic(fmt.Sprintf("unexpected assembler op: %s", as))
 	}
