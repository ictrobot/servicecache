+++ b/src/cmd/internal/obj/wasm/a.out.go
@@ -241,6 +241,90 @@ const (
 	ATableSize
 	ATableFill
 
+	// The threads proposal's atomic instructions, prefix 0xFE. The
+	// numbering has a gap between the fence and the loads, which the
+	// unused names keep so that the opcode is the distance from
+	// AAtomicNotify.
+	AAtomicNotify // opcode 0xFE 0x00
+	AI32AtomicWait
+	AI64AtomicWait
+	AAtomicFence
+	AAtomicUnused04
+	AAtomicUnused05
+	AAtomicUnused06
+	AAtomicUnused07
+	AAtomicUnused08
+	AAtomicUnused09
+	AAtomicUnused0A
+	AAtomicUnused0B
