+// Copyright 2018 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Sockets on the fake network for js/wasm and wasip1/wasm; wasip1 with
+// the wasix build tag has real ones in socket_wasix.go.
+
+//go:build (js || wasip1) && !wasix
+
+package net
+
+import (
+	"context"
+	"os"
+	"syscall"
+)
+
+// socket returns a network file descriptor that is ready for
+// I/O using the fake network.
+func socket(ctx context.Context, net string, family, sotype, proto int, ipv6only bool, laddr, raddr sockaddr, ctrlCtxFn func(context.Context, string, string, syscall.RawConn) error) (*netFD, error) {
+	if raddr != nil && ctrlCtxFn != nil {
+		return nil, os.NewSyscallError("socket", syscall.ENOTSUP)
+	}
+	switch sotype {
+	case syscall.SOCK_STREAM, syscall.SOCK_SEQPACKET, syscall.SOCK_DGRAM:
+	default:
+		return nil, os.NewSyscallError("socket", syscall.ENOTSUP)
+	}
+
+	fd := &netFD{
+		family: family,
+		sotype: sotype,
+		net:    net,
+	}
+	fd.fakeNetFD = newFakeNetFD(fd)
+
+	if raddr == nil {
+		if err := fakeListen(fd, laddr); err != nil {
+			fd.Close()
+			return nil, err
+		}
+		return fd, nil
+	}
+
+	if err := fakeConnect(ctx, fd, laddr, raddr); err != nil {
+		fd.Close()
+		return nil, err
+	}
+	return fd, nil
+}
+
+func sysSocket(family, sotype, proto int) (int, error) {
+	return 0, os.NewSyscallError("sysSocket", syscall.ENOSYS)
+}
diff --git a/src/net/socket_wasix.go b/src/net/socket_wasix.go
new file mode 100644
index 0000000..f51baf5
--- /dev/null
+++ b/src/net/socket_wasix.go
@@ -0,0 +1,376 @@
+//go:build wasip1 && wasix
+
+package net
+
+import (
+	"context"
+	"os"
+	"runtime"
+	"syscall"
+)
+
+// Sockets over the WASIX extension: a listen binds and listens a socket
+// the runtime opens, a dial connects one, and the descriptor is then
+// served by the same non-blocking reads, writes and poll_oneoff waits
+// an inherited socket gets on wasip1.
+
+func sysSocket(family, sotype, proto int) (int, error) {
+	s, err := syscall.Socket(family, sotype, proto)
+	if err != nil {
+		return -1, os.NewSyscallError("socket", err)
+	}
+	if err = syscall.SetNonblock(s, true); err != nil {
+		syscall.Close(s)
+		return -1, os.NewSyscallError("setnonblock", err)
+	}
+	return s, nil
+}
+
+// wasixAddr is the Addr for a socket address on the given network.
+func wasixAddr(net string, sa syscall.Sockaddr) Addr {
+	if sa == nil {
+		return nil
+	}
+	switch net[:3] {
+	case "tcp":
+		return sockaddrToTCP(sa)
+	case "udp":
+		return sockaddrToUDP(sa)
+	}
+	return nil
+}
+
+// socket returns a network file descriptor that is ready for
+// I/O: listening on laddr when raddr is nil, connected to raddr
+// otherwise.
+func socket(ctx context.Context, net string, family, sotype, proto int, ipv6only bool, laddr, raddr sockaddr, ctrlCtxFn func(context.Context, string, string, syscall.RawConn) error) (*netFD, error) {
+	s, err := sysSocket(family, sotype, proto)
+	if err != nil {
+		return nil, err
+	}
+	if err := setDefaultSockopts(s, family, sotype, ipv6only); err != nil {
+		syscall.Close(s)
+		return nil, err
+	}
+	fd := newFD(net, s)
+	fd.family = family
+	fd.sotype = sotype
+	fd.pfd.IsStream = sotype == syscall.SOCK_STREAM
+	fd.pfd.ZeroReadIsEOF = sotype != syscall.SOCK_DGRAM && sotype != syscall.SOCK_RAW
+
+	// A Control function runs against the socket before it is bound or
+	// connected, after the defaults, as on the Unix ports.
+	control := func() error {
+		if ctrlCtxFn == nil {
+			return nil
+		}
+		addr := raddr
+		if raddr == nil {
+			addr = laddr
+		}
+		var address string
+		if addr != nil {
+			address = addr.String()
+		}
+		return ctrlCtxFn(ctx, fd.ctrlNetwork(), address, newRawConn(fd))
+	}
+
+	if laddr != nil {
+		lsa, err := laddr.sockaddr(family)
+		if err != nil {
+			fd.Close()
+			return nil, err
+		}
+		if raddr == nil && sotype == syscall.SOCK_STREAM {
+			// A listener reuses an address whose earlier connections are
+			// still closing, so a restarted server binds at once.
+			if err := setDefaultListenerSockopts(s); err != nil {
+				fd.Close()
+				return nil, err
+			}
+		}
+		if err := control(); err != nil {
+			fd.Close()
+			return nil, err
+		}
+		if lsa != nil {
+			if err := syscall.Bind(s, lsa); err != nil {
+				fd.Close()
+				return nil, os.NewSyscallError("bind", err)
+			}
+		}
+	}
+	if raddr == nil {
+		if sotype == syscall.SOCK_STREAM {
+			if err := syscall.Listen(s, listenerBacklog()); err != nil {
+				fd.Close()
+				return nil, os.NewSyscallError("listen", err)
+			}
+		}
+		if err := fd.init(); err != nil {
+			fd.Close()
+			return nil, err
+		}
+		local := Addr(laddr)
+		if lsa, err := syscall.Getsockname(s); err == nil {
+			if a := wasixAddr(net, lsa); a != nil {
+				local = a
+			}
+		}
+		fd.setAddr(local, nil)
+		return fd, nil
+	}
+
+	rsa, err := raddr.sockaddr(family)
+	if err != nil {
+		fd.Close()
+		return nil, err
+	}
+	if laddr == nil {
+		if err := control(); err != nil {
+			fd.Close()
+			return nil, err
+		}
+	}
+	if sotype == syscall.SOCK_DGRAM {
+		// A datagram socket connects at once, so it is connected before
+		// the poller registers it, as on the Unix ports: a registration
+		// need not survive the connect.
+		if err := syscall.Connect(s, rsa); err != nil {
+			fd.Close()
+			return nil, os.NewSyscallError("connect", err)
+		}
+		select {
+		case <-ctx.Done():
+			fd.Close()
+			return nil, mapErr(ctx.Err())
+		default:
+		}
+		if err := fd.init(); err != nil {
+			fd.Close()
+			return nil, err
+		}
+	} else {
+		if err := fd.init(); err != nil {
+			fd.Close()
+			return nil, err
+		}
+		if err := fd.wasixConnect(ctx, s, rsa); err != nil {
+			fd.Close()
+			return nil, err
+		}
+	}
+	fd.isConnected = true
+	local, remote := Addr(laddr), Addr(raddr)
+	if lsa, err := syscall.Getsockname(s); err == nil {
+		if a := wasixAddr(net, lsa); a != nil {
+			local = a
+		}
+	}
+	if psa, err := syscall.Getpeername(s); err == nil {
+		if a := wasixAddr(net, psa); a != nil {
+			remote = a
+		}
+	}
+	fd.setAddr(local, remote)
+	return fd, nil
+}
+
+// ctrlNetwork is the network a Control function is told, with the address
+// family made explicit as the Unix ports do.
+func (fd *netFD) ctrlNetwork() string {
+	switch fd.net[len(fd.net)-1] {
+	case '4', '6':
+		return fd.net
+	}
+	if fd.family == syscall.AF_INET {
+		return fd.net + "4"
+	}
+	return fd.net + "6"
+}
+
+// wasixConnect connects the non-blocking socket, waiting for the
+// connection to complete for as long as the context allows.
+func (fd *netFD) wasixConnect(ctx context.Context, s int, rsa syscall.Sockaddr) (ret error) {
+	if deadline, ok := ctx.Deadline(); ok {
+		fd.pfd.SetWriteDeadline(deadline)
+		defer fd.pfd.SetWriteDeadline(noDeadline)
+	}
+	if ctx.Done() != nil {
+		// A cancellation ends the wait below by expiring the write
+		// deadline, as the Unix ports do. A connect that completed just
+		// before is not returned either, since its deadline is expired
+		// all the same; the caller closes the socket on an error.
+		stop := context.AfterFunc(ctx, func() {
+			fd.pfd.SetWriteDeadline(aLongTimeAgo)
+		})
+		defer func() {
+			if !stop() && ret == nil {
+				ret = mapErr(ctx.Err())
+			}
+		}()
+	}
+	err := syscall.Connect(s, rsa)
+	for {
+		switch err {
+		case nil, syscall.EISCONN:
+			return nil
+		case syscall.EINPROGRESS, syscall.EALREADY, syscall.EINTR, syscall.EAGAIN:
+		default:
+			return os.NewSyscallError("connect", err)
+		}
+		if err := fd.pfd.WaitWrite(); err != nil {
+			select {
+			case <-ctx.Done():
+				return mapErr(ctx.Err())
+			default:
+			}
+			return err
+		}
+		nerr, gerr := syscall.GetsockoptInt(s, syscall.SOL_SOCKET, syscall.SO_ERROR)
+		if gerr != nil {
+			return os.NewSyscallError("getsockopt", gerr)
+		}
+		err = syscall.Errno(nerr)
+		if nerr == 0 {
+			// The poller can report the socket writable before it is
+			// connected; a peer address says that it is, as on the
+			// Unix ports.
+			if _, perr := syscall.Getpeername(s); perr == nil {
+				return nil
+			}
+			err = syscall.EINPROGRESS
+		}
+	}
+}
+
+func wasixBoolint(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+// The names the datagram and message calls report in errors.
+const (
+	readFromSyscallName = "sock_recv_from"
+	readMsgSyscallName  = "recvmsg"
+	writeToSyscallName  = "sock_send_to"
+	writeMsgSyscallName = "sendmsg"
+)
+
+// The datagram methods below shadow the fake network's, which netFD would
+// otherwise take from its embedded fakeNetFD, nil on a WASIX socket.
+
+func (fd *netFD) readFrom(p []byte) (n int, sa syscall.Sockaddr, err error) {
+	n, sa, err = fd.pfd.ReadFrom(p)
+	runtime.KeepAlive(fd)
+	return n, sa, wrapSyscallError(readFromSyscallName, err)
+}
+
+// The address-typed variants go through the generic calls: WASIX has one
+// receive and one send call, which answer every address family. A sender
+// of the socket's family is copied; an IPv4 sender to an IPv6 socket is
+// reported mapped, as the kernels report it; any other is an error, not
+// a zero address.
+
+func sockaddrInto4(sa syscall.Sockaddr, into *syscall.SockaddrInet4) error {
+	if sa, ok := sa.(*syscall.SockaddrInet4); ok {
+		*into = *sa
+		return nil
+	}
+	return wrapSyscallError(readFromSyscallName, syscall.EAFNOSUPPORT)
+}
+
+func sockaddrInto6(sa syscall.Sockaddr, into *syscall.SockaddrInet6) error {
+	switch sa := sa.(type) {
+	case *syscall.SockaddrInet6:
+		*into = *sa
+	case *syscall.SockaddrInet4:
+		*into = syscall.SockaddrInet6{Port: sa.Port, Addr: [16]byte{10: 0xff, 11: 0xff}}
+		copy(into.Addr[12:], sa.Addr[:])
+	default:
+		return wrapSyscallError(readFromSyscallName, syscall.EAFNOSUPPORT)
+	}
+	return nil
+}
+
+func (fd *netFD) readFromInet4(p []byte, from *syscall.SockaddrInet4) (int, error) {
+	n, sa, err := fd.readFrom(p)
+	if err == nil {
+		err = sockaddrInto4(sa, from)
+	}
+	return n, err
+}
+
+func (fd *netFD) readFromInet6(p []byte, from *syscall.SockaddrInet6) (int, error) {
+	n, sa, err := fd.readFrom(p)
+	if err == nil {
+		err = sockaddrInto6(sa, from)
+	}
+	return n, err
+}
+
+func (fd *netFD) readMsg(p []byte, oob []byte, flags int) (n, oobn, retflags int, sa syscall.Sockaddr, err error) {
+	n, oobn, retflags, sa, err = fd.pfd.ReadMsg(p, oob, flags)
+	runtime.KeepAlive(fd)
+	return n, oobn, retflags, sa, wrapSyscallError(readMsgSyscallName, err)
+}
+
+func (fd *netFD) readMsgInet4(p []byte, oob []byte, flags int, from *syscall.SockaddrInet4) (n, oobn, retflags int, err error) {
+	n, oobn, retflags, sa, err := fd.readMsg(p, oob, flags)
+	if err == nil {
+		err = sockaddrInto4(sa, from)
+	}
+	return n, oobn, retflags, err
+}
+
+func (fd *netFD) readMsgInet6(p []byte, oob []byte, flags int, from *syscall.SockaddrInet6) (n, oobn, retflags int, err error) {
+	n, oobn, retflags, sa, err := fd.readMsg(p, oob, flags)
+	if err == nil {
+		err = sockaddrInto6(sa, from)
+	}
+	return n, oobn, retflags, err
+}
+
+func (fd *netFD) writeTo(p []byte, sa syscall.Sockaddr) (n int, err error) {
+	n, err = fd.pfd.WriteTo(p, sa)
+	runtime.KeepAlive(fd)
+	return n, wrapSyscallError(writeToSyscallName, err)
+}
+
+func (fd *netFD) writeToInet4(p []byte, sa *syscall.SockaddrInet4) (int, error) {
+	return fd.writeTo(p, sa)
+}
+
+func (fd *netFD) writeToInet6(p []byte, sa *syscall.SockaddrInet6) (int, error) {
+	return fd.writeTo(p, sa)
+}
+
+func (fd *netFD) writeMsg(p []byte, oob []byte, sa syscall.Sockaddr) (n int, oobn int, err error) {
+	n, oobn, err = fd.pfd.WriteMsg(p, oob, sa)
+	runtime.KeepAlive(fd)
+	return n, oobn, wrapSyscallError(writeMsgSyscallName, err)
+}
+
+// A connected socket writes with a nil address, which must reach the
+// generic call as a nil Sockaddr rather than a nil pointer inside one.
+func (fd *netFD) writeMsgInet4(p []byte, oob []byte, sa *syscall.SockaddrInet4) (int, int, error) {
+	if sa == nil {
+		return fd.writeMsg(p, oob, nil)
+	}
+	return fd.writeMsg(p, oob, sa)
+}
+
+func (fd *netFD) writeMsgInet6(p []byte, oob []byte, sa *syscall.SockaddrInet6) (int, int, error) {
+	if sa == nil {
+		return fd.writeMsg(p, oob, nil)
+	}
+	return fd.writeMsg(p, oob, sa)
+}
+
+// dup fails: WASI preview 1 has no call that duplicates a descriptor, so a
+// File of a connection cannot be made.
+func (fd *netFD) dup() (*os.File, error) {
+	return nil, os.NewSyscallError("dup", syscall.ENOSYS)
+}
