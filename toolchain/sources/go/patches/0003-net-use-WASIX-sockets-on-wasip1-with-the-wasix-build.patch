@@ -0,0 +1,30 @@
+//go:build wasip1 && wasix
+
+package net
+
+import (
+	"runtime"
+	"syscall"
+	"time"
+)
+
+func setNoDelay(fd *netFD, noDelay bool) error {
+	err := syscall.SetsockoptInt(fd.pfd.Sysfd, syscall.IPPROTO_TCP, syscall.TCP_NODELAY, wasixBoolint(noDelay))
+	runtime.KeepAlive(fd)
+	return wrapSyscallError("setsockopt", err)
+}
+
+// The runtime has a keep-alive switch (setKeepAlive) but no idle time,
+// interval or count for it, so those keep the runtime's defaults.
+
+func setKeepAliveIdle(_ *netFD, _ time.Duration) error {
+	return nil
