+// findfuncWasm finds the ftab entry for a PC on wasm, where the linker
+// builds no findfunctab. A wasm PC is the function index shifted left by
+// 16 with the block index below, so pcOff is the function's index within
+// the text, and since every function's entry is its own index, the ftab
+// entry for a function with one is at that index. The functions without
+// an entry of their own, the containers of sub-symbols, shift the entries
+// after them down, and a binary search over the sorted entries covers
+// those.
+//
+//go:nosplit
+func findfuncWasm(datap *moduledata, pcOff uint32) funcInfo {
+	ftab := datap.ftab
+	n := len(ftab) - 1 // the last entry marks the end of the text
+	idx := int(pcOff)
+	if idx >= n || ftab[idx].entryoff > pcOff || ftab[idx+1].entryoff <= pcOff {
+		lo, hi := 0, n
+		for lo < hi {
+			mid := int(uint(lo+hi) >> 1)
+			if ftab[mid+1].entryoff <= pcOff {
+				lo = mid + 1
+			} else {
+				hi = mid
+			}
+		}
+		idx = lo
+		if idx >= n || ftab[idx].entryoff > pcOff {
+			return funcInfo{}
+		}
+	}
+	funcoff := ftab[idx].funcoff
+	return funcInfo{(*_func)(unsafe.Pointer(&datap.pclntable[funcoff])), datap}
+}
+
 // A srcFunc represents a logical function in the source code. This may
 // correspond to an actual symbol in the binary text, or it may correspond to a
 // source function that has been inlined.
