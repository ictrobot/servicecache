#!/usr/bin/env python3
"""Test adapter for Valkey, spoken in RESP.

usage: adapter recipe
       adapter check-initialized HOST PORT

Every verb exits 0 on success and non-zero with a message on stderr
otherwise. `recipe` prints the initializer's stdin.
"""

import socket
import sys

RECIPE = "SET adapter-recipe recipe-value\nSET adapter-counter 10\n"


class Client:
    def __init__(self, host, port, timeout):
        self.sock = socket.create_connection((host, int(port)), timeout=5)
        self.sock.settimeout(timeout)
        self.reader = self.sock.makefile("rb")

    def command(self, *args):
        request = f"*{len(args)}\r\n" + "".join(f"${len(a)}\r\n{a}\r\n" for a in args)
        self.sock.sendall(request.encode())
        return self.reply()

    def reply(self):
        line = self.reader.readline().decode().rstrip("\r\n")
        kind, rest = line[0], line[1:]
        if kind in "+:-":
            return rest
        if kind == "$":
            size = int(rest)
            if size < 0:
                return None
            data = self.reader.read(size + 2)
            return data[:size].decode()
        if kind == "*":
            return [self.reply() for _ in range(max(int(rest), 0))]
        raise SystemExit(f"unexpected reply: {line}")


def expect(actual, expected):
    if actual != expected:
        raise SystemExit(f"expected {expected!r}, got {actual!r}")


def check_initialized(host, port):
    expect(Client(host, port, 5).command("GET", "adapter-recipe"), "recipe-value")


def main(argv):
    if not argv:
        raise SystemExit(__doc__)
    verb, args = argv[0], argv[1:]
    if verb == "recipe":
        sys.stdout.write(RECIPE)
        return
    if verb == "check-initialized":
        return check_initialized(*args)
    raise SystemExit(f"unknown verb {verb}\n{__doc__}")


if __name__ == "__main__":
    main(sys.argv[1:])
