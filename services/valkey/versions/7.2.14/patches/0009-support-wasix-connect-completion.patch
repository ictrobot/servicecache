 int redisCheckConnectDone(redisContext *c, int *completed) {
+#ifdef __wasm__
+    /* WASIX returns ENOTSUP when connect() is repeated on a connected socket,
+     * so inspect the pending socket error directly. */
+    int error = 0;
+    socklen_t error_length = sizeof(error);
+    if (getsockopt(c->fd, SOL_SOCKET, SO_ERROR, &error, &error_length) == -1) {
+        return REDIS_ERR;
+    }
+    if (error == 0) {
+        *completed = 1;
+        return REDIS_OK;
+    }
+    errno = error;
+    return REDIS_ERR;
+#else
     int rc = connect(c->fd, (const struct sockaddr *)c->saddr, c->addrlen);
     if (rc == 0) {
         *completed = 1;
@@ -338,6 +353,7 @@ int redisCheckConnectDone(redisContext *c, int *completed) {
     default:
         return REDIS_ERR;
     }
+#endif
 }
 
