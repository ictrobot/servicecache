+/* WASIX declares no fork() alongside WebAssembly exception handling, and a
+ * multi-threaded guest could not use one anyway: background children are
+ * refused with ENOTSUP for the caller to report. */
+#ifdef __wasm__
+static inline pid_t valkeyWasmFork(void) {
+    errno = ENOTSUP;
+    return -1;
+}
+#define valkey_fork() valkeyWasmFork()
+#else
+#define valkey_fork() fork()
+#endif
