diff --git a/storage/innobase/innodb.cmake b/storage/innobase/innodb.cmake
index 84df570e..4d9d82ae 100644
--- a/storage/innobase/innodb.cmake
+++ b/storage/innobase/innodb.cmake
@@ -181,6 +181,12 @@ IF(NOT CMAKE_CROSSCOMPILING)
   )
 ENDIF()
 
+# The upstream runtime probes are skipped for cross-compilation. WASIX builds
+# use shared-memory threads and Clang provides the required atomic fence.
+IF(WASIX)
+  SET(HAVE_IB_GCC_ATOMIC_THREAD_FENCE 1)
+ENDIF()
+
 IF(HAVE_IB_GCC_SYNC_SYNCHRONISE)
  ADD_DEFINITIONS(-DHAVE_IB_GCC_SYNC_SYNCHRONISE=1)
 ENDIF()
