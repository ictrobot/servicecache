Subject: [PATCH 4/7] server: adapt lifecycle and networking for WASIX

WASIX lacks the Unix process-control and signal-delivery behavior used by
mysqld. Keep the server in the foreground, reject chroot/identity switching,
use an internal atomic shutdown notification, and wake Wasmer's blocked TCP
poll with a loopback connection. Also avoid dynamic component autoloading and
the unavailable ppoll signal-wakeup path.

diff --git a/sql/conn_handler/connection_acceptor.h b/sql/conn_handler/connection_acceptor.h
index a0043dbb..d65b8fb9 100644
--- a/sql/conn_handler/connection_acceptor.h
+++ b/sql/conn_handler/connection_acceptor.h
@@ -81,5 +81,10 @@ class Connection_acceptor {
     Close the listener.
   */
   void close_listener() { m_listener->close_listener(); }
+
+#if defined(__wasm__)
+  /** Wake a WASIX listener blocked in poll() during server shutdown. */
+  void wake_listener() { m_listener->wake_listener(); }
+#endif
 };
 #endif  // CONNECTION_ACCEPTOR_INCLUDED
diff --git a/sql/conn_handler/socket_connection.cc b/sql/conn_handler/socket_connection.cc
index 1e0decf6..5cb3e6be 100644
--- a/sql/conn_handler/socket_connection.cc
+++ b/sql/conn_handler/socket_connection.cc
@@ -1439,6 +1439,21 @@ Channel_info *Mysqld_socket_listener::listen_for_connection_event() {
   return channel_info;
 }
 
+#if defined(__wasm__)
+void Mysqld_socket_listener::wake_listener() {
+  int wake_socket = socket(AF_INET, SOCK_STREAM, 0);
+  if (wake_socket < 0) return;
+
+  sockaddr_in loopback{};
+  loopback.sin_family = AF_INET;
+  loopback.sin_port = htons(m_tcp_port);
+  loopback.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  (void)connect(wake_socket, reinterpret_cast<sockaddr *>(&loopback),
+                sizeof(loopback));
+  (void)close(wake_socket);
+}
+#endif
+
 void Mysqld_socket_listener::close_listener() {
   for (const auto &socket_element : m_socket_vector) {
     (void)mysql_socket_shutdown(socket_element.m_socket, SHUT_RDWR);
diff --git a/sql/conn_handler/socket_connection.h b/sql/conn_handler/socket_connection.h
index 9a509e9b..aa83ceac 100644
--- a/sql/conn_handler/socket_connection.h
+++ b/sql/conn_handler/socket_connection.h
@@ -196,6 +196,11 @@ class Mysqld_socket_listener {
   */
   void close_listener();
 
+#if defined(__wasm__)
+  /** Make a loopback connection to wake poll() during server shutdown. */
+  void wake_listener();
+#endif
+
   ~Mysqld_socket_listener() {
     if (!m_socket_vector.empty()) close_listener();
   }
