 static void set_effective_user(const PasswdValue &user_info_arg) {
   assert(user_info_arg.IsVoid() == false);
+#ifdef __wasm__
+  /*
+    WASIX does not expose the real/effective uid switching interfaces.  A
+    Wasmer instance already provides the process isolation boundary, and this
+    path is only used with --memlock and --user.  Fail explicitly if it is
+    requested instead of silently retaining the original identity.
+  */
+  (void)user_info_arg;
+  errno = ENOSYS;
+  LogErr(ERROR_LEVEL, ER_FAIL_SETREUID, strerror(errno));
+  unireg_abort(MYSQLD_ABORT_EXIT);
+#else
   if (setregid((gid_t)-1, user_info_arg.pw_gid) == -1) {
     LogErr(ERROR_LEVEL, ER_FAIL_SETREGID, strerror(errno));
     unireg_abort(MYSQLD_ABORT_EXIT);
@@ -2925,15 +2947,23 @@ static void set_effective_user(const PasswdValue &user_info_arg) {
     LogErr(ERROR_LEVEL, ER_FAIL_SETREUID, strerror(errno));
     unireg_abort(MYSQLD_ABORT_EXIT);
   }
+#endif
 }
 
 /** Change root user if started with @c --chroot . */
 static void set_root(const char *path) {
+#ifdef __wasm__
+  (void)path;
+  errno = ENOSYS;
+  LogErr(ERROR_LEVEL, ER_FAIL_CHROOT, strerror(errno));
+  unireg_abort(MYSQLD_ABORT_EXIT);
+#else
   if (chroot(path) == -1) {
     LogErr(ERROR_LEVEL, ER_FAIL_CHROOT, strerror(errno));
     unireg_abort(MYSQLD_ABORT_EXIT);
   }
   my_setwd("/", MYF(0));
+#endif
 }
 #endif  // !_WIN32
 
