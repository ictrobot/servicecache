Subject: [PATCH] protobuf: use vfork for protoc subprocesses on WASIX

WASIX's exception-enabled libc exposes vfork() but intentionally omits fork(),
because copying an exception-handling stack is unsupported. protoc's subprocess
helper only redirects descriptors and execs in the child, which is what vfork
is for.

diff --git a/extra/protobuf/protobuf-24.4/src/google/protobuf/compiler/subprocess.cc b/extra/protobuf/protobuf-24.4/src/google/protobuf/compiler/subprocess.cc
index 6f9233da..670bd122 100644
--- a/extra/protobuf/protobuf-24.4/src/google/protobuf/compiler/subprocess.cc
+++ b/extra/protobuf/protobuf-24.4/src/google/protobuf/compiler/subprocess.cc
@@ -41,6 +41,7 @@
 #include <signal.h>
 #include <sys/select.h>
 #include <sys/wait.h>
+#include <unistd.h>
 #endif
 
 #include "absl/log/absl_check.h"
@@ -333,7 +334,14 @@ void Subprocess::Start(const std::string& program, SearchMode search_mode) {
 
   char* argv[2] = {portable_strdup(program.c_str()), nullptr};
 
+#ifdef __wasm__
+  // WASIX's exception-enabled libc exposes vfork(), but intentionally omits
+  // fork() because copying an EH stack is unsupported.  This child immediately
+  // redirects descriptors and execs, which is the intended vfork use case.
+  child_pid_ = vfork();
+#else
   child_pid_ = fork();
+#endif
   if (child_pid_ == -1) {
     ABSL_LOG(FATAL) << "fork: " << strerror(errno);
   } else if (child_pid_ == 0) {
