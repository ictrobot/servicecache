diff --git a/mysys/wasix_timers.cc b/mysys/wasix_timers.cc
new file mode 100644
index 00000000..eb470045
--- /dev/null
+++ b/mysys/wasix_timers.cc
@@ -0,0 +1,165 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copyright (c) 2026 Ethan Jones
+
+   This file is designed to work with certain software (including but not
+   limited to OpenSSL) that is licensed under separate terms, as designated
+   by the authors of MySQL in a particular file or component or in included
+   license documentation. Without limiting your rights under the GPLv2, the
+   copyright holder of this file hereby grants you an additional permission
+   to link this file, and any program or derivative work containing it, with
+   the separately licensed software that the authors of MySQL have either
+   included with the program or referenced in the documentation. */
+
+/*
+
+   WASIX does not expose POSIX timer_create(), but it does provide pthreads,
+   condition variables, and monotonic clocks. Implement the small timer API
+   required by MySQL with one sleeping worker per timer object. */
+
+#include "my_timer.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <time.h>
+
+namespace {
+
+struct Wasix_timer {
+  pthread_mutex_t mutex;
+  pthread_cond_t cond;
+  pthread_t thread;
+  my_timer_t *owner;
+  struct timespec deadline;
+  uint64_t generation;
+  bool armed;
+  bool shutdown;
+};
+
+static void add_milliseconds(struct timespec *value, unsigned long millis) {
+  value->tv_sec += static_cast<time_t>(millis / 1000);
+  value->tv_nsec += static_cast<long>((millis % 1000) * 1000000UL);
+  if (value->tv_nsec >= 1000000000L) {
+    ++value->tv_sec;
+    value->tv_nsec -= 1000000000L;
+  }
+}
+
+static void *timer_worker(void *argument) {
+  auto *state = static_cast<Wasix_timer *>(argument);
+  pthread_mutex_lock(&state->mutex);
+
+  while (!state->shutdown) {
+    while (!state->armed && !state->shutdown)
+      pthread_cond_wait(&state->cond, &state->mutex);
+
+    if (state->shutdown) break;
+
+    const uint64_t generation = state->generation;
+    const struct timespec deadline = state->deadline;
+    const int status =
+        pthread_cond_timedwait(&state->cond, &state->mutex, &deadline);
+
+    if (status == ETIMEDOUT && state->armed &&
+        state->generation == generation) {
+      state->armed = false;
+      my_timer_t *owner = state->owner;
+      pthread_mutex_unlock(&state->mutex);
+      owner->notify_function(owner);
+      pthread_mutex_lock(&state->mutex);
+    }
+  }
+
+  pthread_mutex_unlock(&state->mutex);
+  return nullptr;
+}
+
+}  // namespace
+
+int my_timer_initialize() { return 0; }
+
+void my_timer_deinitialize() {}
+
+int my_timer_create(my_timer_t *timer) {
+  auto *state = static_cast<Wasix_timer *>(calloc(1, sizeof(Wasix_timer)));
+  if (state == nullptr) {
+    errno = ENOMEM;
+    return -1;
+  }
+
+  state->owner = timer;
+  if (pthread_mutex_init(&state->mutex, nullptr) != 0) {
+    free(state);
+    return -1;
+  }
+
+  pthread_condattr_t attr;
+  if (pthread_condattr_init(&attr) != 0) {
+    pthread_mutex_destroy(&state->mutex);
+    free(state);
+    return -1;
+  }
+  pthread_condattr_setclock(&attr, CLOCK_MONOTONIC);
+  const int cond_status = pthread_cond_init(&state->cond, &attr);
+  pthread_condattr_destroy(&attr);
+  if (cond_status != 0) {
+    pthread_mutex_destroy(&state->mutex);
+    free(state);
+    return -1;
+  }
+
+  const int thread_status =
+      pthread_create(&state->thread, nullptr, timer_worker, state);
+  if (thread_status != 0) {
+    pthread_cond_destroy(&state->cond);
+    pthread_mutex_destroy(&state->mutex);
+    free(state);
+    errno = thread_status;
+    return -1;
+  }
+
+  timer->id = state;
+  return 0;
+}
+
+int my_timer_set(my_timer_t *timer, unsigned long time) {
+  auto *state = static_cast<Wasix_timer *>(timer->id);
+  pthread_mutex_lock(&state->mutex);
+  clock_gettime(CLOCK_MONOTONIC, &state->deadline);
+  add_milliseconds(&state->deadline, time);
+  ++state->generation;
+  state->armed = true;
+  pthread_cond_signal(&state->cond);
+  pthread_mutex_unlock(&state->mutex);
+  return 0;
+}
+
+int my_timer_cancel(my_timer_t *timer, int *state_at_cancel) {
+  auto *state = static_cast<Wasix_timer *>(timer->id);
+  pthread_mutex_lock(&state->mutex);
+  *state_at_cancel = state->armed ? 1 : 0;
+  state->armed = false;
+  ++state->generation;
+  pthread_cond_signal(&state->cond);
+  pthread_mutex_unlock(&state->mutex);
+  return 0;
+}
+
+void my_timer_delete(my_timer_t *timer) {
+  auto *state = static_cast<Wasix_timer *>(timer->id);
+  if (state == nullptr) return;
+
+  pthread_mutex_lock(&state->mutex);
+  state->shutdown = true;
+  state->armed = false;
+  ++state->generation;
+  pthread_cond_signal(&state->cond);
+  pthread_mutex_unlock(&state->mutex);
+
+  pthread_join(state->thread, nullptr);
+  pthread_cond_destroy(&state->cond);
+  pthread_mutex_destroy(&state->mutex);
+  free(state);
+  timer->id = nullptr;
+}
