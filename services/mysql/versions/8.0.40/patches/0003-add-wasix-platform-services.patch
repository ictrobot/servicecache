+   copyright holder of this file hereby grants you an additional permission
+   to link this file, and any program or derivative work containing it, with
+   the separately licensed software that the authors of MySQL have either
+   included with the program or referenced in the documentation. */
+
+/* WASIX platform support for MySQL resource groups. */
+
+#include "sql/resourcegroups/platform/thread_attrs_api.h"
+
+#include <unistd.h>
+
+namespace resourcegroups {
+namespace platform {
+
+/* WASIX does not currently expose per-thread affinity or priority controls. */
+bool is_platform_supported() { return false; }
+
+bool bind_to_cpu(cpu_id_t) { return true; }
+bool bind_to_cpu(cpu_id_t, my_thread_os_id_t) { return true; }
+bool bind_to_cpus(const std::vector<cpu_id_t> &) { return true; }
+bool bind_to_cpus(const std::vector<cpu_id_t> &, my_thread_os_id_t) {
+  return true;
+}
+bool unbind_thread() { return true; }
+bool unbind_thread(my_thread_os_id_t) { return true; }
+int thread_priority(my_thread_os_id_t) { return 0; }
+bool set_thread_priority(int) { return true; }
+bool set_thread_priority(int, my_thread_os_id_t) { return true; }
+
+uint32_t num_vcpus_using_affinity() { return 0; }
+
+uint32_t num_vcpus_using_config() {
+  const long count = sysconf(_SC_NPROCESSORS_ONLN);
+  return count > 0 ? static_cast<uint32_t>(count) : 1;
+}
+
+bool can_thread_priority_be_set() { return false; }
+
+}  // namespace platform
+}  // namespace resourcegroups
