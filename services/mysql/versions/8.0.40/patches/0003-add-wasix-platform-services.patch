diff --git a/include/dlfcn.h b/include/dlfcn.h
new file mode 100644
index 00000000..275133e3
--- /dev/null
+++ b/include/dlfcn.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copyright (c) 2026 Ethan Jones
+
+   This file is designed to work with certain software (including but not
+   limited to OpenSSL) that is licensed under separate terms, as designated
+   by the authors of MySQL in a particular file or component or in included
+   license documentation. Without limiting your rights under the GPLv2, the
+   copyright holder of this file hereby grants you an additional permission
+   to link this file, and any program or derivative work containing it, with
+   the separately licensed software that the authors of MySQL have either
+   included with the program or referenced in the documentation. */
+
+/*
+  WASIX compatibility for the non-PIC exception-enabled sysroot.
+
+  That sysroot does not ship dlfcn.h, and this server build is fully static.
+  Keep MySQL's existing dynamic-plugin error paths linkable while reporting
+  that runtime loading is unsupported.
+*/
+#ifndef MYSQL_WASIX_DLFCN_H
+#define MYSQL_WASIX_DLFCN_H
+
+#if !defined(__wasm__)
+
+/* This compatibility header is earlier on MySQL's include path. Native Unix
+   builds must continue to use their platform's real dynamic-loader API. */
+#include_next <dlfcn.h>
+
+#else
+
+#include <errno.h>
+#include <stddef.h>
+
+#define RTLD_LAZY 1
+#define RTLD_NOW 2
+#define RTLD_NOLOAD 4
+#define RTLD_NODELETE 8
+#define RTLD_GLOBAL 16
+#define RTLD_LOCAL 0
+#define RTLD_DEFAULT ((void *)0)
+
+#ifdef __cplusplus
+extern "C" {
+#define MYSQL_WASIX_THREAD_LOCAL thread_local
+#else
+#define MYSQL_WASIX_THREAD_LOCAL _Thread_local
+#endif
+
+static inline int *mysql_wasix_dlerror_pending(void) {
+  static MYSQL_WASIX_THREAD_LOCAL int pending;
+  return &pending;
+}
+
+static inline void *dlopen(const char *path, int mode) {
+  (void)path;
+  (void)mode;
+  errno = ENOSYS;
+  *mysql_wasix_dlerror_pending() = 1;
+  return NULL;
+}
+
+static inline void *dlsym(void *handle, const char *symbol) {
+  (void)handle;
+  (void)symbol;
+  errno = ENOSYS;
+  *mysql_wasix_dlerror_pending() = 1;
+  return NULL;
+}
+
+static inline int dlclose(void *handle) {
+  (void)handle;
+  return 0;
+}
+
+static inline char *dlerror(void) {
+  static char unsupported[] = "dynamic loading is unavailable in this static WASIX build";
+  int *pending = mysql_wasix_dlerror_pending();
+  if (!*pending) return NULL;
+  *pending = 0;
+  return unsupported;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#undef MYSQL_WASIX_THREAD_LOCAL
+
+#endif /* __wasm__ */
+
+#endif /* MYSQL_WASIX_DLFCN_H */
