Subject: [PATCH 7/7] client: build batch-only mysql module for WASIX

Build the standard mysql client without its terminal editing path. Standard
input and --execute retain the upstream batch parser and direct TCP/TLS client
implementation.

diff --git a/client/CMakeLists.txt b/client/CMakeLists.txt
index 4ca14701..a217c891 100644
--- a/client/CMakeLists.txt
+++ b/client/CMakeLists.txt
@@ -43,6 +43,10 @@ MYSQL_ADD_EXECUTABLE(mysql
   LINK_LIBRARIES mysqlclient ${EDITLINE_LIBRARY}
   )
 
+IF(WASIX)
+  TARGET_COMPILE_DEFINITIONS(mysql PRIVATE MYSQL_BATCH_ONLY)
+ENDIF()
+
 MYSQL_ADD_EXECUTABLE(mysqltest
   mysqltest.cc
   mysqltest/error_names.cc
