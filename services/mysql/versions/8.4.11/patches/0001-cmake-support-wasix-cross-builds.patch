Subject: [PATCH 1/7] cmake: support WASIX cross-builds

Avoid probing host-only authentication and editline dependencies, build
Protobuf statically, and make cross-built helper programs available through
CMake's configured Wasmer emulator.

For 8.4, also let the 32-bit wasm32 target through the 64-bit-only platform
check, and point the OpenSSL imported targets at the libraries that were
found: 8.4 takes their locations from copies that only packaged Linux and
Apple builds make, which left every other custom WITH_SSL path unlinkable.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1dc2bd42..a9b49ab9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -694,7 +694,8 @@ MESSAGE(STATUS "SIZEOF_VOIDP ${SIZEOF_VOIDP}")
 # On some platforms, cmake may think that CMAKE_SIZEOF_VOID_P == 4
 # even if we have configured for 64bit build....
 SET(CMAKE_SIZEOF_VOID_P ${SIZEOF_VOIDP})
-IF(NOT SIZEOF_VOIDP EQUAL 8)
+# wasm32 is a 32-bit target; the WASIX cross build is the one exception.
+IF(NOT SIZEOF_VOIDP EQUAL 8 AND NOT WASIX)
   MESSAGE(FATAL_ERROR "MySQL supports only 64-bit platforms.")
 ENDIF()
 
@@ -1904,17 +1905,28 @@ IF(ALTERNATIVE_SYSTEM_SSL)
   MESSAGE(STATUS "Disabling all authentication plugins.")
 ENDIF()
 
-# Add Kerberos library
-MYSQL_CHECK_KERBEROS()
-MYSQL_CHECK_KERBEROS_DLLS()
+# These libraries only serve optional authentication plugins and do not have
+# WASIX ports. Avoid host-library discovery for the WASIX cross build.
+IF(WASIX)
+  SET(WITH_KERBEROS "none" CACHE STRING "Kerberos disabled for WASIX" FORCE)
+  SET(WITH_SASL "none" CACHE STRING "SASL disabled for WASIX" FORCE)
+  SET(WITH_LDAP "none" CACHE STRING "LDAP disabled for WASIX" FORCE)
+  SET(KERBEROS_FOUND 0)
+  SET(SASL_FOUND 0)
+  SET(LDAP_FOUND 0)
+ELSE()
+  # Add Kerberos library
+  MYSQL_CHECK_KERBEROS()
+  MYSQL_CHECK_KERBEROS_DLLS()
 
-# Add SASL library
-MYSQL_CHECK_SASL()
-MYSQL_CHECK_SASL_DLLS()
+  # Add SASL library
+  MYSQL_CHECK_SASL()
+  MYSQL_CHECK_SASL_DLLS()
 
-# Add LDAP library
-MYSQL_CHECK_LDAP()
-MYSQL_CHECK_LDAP_DLLS()
+  # Add LDAP library
+  MYSQL_CHECK_LDAP()
+  MYSQL_CHECK_LDAP_DLLS()
+ENDIF()
 
 # Add Windows specific jemalloc DLL
 IF(WIN32)
@@ -1994,15 +2006,17 @@ IF(WITH_AUTHENTICATION_KERBEROS)
   ENDIF()
 ENDIF()
 
-# Add system/bundled editline.
-MYSQL_CHECK_EDITLINE()
-SET(EDITLINE_WARN_GIVEN)
-WARN_MISSING_SYSTEM_EDITLINE(EDITLINE_WARN_GIVEN)
-IF(EDITLINE_WARN_GIVEN)
-  MESSAGE(FATAL_ERROR
-    "-DWITH_EDITLINE=system, but missing system libraries.\n"
-    "You can use -DWITH_EDITLINE=bundled instead."
-    )
+# The WASIX mysql client is batch-only and does not use terminal editing.
+IF(NOT WASIX)
+  MYSQL_CHECK_EDITLINE()
+  SET(EDITLINE_WARN_GIVEN)
+  WARN_MISSING_SYSTEM_EDITLINE(EDITLINE_WARN_GIVEN)
+  IF(EDITLINE_WARN_GIVEN)
+    MESSAGE(FATAL_ERROR
+      "-DWITH_EDITLINE=system, but missing system libraries.\n"
+      "You can use -DWITH_EDITLINE=bundled instead."
+      )
+  ENDIF()
 ENDIF()
 
 # Add lz4 library
diff --git a/cmake/ssl.cmake b/cmake/ssl.cmake
index 68478613..86496be2 100644
--- a/cmake/ssl.cmake
+++ b/cmake/ssl.cmake
@@ -498,7 +498,9 @@ FUNCTION(FIND_CUSTOM_OPENSSL)
   SET_TARGET_PROPERTIES(OpenSSL::SSL PROPERTIES
     IMPORTED_LINK_INTERFACE_LANGUAGES "C"
     INTERFACE_INCLUDE_DIRECTORIES "${OPENSSL_INCLUDE_DIR}")
-  IF(WIN32)
+  # MYSQL_CHECK_SSL_DLLS copies shared libraries only for packaged Linux and
+  # Apple builds. Elsewhere, and for static libraries, link what was found.
+  IF(WIN32 OR NOT COPIED_OPENSSL_LIBRARY)
     SET_TARGET_PROPERTIES(OpenSSL::SSL PROPERTIES
       IMPORTED_LOCATION "${OPENSSL_LIBRARY}")
   ELSE()
@@ -510,7 +512,7 @@ FUNCTION(FIND_CUSTOM_OPENSSL)
   SET_TARGET_PROPERTIES(OpenSSL::Crypto PROPERTIES
     IMPORTED_LINK_INTERFACE_LANGUAGES "C"
     INTERFACE_INCLUDE_DIRECTORIES "${OPENSSL_INCLUDE_DIR}")
-  IF(WIN32)
+  IF(WIN32 OR NOT COPIED_CRYPTO_LIBRARY)
     SET_TARGET_PROPERTIES(OpenSSL::Crypto PROPERTIES
       IMPORTED_LOCATION "${CRYPTO_LIBRARY}")
   ELSE()
diff --git a/extra/icu/CMakeLists.txt b/extra/icu/CMakeLists.txt
index 2f330640..364490e5 100644
--- a/extra/icu/CMakeLists.txt
+++ b/extra/icu/CMakeLists.txt
@@ -685,6 +685,17 @@ TARGET_INCLUDE_DIRECTORIES(icuuc PRIVATE
   )
 TARGET_LINK_LIBRARIES(icuuc PRIVATE ${CMAKE_DL_LIBS})
 
+IF(WASIX)
+  # WASIX has tzset/localtime but no POSIX timezone/tzname globals.  It also
+  # deliberately omits dlfcn.h from the static exception-enabled sysroot.
+  TARGET_COMPILE_DEFINITIONS(icuuc PRIVATE
+    HAVE_DLFCN_H=0
+    HAVE_DLOPEN=0
+    U_HAVE_TIMEZONE=0
+    U_HAVE_TZNAME=0
+    )
+ENDIF()
+
 ADD_LIBRARY(icui18n STATIC ${ICU_I18N_SOURCES})
 TARGET_COMPILE_DEFINITIONS(icui18n PRIVATE -DU_I18N_IMPLEMENTATION)
 TARGET_INCLUDE_DIRECTORIES(icui18n PRIVATE
diff --git a/extra/protobuf/CMakeLists.txt b/extra/protobuf/CMakeLists.txt
index 76c5f1cf..98ad448a 100644
--- a/extra/protobuf/CMakeLists.txt
+++ b/extra/protobuf/CMakeLists.txt
@@ -167,7 +167,10 @@ SET(protobuf_BUILD_EXAMPLES OFF CACHE INTERNAL "")
 # Look for: Force running AddDescriptors() at dynamic initialization time.
 # Hangs at src/google/protobuf/compiler/plugin.pb.cc:193
 # cmake/abseil-cpp.cmake assumes abseil is also a .dll
-IF(SOLARIS OR WIN32_CLANG)
+IF(SOLARIS OR WIN32_CLANG OR WASIX)
+  # The WASIX server is one static WebAssembly module.  Building Protobuf as
+  # a shared wasm library would require every Abseil dependency to be PIC and
+  # would introduce runtime side modules that mysqld does not need.
   SET(protobuf_BUILD_SHARED_LIBS OFF CACHE INTERNAL "")
 ELSE()
   # With static C/C++ libraries, protoc with shared libs will segfault,
diff --git a/utilities/CMakeLists.txt b/utilities/CMakeLists.txt
index 865abc2e..19c15b78 100644
--- a/utilities/CMakeLists.txt
+++ b/utilities/CMakeLists.txt
@@ -30,7 +30,9 @@ IF(NOT WITH_DEBUG)
   DISABLE_DOCUMENTATION_WARNINGS()
 ENDIF()
 
-IF(NOT CMAKE_CROSSCOMPILING)
+# WASIX build tools can be executed by CMake through
+# CMAKE_CROSSCOMPILING_EMULATOR (the workspace-local Wasmer runner).
+IF(NOT CMAKE_CROSSCOMPILING OR WASIX)
   MYSQL_ADD_EXECUTABLE(comp_err
     comp_err.cc
     COMPONENT Test
