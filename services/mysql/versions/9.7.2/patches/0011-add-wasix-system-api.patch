+
+#include <cstdint>
+#include <unistd.h>  // sysconf
+
+#include "my_system_api.h"
+
+/**
+  @file components/library_mysys/my_system_api/my_system_api_wasix.cc
+  WASIX has no CPU affinity API and no cgroups. The number of VCPUs comes
+  from sysconf(), and the cgroup queries report that no limits apply.
+*/
+
+uint32_t num_vcpus_using_affinity() { return 0; }
+
+uint32_t num_vcpus_using_config() {
+  const long num_vcpus = sysconf(_SC_NPROCESSORS_ONLN);
+  return num_vcpus > 0 ? static_cast<uint32_t>(num_vcpus) : 0;
+}
+
+bool is_running_in_cgroup() { return false; }
+
+bool does_cgroup_limit_resources() { return false; }
+
+uint64_t my_cgroup_mem_limit() { return 0; }
