+#if defined(__wasm__)
+  /*
+    A pipe whose read end is polled with the listening sockets, so that the
+    listener can be woken from poll() without a signal: WASIX runs signal
+    handlers but does not interrupt poll() for them.
+  */
+  int m_wake_pipe[2] = {-1, -1};
+#endif
 
 #ifdef HAVE_POLL
   struct poll_info_t {
@@ -196,6 +204,11 @@ class Mysqld_socket_listener {
   */
   void close_listener();
 
+#if defined(__wasm__)
+  /** Wake the listener out of poll() during server shutdown. */
+  void wake_listener();
+#endif
+
   ~Mysqld_socket_listener() {
     if (!m_socket_vector.empty()) close_listener();
   }
