@@ -1347,7 +1356,16 @@ const Listen_socket *Mysqld_socket_listener::get_listen_socket() const {
 }
 
 Channel_info *Mysqld_socket_listener::listen_for_connection_event() {
-#ifdef HAVE_POLL
+#if defined(__wasm__)
+  // The sockets and, after them, the wake pipe.
+  int retval = poll(&m_poll_info.m_fds[0], m_poll_info.m_fds.size(), -1);
+  if (retval > 0 && m_wake_pipe[0] >= 0 && m_poll_info.m_fds.back().revents) {
+    // Woken during shutdown: consume one wake and let the caller notice.
+    char byte;
+    (void)read(m_wake_pipe[0], &byte, 1);
+    return nullptr;
+  }
+#elif defined(HAVE_POLL)
   int retval = poll(&m_poll_info.m_fds[0], m_socket_vector.size(), -1);
 #else
   m_select_info.m_read_fds = m_select_info.m_client_fds;
@@ -1440,12 +1458,25 @@ Channel_info *Mysqld_socket_listener::listen_for_connection_event() {
   return channel_info;
 }
 
+#if defined(__wasm__)
+void Mysqld_socket_listener::wake_listener() {
+  if (m_wake_pipe[1] >= 0) (void)write(m_wake_pipe[1], "", 1);
+}
+#endif
+
 void Mysqld_socket_listener::close_listener() {
   for (const auto &socket_element : m_socket_vector) {
     (void)mysql_socket_shutdown(socket_element.m_socket, SHUT_RDWR);
     (void)mysql_socket_close(socket_element.m_socket);
   }
 
+#if defined(__wasm__)
+  for (int &fd : m_wake_pipe) {
+    if (fd >= 0) (void)close(fd);
+    fd = -1;
+  }
+#endif
+
   /*
     In case a separate thread was spawned to handle incoming connection
     requests on admin interface, a socket corresponding to an admin interface
