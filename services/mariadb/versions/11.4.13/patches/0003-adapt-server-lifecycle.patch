Subject: [PATCH 3/6] server: adapt lifecycle for WASIX

WASIX runs signal handlers but never wakes sigwait, and has no setuid,
setgid or chroot. The signal thread waits for the shutdown flag on the
condition the accept loop broadcasts when it ends, instead of sigwait, and
is joined at shutdown; --user and --chroot fail with ENOSYS rather than
pretend; a bootstrap creates its data directory, since a WASIX guest's
filesystem starts empty and mysql_install_db is not run. The listen loop
needs no change: MariaDB wakes it out of poll() through a pipe in the
poll set, which works under WASIX.

diff --git a/sql/mysqld.cc b/sql/mysqld.cc
index f662270e..8156ed60 100644
--- a/sql/mysqld.cc
+++ b/sql/mysqld.cc
@@ -2181,7 +2181,14 @@ static void clean_up(bool print_message, bool use_dummy_thd)
 */
 static void wait_for_signal_thread_to_end()
 {
-#ifndef _WIN32
+#if defined(__wasm__)
+  abort_loop= 1;
+  mysql_mutex_lock(&LOCK_start_thread);
+  mysql_cond_broadcast(&COND_start_thread);
+  mysql_mutex_unlock(&LOCK_start_thread);
+  if (signal_thread_in_use)
+    pthread_join(signal_thread, NULL);
+#elif !defined(_WIN32)
   uint i, n_waits= DBUG_IF("force_sighup_processing_timeout") ? 5 : 100;
   int err= 0;
   /*
@@ -2375,6 +2382,12 @@ static void set_user(const char *user, struct passwd *user_info_arg)
 static void set_effective_user(struct passwd *user_info_arg)
 {
   DBUG_ASSERT(user_info_arg != 0);
+#ifdef __wasm__
+  (void) user_info_arg;
+  errno= ENOSYS;
+  sql_perror("set effective user");
+  unireg_abort(1);
+#else
   if (setregid((gid_t)-1, user_info_arg->pw_gid) == -1)
   {
     sql_perror("setregid");
@@ -2386,13 +2399,19 @@ static void set_effective_user(struct passwd *user_info_arg)
     unireg_abort(1);
   }
   allow_coredumps();
+#endif
 }
 #endif
 
 /** Change root user if started with @c --chroot . */
 static void set_root(const char *path)
 {
-#if !defined(_WIN32)
+#if defined(__wasm__)
+  (void) path;
+  errno= ENOSYS;
+  sql_perror("chroot");
+  unireg_abort(1);
+#elif !defined(_WIN32)
   if (chroot(path) == -1)
   {
     sql_perror("chroot");
@@ -3406,6 +3425,17 @@ pthread_handler_t signal_hand(void *)
   (void) pthread_sigmask(SIG_BLOCK,&set,NULL);
   for (;;)
   {
+#ifdef __wasm__
+    /*
+      WASIX never wakes sigwait. Wait for the shutdown flag instead, on the
+      condition the accept loop broadcasts when it ends.
+    */
+    mysql_mutex_lock(&LOCK_start_thread);
+    while (!abort_loop)
+      mysql_cond_wait(&COND_start_thread, &LOCK_start_thread);
+    mysql_mutex_unlock(&LOCK_start_thread);
+    break;
+#else
     int error;
     int origin;
 
@@ -3460,6 +3490,7 @@ pthread_handler_t signal_hand(void *)
 #endif
       break;					/* purecov: tested */
     }
+#endif
   }
   my_thread_end();
   signal_thread_in_use= 0;
@@ -4482,6 +4513,14 @@ static int init_common_variables()
   DBUG_PRINT("info", ("lower_case_table_names: %d", lower_case_table_names));
   if(mysql_real_data_home_ptr == NULL || *mysql_real_data_home_ptr == 0)
     mysql_real_data_home_ptr= mysql_real_data_home;
+#ifdef __wasm__
+  /*
+    A WASIX guest's filesystem starts empty and mysql_install_db is not run:
+    a bootstrap creates its own data directory.
+  */
+  if (opt_bootstrap && my_access(mysql_real_data_home_ptr, F_OK))
+    (void) my_mkdir(mysql_real_data_home_ptr, 0700, MYF(MY_WME));
+#endif
   SYSVAR_AUTOSIZE(lower_case_file_system,
                   test_if_case_insensitive(mysql_real_data_home_ptr));
   if (!lower_case_table_names && lower_case_file_system == 1)
