Subject: [PATCH 1/6] cmake: support WASIX cross-builds

MariaDB's CMake and bundled scripts assume Unix or Windows. Treat WASIX as
a cross build: skip the readline probe the batch-only client does not need,
create the legacy client symlink as on Unix, and fix two declarations the
WASIX toolchain's stricter C++ rejects (the stub plugin lookup taking a
LEX_CSTRING, the replication deadlock check returning int).

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0116c35a..34e1edb2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -437,8 +437,11 @@ INCLUDE_DIRECTORIES(${CMAKE_CURRENT_BINARY_DIR}/include
 MYSQL_CHECK_ZLIB_WITH_COMPRESS()
 # Add bundled wolfssl/wolfcrypt or system openssl.
 MYSQL_CHECK_SSL()
-# Add readline or libedit.
-MYSQL_CHECK_READLINE()
+# The WASIX mariadb client is batch-only and does not use terminal editing.
+IF(NOT WASIX)
+  # Add readline or libedit.
+  MYSQL_CHECK_READLINE()
+ENDIF()
 
 SET(MALLOC_LIBRARY "system")
 
diff --git a/cmake/mysql_add_executable.cmake b/cmake/mysql_add_executable.cmake
index 06bdfce1..e6945ac7 100644
--- a/cmake/mysql_add_executable.cmake
+++ b/cmake/mysql_add_executable.cmake
@@ -96,7 +96,7 @@ FUNCTION (MYSQL_ADD_EXECUTABLE)
   # create MySQL named "legacy links"
   GET_SYMLINK(${target} link)
   IF(link)
-    IF(UNIX)
+    IF(UNIX OR WASIX)
       ADD_CUSTOM_COMMAND(TARGET ${target} POST_BUILD
         COMMAND ${CMAKE_COMMAND} -E create_symlink
          ${target} ${link}
diff --git a/sql/sql_plugin.cc b/sql/sql_plugin.cc
index 34a9eec7..b2726e91 100644
--- a/sql/sql_plugin.cc
+++ b/sql/sql_plugin.cc
@@ -500,7 +500,7 @@ static st_plugin_dl *plugin_dl_insert_or_reuse(struct st_plugin_dl *plugin_dl)
   DBUG_RETURN(tmp);
 }
 #else
-static struct st_plugin_dl *plugin_dl_find(const LEX_STRING *)
+static struct st_plugin_dl *plugin_dl_find(const LEX_CSTRING *)
 {
   return 0;
 }
diff --git a/storage/innobase/lock/lock0lock.cc b/storage/innobase/lock/lock0lock.cc
index 4838b4c8..df7a739d 100644
--- a/storage/innobase/lock/lock0lock.cc
+++ b/storage/innobase/lock/lock0lock.cc
@@ -72,7 +72,7 @@ constexpr bool innodb_enable_xap_unlock_unmodified_for_primary_debug= false;
 #endif
 
 #ifdef HAVE_REPLICATION
-extern "C" void thd_rpl_deadlock_check(MYSQL_THD thd, MYSQL_THD other_thd);
+extern "C" int thd_rpl_deadlock_check(MYSQL_THD thd, MYSQL_THD other_thd);
 extern "C" int thd_need_wait_reports(const MYSQL_THD thd);
 extern "C" int thd_need_ordering_with(const MYSQL_THD thd, const MYSQL_THD other_thd);
 extern "C" int thd_deadlock_victim_preference(const MYSQL_THD thd1, const MYSQL_THD thd2);
