Subject: port: link loadable modules into the server on WASIX
Last-Update: 2026-09-29

WASIX has no dynamic loader. Build each loadable module as a static
archive for the server to link in, compiling the two entry points the
fmgr interface names under a per-module prefix so that modules do not
collide, and give dfmgr.c a table of them, generated by the build:
dlopen() returns a module's table entry and dlsym() searches its entry
points. A linked-in module has no file, so the scan of loaded modules
by name is its whole identity check. Installing a module installs its
archive where its shared object would have gone.

diff --git a/src/Makefile.shlib b/src/Makefile.shlib
index 3825af5..391c303 100644
--- a/src/Makefile.shlib
+++ b/src/Makefile.shlib
@@ -224,6 +224,17 @@ ifeq ($(SHLIB_EXPORTS),)
   override CXXFLAGS += $(CXXFLAGS_SL_MODULE)
 endif
 
+# On WASIX a loadable module is linked into the server, under entry point
+# names of its own (src/include/port/wasix_static_modules.h).
+ifeq ($(host_os),wasix)
+ifndef soname
+wasix_linked_module = yes
+wasix_module_prefix = wasix_module_$(NAME)_
+override CPPFLAGS += -D_PG_init=$(wasix_module_prefix)_PG_init
+override CPPFLAGS += -DPg_magic_func=$(wasix_module_prefix)Pg_magic_func
+endif
+endif
+
 
 ##
 ## BUILD
@@ -362,7 +373,13 @@ endif # PORTNAME == cygwin || PORTNAME == win32
 ##
 
 .PHONY: install-lib install-lib-static install-lib-shared installdirs-lib
+ifdef wasix_linked_module
+# Install the archive the server links where the shared object would go.
+install-lib: $(stlib) installdirs-lib
+	$(INSTALL_STLIB) $< '$(DESTDIR)$(pkglibdir)/$(stlib)'
+else
 install-lib: install-lib-shared
+endif
 ifdef soname
 install-lib: install-lib-static
 install-lib: install-lib-pc
