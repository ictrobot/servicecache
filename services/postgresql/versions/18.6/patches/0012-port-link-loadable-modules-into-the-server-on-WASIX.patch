@@ -481,6 +510,40 @@ get_loaded_module_details(DynamicFileList *dfptr,
 }
 
 
+#ifdef __wasi__
+
+/*
+ * If this names one of the modules linked into the server, return the
+ * name it was linked in under: "$libdir/plpgsql", "plpgsql.so" and
+ * "plpgsql" all name the module "plpgsql". Return NULL otherwise.
+ */
+static const char *
+wasix_static_module_name(const char *name)
+{
+	const WasixStaticModule *module;
+	size_t		length;
+
+	if (strncmp(name, "$libdir/", 8) == 0)
+		name += 8;
+	if (first_dir_separator(name) != NULL)
+		return NULL;
+
+	length = strlen(name);
+	if (length > strlen(DLSUFFIX) &&
+		strcmp(name + length - strlen(DLSUFFIX), DLSUFFIX) == 0)
+		length -= strlen(DLSUFFIX);
+
+	for (module = wasix_static_modules; module->name != NULL; module++)
+	{
+		if (strncmp(module->name, name, length) == 0 &&
+			module->name[length] == '\0')
+			return module->name;
+	}
+
+	return NULL;
+}
+#endif
+
 /*
  * If name contains a slash, check if the file exists, if so return
  * the name.  Else (no slash) try to expand using search path (see
@@ -499,6 +562,16 @@ expand_dynamic_library_name(const char *name)
 
 	Assert(name);
 
+#ifdef __wasi__
+	/* A linked-in module has no file to find. */
+	{
+		const char *module = wasix_static_module_name(name);
+
+		if (module != NULL)
+			return pstrdup(module);
+	}
+#endif
+
 	have_slash = (first_dir_separator(name) != NULL);
 
 	if (!have_slash)
diff --git a/src/include/port/wasix_static_modules.h b/src/include/port/wasix_static_modules.h
new file mode 100644
index 0000000..87116cb
--- /dev/null
+++ b/src/include/port/wasix_static_modules.h
@@ -0,0 +1,41 @@
+/*-------------------------------------------------------------------------
+ *
+ * wasix_static_modules.h
+ *    the loadable modules linked into a WASIX server binary.
+ *
+ * Copyright (c) 2026, Ethan Jones
+ *
+ * IDENTIFICATION
+ *    src/include/port/wasix_static_modules.h
+ *
+ *-------------------------------------------------------------------------
+ */
+#ifndef WASIX_STATIC_MODULES_H
+#define WASIX_STATIC_MODULES_H
+
+/*
+ * WASIX has no dynamic loader, so loadable modules are linked into the
+ * server. The build generates this table from the archives it links: the
+ * name each module is loaded by and the entry points dlsym() would find
+ * in it. The two names the fmgr interface fixes are compiled under a
+ * per-module prefix (src/Makefile.global.in) and listed here under their
+ * usual names.
+ */
+typedef void (*WasixModuleFunction) (void);
+
+typedef struct WasixStaticModuleSymbol
+{
+	const char *name;
+	WasixModuleFunction address;
+} WasixStaticModuleSymbol;
+
+typedef struct WasixStaticModule
+{
+	const char *name;
+	const WasixStaticModuleSymbol *symbols;
+} WasixStaticModule;
+
+/* Each table ends with an entry whose name is NULL. */
+extern const WasixStaticModule wasix_static_modules[];
+
+#endif							/* WASIX_STATIC_MODULES_H */
diff --git a/src/makefiles/pgxs.mk b/src/makefiles/pgxs.mk
index 039cee3..4d1eddf 100644
--- a/src/makefiles/pgxs.mk
+++ b/src/makefiles/pgxs.mk
@@ -216,7 +216,23 @@ endef
 # end of HEADERS_* stuff
 
 
-all: $(PROGRAM) $(DATA_built) $(HEADER_allbuilt) $(SCRIPTS_built) $(addsuffix $(DLSUFFIX), $(MODULES)) $(addsuffix .control, $(EXTENSION))
+# On WASIX a MODULES entry is built as a static archive for the server to
+# link in (Makefile.global).
+ifeq ($(host_os),wasix)
+module_products = $(addsuffix .a, $(addprefix lib, $(MODULES)))
+
+$(foreach module,$(MODULES),$(eval $(module).o: override CPPFLAGS += $(call wasix_module_cppflags,$(module))))
+
+# The "touch" is for the reason the same rule in Makefile.shlib gives.
+lib%.a: %.o
+	rm -f $@
+	$(AR) $(AROPT) $@ $<
+	touch $@
+else
+module_products = $(addsuffix $(DLSUFFIX), $(MODULES))
+endif
+
+all: $(PROGRAM) $(DATA_built) $(HEADER_allbuilt) $(SCRIPTS_built) $(module_products) $(addsuffix .control, $(EXTENSION))
 
 ifeq ($(with_llvm), yes)
 all: $(addsuffix .bc, $(MODULES)) $(patsubst %.o,%.bc, $(OBJS))
