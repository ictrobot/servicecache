diff --git a/src/backend/utils/fmgr/dfmgr.c b/src/backend/utils/fmgr/dfmgr.c
index b1fb610..2faf3f0 100644
--- a/src/backend/utils/fmgr/dfmgr.c
+++ b/src/backend/utils/fmgr/dfmgr.c
@@ -17,19 +17,39 @@
 #include <sys/stat.h>
 
 #if defined(__wasi__)
+#include "port/wasix_static_modules.h"
+
 #define RTLD_NOW 0
 #define RTLD_GLOBAL 0
 
+/* A handle is a linked-in module's table entry. */
 static void *
 dlopen(const char *filename, int flags)
 {
-	errno = ENOSYS;
+	const WasixStaticModule *module;
+
+	for (module = wasix_static_modules; module->name != NULL; module++)
+	{
+		if (strcmp(module->name, filename) == 0)
+			return unconstify(WasixStaticModule *, module);
+	}
+
+	errno = ENOENT;
 	return NULL;
 }
 
 static void *
 dlsym(void *handle, const char *symbol)
 {
+	const WasixStaticModuleSymbol *entry;
+
+	for (entry = ((const WasixStaticModule *) handle)->symbols;
+		 entry->name != NULL; entry++)
+	{
+		if (strcmp(entry->name, symbol) == 0)
+			return (void *) entry->address;
+	}
+
 	return NULL;
 }
 
