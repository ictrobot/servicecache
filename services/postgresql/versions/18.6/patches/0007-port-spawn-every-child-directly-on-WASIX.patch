 		exit(1); /* message already printed by pclose_check */ \
 } while (0)
+#endif
 
 #define PG_CMD_PUTS(line) \
 do { \
@@ -748,12 +764,185 @@ popen_check(const char *command, const char *mode)
 
 	fflush(NULL);
 	errno = 0;
+#ifdef __wasi__
+	{
+		char	   *command_copy = pg_strdup(command);
+		char	   *argv[128];
+		char	   *src = command_copy;
+		char	   *dst = command_copy;
+		int			argc = 0;
+		int			pipefd[2];
+		int			devnullfd;
+		int			rc;
+		posix_spawn_file_actions_t actions;
+		extern char **environ;
+
+		bool		parse_ok = true;
+
+		Assert(strcmp(mode, "w") == 0);
+
+		/*
+		 * Only initdb's own PG_CMD_OPEN commands reach this: the
+		 * double-quoted backend path, bare option words, and at most one
+		 * trailing >DEVNULL redirection, which the spawn below implements
+		 * by pointing stdout at DEVNULL regardless. There is no shell here
+		 * to give other quoting or redirection its meaning, so anything
+		 * else is refused rather than guessed at.
+		 */
+		while (parse_ok && *src != '\0')
+		{
+			while (*src == ' ' || *src == '\t')
+				src++;
+			if (*src == '\0')
+				break;
+			if (*src == '>')
+			{
+				/*
+				 * The one redirection these commands carry: stdout to
+				 * DEVNULL, which the spawn below implements by pointing
+				 * stdout there. Any other target would have its output
+				 * silently discarded, so refuse it.
+				 */
+				if (strncmp(src + 1, DEVNULL, strlen(DEVNULL)) != 0)
+				{
+					parse_ok = false;
+					break;
+				}
+				src += 1 + strlen(DEVNULL);
+				while (*src == ' ' || *src == '\t')
+					src++;
+				parse_ok = (*src == '\0');
+				break;
+			}
+			if (argc >= lengthof(argv) - 1)
+			{
+				parse_ok = false;
+				break;
+			}
+			if (*src == '"')
+			{
+				char	   *close = strchr(src + 1, '"');
+
+				if (close == NULL ||
+					(close[1] != '\0' && close[1] != ' ' && close[1] != '\t'))
+				{
+					parse_ok = false;
+					break;
+				}
+				argv[argc++] = dst;
+				memmove(dst, src + 1, close - (src + 1));
+				dst += close - (src + 1);
+				*dst++ = '\0';
+				src = close + 1;
+				continue;
+			}
+			argv[argc++] = dst;
+			while (*src != '\0' && *src != ' ' && *src != '\t')
+			{
+				if (*src == '"' || *src == '\'' || *src == '\\' ||
+					*src == '<' || *src == '>' || *src == '\n' || *src == '\r')
+				{
+					parse_ok = false;
+					break;
+				}
+				*dst++ = *src++;
+			}
+			*dst++ = '\0';
+		}
+		argv[argc] = NULL;
+
+		if (!parse_ok || argc == 0)
+		{
+			free(command_copy);
+			errno = EINVAL;
+			pg_log_error("could not parse command \"%s\": unsupported shell syntax", command);
+			return NULL;
+		}
+
+		if (pipe(pipefd) != 0)
+		{
+			free(command_copy);
+			pg_log_error("could not execute command \"%s\": %m", command);
+			return NULL;
+		}
+		devnullfd = open(DEVNULL, O_WRONLY);
+		if (devnullfd < 0)
+		{
+			close(pipefd[0]);
+			close(pipefd[1]);
+			free(command_copy);
+			pg_log_error("could not execute command \"%s\": %m", command);
+			return NULL;
+		}
+
+		rc = posix_spawn_file_actions_init(&actions);
+		if (rc == 0)
+			rc = posix_spawn_file_actions_adddup2(&actions, pipefd[0],
+												  STDIN_FILENO);
+		if (rc == 0)
+			rc = posix_spawn_file_actions_adddup2(&actions, devnullfd,
+												  STDOUT_FILENO);
+		if (rc == 0)
+			rc = posix_spawn_file_actions_addclose(&actions, pipefd[0]);
+		if (rc == 0)
+			rc = posix_spawn_file_actions_addclose(&actions, pipefd[1]);
+		if (rc == 0)
+			rc = posix_spawn_file_actions_addclose(&actions, devnullfd);
+		if (rc == 0)
+			rc = posix_spawnp(&wasix_initdb_child_pid, argv[0], &actions, NULL,
+							  argv, environ);
+		posix_spawn_file_actions_destroy(&actions);
+		close(pipefd[0]);
+		close(devnullfd);
+		free(command_copy);
+		if (rc != 0)
+		{
+			close(pipefd[1]);
+			wasix_initdb_child_pid = -1;
+			errno = rc;
+			pg_log_error("could not execute command \"%s\": %m", command);
+			return NULL;
+		}
+		cmdfd = fdopen(pipefd[1], mode);
+		if (cmdfd == NULL)
+		{
+			close(pipefd[1]);
+			(void) waitpid(wasix_initdb_child_pid, NULL, 0);
+			wasix_initdb_child_pid = -1;
+		}
+	}
+#else
 	cmdfd = popen(command, mode);
+#endif
 	if (cmdfd == NULL)
 		pg_log_error("could not execute command \"%s\": %m", command);
 	return cmdfd;
 }
 
+#ifdef __wasi__
+static int
+wasix_pclose_check(FILE *stream)
+{
+	int			status;
+
+	if (fclose(stream) != 0 ||
+		waitpid(wasix_initdb_child_pid, &status, 0) < 0)
+	{
+		pg_log_error("could not wait for child process: %m");
+		return -1;
+	}
+	wasix_initdb_child_pid = -1;
+	if (status != 0)
+	{
+		char	   *reason = wait_result_to_str(status);
+
+		pg_log_error("%s", reason);
+		free(reason);
+	}
+	return status;
+}
+#endif
