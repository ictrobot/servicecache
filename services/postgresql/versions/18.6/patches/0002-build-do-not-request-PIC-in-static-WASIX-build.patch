Subject: [PATCH 2/8] build: do not request PIC in static WASIX build

WASIX executables are statically linked WebAssembly modules, and the toolchain
does not provide a usable shared-library target. PostgreSQL's *_shlib archives
are also consumed as ordinary static archives in the server, so compile their
duplicate objects without needless PIC on this target.

diff --git a/src/template/linux b/src/template/linux
index ec3302c..4616377 100644
--- a/src/template/linux
+++ b/src/template/linux
@@ -10,7 +10,11 @@ fi
 CPPFLAGS="$CPPFLAGS -D_GNU_SOURCE"
 
 # Extra CFLAGS for code that will go into a shared library
-CFLAGS_SL="-fPIC"
+if test "$host_os" = "wasix" ; then
+  CFLAGS_SL=""
+else
+  CFLAGS_SL="-fPIC"
+fi
 
 # If --enable-profiling is specified, we need -DLINUX_PROFILE
 PLATFORM_PROFILE_FLAGS="-DLINUX_PROFILE"
