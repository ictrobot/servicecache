+static bool WasixShmemCreator = false;
+
+static void
+WasixShmemName(unsigned long id, char *name, Size size)
+{
+	snprintf(name, size, "/postgresql-%lu", id);
+}
 
 static void
 WasixShmemDetach(int status, Datum arg)
 {
+	char		name[64];
+
 	PGSharedMemoryDetach();
+	if (WasixShmemCreator)
+	{
+		WasixShmemName((unsigned long) DatumGetUInt32(arg), name, sizeof(name));
+		if (shm_unlink(name) < 0 && errno != ENOENT)
+			elog(LOG, "could not remove shared memory object \"%s\": %m", name);
+		WasixShmemCreator = false;
+	}
 }
 
 void
@@ -67,6 +88,9 @@ PGSharedMemoryCreate(Size size, PGShmemHeader **shim)
 	PGShmemHeader *hdr;
 	struct stat statbuf;
 	void	   *address;
+	Size		map_size;
+	char		name[64];
+	int			fd;
 
 	if (stat(DataDir, &statbuf) < 0)
 		ereport(FATAL,
@@ -79,13 +103,61 @@ PGSharedMemoryCreate(Size size, PGShmemHeader **shim)
 				 errmsg("huge pages not supported on this platform")));
 
 	Assert(size > MAXALIGN(sizeof(PGShmemHeader)));
-	address = mmap(NULL, size, PROT_READ | PROT_WRITE,
-				   PG_MMAP_FLAGS, -1, 0);
+	if (size > UINT32_MAX - (ICTROBOT_SHM_WASM_PAGE_SIZE - 1))
+		ereport(FATAL,
+				(errmsg("requested shared memory size %zu is too large", size)));
+	map_size = (size + ICTROBOT_SHM_WASM_PAGE_SIZE - 1) &
+		~(ICTROBOT_SHM_WASM_PAGE_SIZE - 1);
+
+	UsedShmemSegID = (unsigned long) getpid();
+	WasixShmemName(UsedShmemSegID, name, sizeof(name));
+	(void) shm_unlink(name);
+	fd = shm_open(name, O_CREAT | O_EXCL | O_RDWR, 0600);
+	if (fd < 0)
+		ereport(FATAL,
+				(errcode_for_file_access(),
+				 errmsg("could not create shared memory object \"%s\": %m", name)));
+	if (ftruncate(fd, map_size) < 0)
+	{
+		int			save_errno = errno;
+
+		close(fd);
+		shm_unlink(name);
+		errno = save_errno;
+		ereport(FATAL,
+				(errcode_for_file_access(),
+				 errmsg("could not size shared memory object \"%s\": %m", name)));
+	}
+
+	address = mmap(NULL, map_size, PROT_READ | PROT_WRITE,
+				   MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
 	if (address == MAP_FAILED)
+	{
+		int			save_errno = errno;
+
+		close(fd);
+		shm_unlink(name);
+		errno = save_errno;
 		ereport(FATAL,
 				(errmsg("could not map anonymous shared memory: %m"),
 				 errhint("Reduce PostgreSQL shared memory usage, for example by "
 						 "reducing shared_buffers or max_connections.")));
+	}
+	if (ictrobot_shm_fd_map(fd, address, map_size, 0) != 0)
+	{
+		int			save_errno = errno;
+
+		munmap(address, map_size);
+		close(fd);
+		shm_unlink(name);
+		errno = save_errno;
+		ereport(FATAL,
+				(errmsg("could not overlay shared memory object \"%s\": %m", name)));
+	}
+	if (close(fd) < 0)
+		ereport(FATAL,
+				(errcode_for_file_access(),
+				 errmsg("could not close shared memory object \"%s\": %m", name)));
 
 	SetConfigOption("huge_pages_status", "off",
