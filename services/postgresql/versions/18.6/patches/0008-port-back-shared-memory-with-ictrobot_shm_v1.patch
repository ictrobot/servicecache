+	UsedShmemSegSize = map_size;
+	WasixShmemCreator = true;
 	*shim = hdr;
 
 	/* Keep the lock-file format expected by CreateDataDirLockFile(). */
@@ -112,31 +184,109 @@ PGSharedMemoryCreate(Size size, PGShmemHeader **shim)
 		AddToDataDirLockFile(LOCK_FILE_LINE_SHMEM_KEY, line);
 	}
 
-	on_shmem_exit(WasixShmemDetach, (Datum) 0);
+	on_shmem_exit(WasixShmemDetach, UInt32GetDatum((uint32) UsedShmemSegID));
 	return hdr;
 }
 
 bool
 PGSharedMemoryIsInUse(unsigned long id1, unsigned long id2)
 {
-	/* The creator PID is our portable segment identifier on WASIX. */
+	char		name[64];
+	int			fd;
+
 	if (id1 == 0)
 		return false;
-	if (kill((pid_t) id1, 0) == 0)
-		return true;
-	return errno != ESRCH;
+	WasixShmemName(id1, name, sizeof(name));
+	fd = shm_open(name, O_RDWR, 0);
+	if (fd < 0)
+		return false;
+	close(fd);
+	return true;
 }
 
+#ifdef EXEC_BACKEND
+
+void
+PGSharedMemoryReAttach(void)
+{
+	PGShmemHeader *hdr;
+	struct stat statbuf;
+	char		name[64];
+	uintptr_t	current_end;
+	uintptr_t	target_end;
+	int			fd;
+
+	Assert(UsedShmemSegAddr != NULL);
+	Assert(IsUnderPostmaster);
+
+	WasixShmemName(UsedShmemSegID, name, sizeof(name));
+	fd = shm_open(name, O_RDWR, 0);
+	if (fd < 0 || fstat(fd, &statbuf) < 0)
+		ereport(FATAL,
+				(errcode_for_file_access(),
+				 errmsg("could not open shared memory object \"%s\": %m", name)));
+	if (statbuf.st_size <= 0 || (uint64) statbuf.st_size > UINT32_MAX ||
+		((uint64) statbuf.st_size & (ICTROBOT_SHM_WASM_PAGE_SIZE - 1)) != 0)
+		ereport(FATAL,
+				(errmsg("shared memory object \"%s\" has invalid size %lld",
+						name, (long long) statbuf.st_size)));
+
+	UsedShmemSegSize = (Size) statbuf.st_size;
+	current_end = (uintptr_t) sbrk(0);
+	target_end = (uintptr_t) UsedShmemSegAddr + UsedShmemSegSize;
+	if (target_end < (uintptr_t) UsedShmemSegAddr ||
+		current_end > (uintptr_t) UsedShmemSegAddr ||
+		(current_end & (ICTROBOT_SHM_WASM_PAGE_SIZE - 1)) != 0 ||
+		((uintptr_t) UsedShmemSegAddr &
+		 (ICTROBOT_SHM_WASM_PAGE_SIZE - 1)) != 0)
+		ereport(FATAL,
+				(errmsg("could not reserve shared memory at address %p", UsedShmemSegAddr)));
+	if (target_end > current_end &&
+		sbrk((intptr_t) (target_end - current_end)) == (void *) -1)
+		ereport(FATAL,
+				(errmsg("could not grow memory to reattach shared memory at %p: %m",
+						UsedShmemSegAddr)));
+
+	if (ictrobot_shm_fd_map(fd, UsedShmemSegAddr, UsedShmemSegSize, 0) != 0)
+		ereport(FATAL,
+				(errmsg("could not reattach shared memory object \"%s\" at %p: %m",
+						name, UsedShmemSegAddr)));
+	if (close(fd) < 0)
+		ereport(FATAL,
+				(errcode_for_file_access(),
+				 errmsg("could not close shared memory object \"%s\": %m", name)));
+
+	hdr = (PGShmemHeader *) UsedShmemSegAddr;
+	if (hdr->magic != PGShmemMagic)
+		ereport(FATAL,
+				(errmsg("shared memory object \"%s\" is not a PostgreSQL segment", name)));
+	dsm_set_control_handle(hdr->dsm_control);
+}
+
+void
+PGSharedMemoryNoReAttach(void)
+{
+	Assert(UsedShmemSegAddr != NULL);
+	Assert(IsUnderPostmaster);
+	UsedShmemSegAddr = NULL;
+	UsedShmemSegID = 0;
+}
+
+#endif
+
 void
 PGSharedMemoryDetach(void)
 {
 	if (UsedShmemSegAddr != NULL)
 	{
+		if (ictrobot_shm_fd_unmap(UsedShmemSegAddr, UsedShmemSegSize) != 0)
+			elog(LOG, "fd_unmap(%p, %zu) failed: %m",
+				 UsedShmemSegAddr, UsedShmemSegSize);
 		if (munmap(UsedShmemSegAddr, UsedShmemSegSize) < 0)
 			elog(LOG, "munmap(%p, %zu) failed: %m",
 				 UsedShmemSegAddr, UsedShmemSegSize);
 		UsedShmemSegAddr = NULL;
 		UsedShmemSegSize = 0;
-		UsedShmemSegID = 0;
 	}
+	UsedShmemSegID = 0;
 }
