@@ -248,6 +255,106 @@ uuid_generate_v35_internal(int mode, pg_uuid_t *ns, text *name)
 
 #else							/* !HAVE_UUID_OSSP */
 
+#ifdef HAVE_UUID_BUILTIN
+
+/* The Unix epoch in 100-nanosecond intervals since 1582-10-15. */
+#define UUID_V1_EPOCH_OFFSET	UINT64CONST(0x01B21DD213814000)
+
+/* Format sixteen bytes as the 36-character 8-4-4-4-12 string. */
+static void
+uuid_to_hex_string(const unsigned char *uu, char *str)
+{
+	static const char hexdigits[] = "0123456789abcdef";
+	int			i;
+
+	for (i = 0; i < UUID_LEN; i++)
+	{
+		if (i == 4 || i == 6 || i == 8 || i == 10)
+			*str++ = '-';
+		*str++ = hexdigits[uu[i] >> 4];
+		*str++ = hexdigits[uu[i] & 0x0F];
+	}
+	*str = '\0';
+}
+
+static void
+uuid_random_bytes(unsigned char *buf, size_t len)
+{
+	if (!pg_strong_random(buf, len))
+		ereport(ERROR,
+				(errcode(ERRCODE_INTERNAL_ERROR),
+				 errmsg("could not generate random values")));
+}
+
+/*
+ * A version 1 UUID as RFC 4122 section 4.2.2 lays it out.  With no MAC
+ * address or state file, the node (multicast bit set, per section 4.5) and
+ * clock sequence are random and kept for the life of the process, as
+ * libuuid does; a call in the same tick as the last takes the next one.
+ */
+static void
+uuid_make_v1(unsigned char *uu)
+{
+	static bool initialized = false;
+	static unsigned char node[6];
+	static uint16 clock_seq;
+	static uint64 last_ts = 0;
+	struct timeval tv;
+	uint64		ts;
+
+	if (!initialized)
+	{
+		unsigned char rnd[8];
+
+		uuid_random_bytes(rnd, sizeof(rnd));
+		clock_seq = (((uint16) rnd[0] << 8) | rnd[1]) & 0x3FFF;
+		memcpy(node, rnd + 2, sizeof(node));
+		node[0] |= 0x01;
+		initialized = true;
+	}
+
+	gettimeofday(&tv, NULL);
+	ts = (uint64) tv.tv_sec * UINT64CONST(10000000) +
+		(uint64) tv.tv_usec * 10 + UUID_V1_EPOCH_OFFSET;
+
+	if (ts <= last_ts)
+	{
+		/* a clock that went backwards asks for a new clock sequence */
+		if (ts < last_ts)
+			clock_seq = (clock_seq + 1) & 0x3FFF;
+		ts = last_ts + 1;
+	}
+	last_ts = ts;
+
+	/* time_low, then time_mid, then time_hi_and_version with version 1 */
+	uu[0] = (unsigned char) (ts >> 24);
+	uu[1] = (unsigned char) (ts >> 16);
+	uu[2] = (unsigned char) (ts >> 8);
+	uu[3] = (unsigned char) ts;
+	uu[4] = (unsigned char) (ts >> 40);
+	uu[5] = (unsigned char) (ts >> 32);
+	uu[6] = (unsigned char) (((ts >> 56) & 0x0F) | 0x10);
+	uu[7] = (unsigned char) (ts >> 48);
+
+	/* the clock sequence, behind the variant bits */
+	uu[8] = (unsigned char) ((clock_seq >> 8) | 0x80);
+	uu[9] = (unsigned char) clock_seq;
+
+	memcpy(uu + 10, node, sizeof(node));
+}
+
+/* A version 4 UUID: random bytes with the version and variant set. */
+static void
+uuid_make_v4(unsigned char *uu)
+{
+	uuid_random_bytes(uu, UUID_LEN);
+
+	uu[6] = (uu[6] & 0x0F) | 0x40;
+	uu[8] = (uu[8] & 0x3F) | 0x80;
+}
+
+#endif							/* HAVE_UUID_BUILTIN */
+
 static Datum
 uuid_generate_internal(int v, unsigned char *ns, const char *ptr, int len)
 {
@@ -261,7 +368,20 @@ uuid_generate_internal(int v, unsigned char *ns, const char *ptr, int len)
 
 		case 1:					/* time/node-based uuids */
 			{
-#ifdef HAVE_UUID_E2FS
+#if defined(HAVE_UUID_BUILTIN)
+				unsigned char uu[UUID_LEN];
+
+				uuid_make_v1(uu);
+				uuid_to_hex_string(uu, strbuf);
+
+				/*
+				 * PTR, if set, replaces the trailing characters of the uuid;
+				 * this is to support v1mc, where a random multicast MAC is
+				 * used instead of the physical one
