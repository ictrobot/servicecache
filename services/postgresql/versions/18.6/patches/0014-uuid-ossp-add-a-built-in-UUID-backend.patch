+				if (ptr && len <= 36)
+					strcpy(strbuf + (36 - len), ptr);
+#elif defined(HAVE_UUID_E2FS)
 				uuid_t		uu;
 
 				uuid_generate_time(uu);
@@ -371,7 +491,11 @@ uuid_generate_internal(int v, unsigned char *ns, const char *ptr, int len)
 				UUID_TO_NETWORK(uu);
 				UUID_V3_OR_V5(uu, v);
 
-#ifdef HAVE_UUID_E2FS
+#if defined(HAVE_UUID_BUILTIN)
