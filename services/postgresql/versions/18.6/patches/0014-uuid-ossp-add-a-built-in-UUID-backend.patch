+				UUID_TO_LOCAL(uu);
+				uuid_to_hex_string((unsigned char *) &uu, strbuf);
+#elif defined(HAVE_UUID_E2FS)
 				/* uuid_unparse expects local order */
 				UUID_TO_LOCAL(uu);
 				uuid_unparse((unsigned char *) &uu, strbuf);
@@ -395,7 +519,12 @@ uuid_generate_internal(int v, unsigned char *ns, const char *ptr, int len)
 		case 4:					/* random uuid */
 		default:
 			{
-#ifdef HAVE_UUID_E2FS
+#if defined(HAVE_UUID_BUILTIN)
+				unsigned char uu[UUID_LEN];
+
+				uuid_make_v4(uu);
+				uuid_to_hex_string(uu, strbuf);
+#elif defined(HAVE_UUID_E2FS)
 				uuid_t		uu;
 
 				uuid_generate_random(uu);
@@ -492,6 +621,19 @@ uuid_generate_v1mc(PG_FUNCTION_ARGS)
 {
 #ifdef HAVE_UUID_OSSP
 	char	   *buf = NULL;
+#elif defined(HAVE_UUID_BUILTIN)
+	char		buf[14];
+	unsigned char node[6];
+
+	uuid_random_bytes(node, sizeof(node));
+
+	/* set IEEE802 multicast and local-admin bits */
+	node[0] |= 0x03;
+
+	snprintf(buf, sizeof(buf), "-%02x%02x%02x%02x%02x%02x",
+			 (unsigned) node[0], (unsigned) node[1],
+			 (unsigned) node[2], (unsigned) node[3],
+			 (unsigned) node[4], (unsigned) node[5]);
 #elif defined(HAVE_UUID_E2FS)
 	char		strbuf[40];
 	char	   *buf;
