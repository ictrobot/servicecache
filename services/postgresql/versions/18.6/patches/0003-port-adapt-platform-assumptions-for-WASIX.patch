diff --git a/src/port/path.c b/src/port/path.c
index 7f13940..3674653 100644
--- a/src/port/path.c
+++ b/src/port/path.c
@@ -918,7 +918,26 @@ make_absolute_path(const char *path)
 void
 get_share_path(const char *my_exec_path, char *ret_path)
 {
+#ifdef __wasi__
+	char	   *separator;
+
+	if (strncmp(my_exec_path, "/bin/", 5) == 0 ||
+		strncmp(my_exec_path, "/usr/bin/", 9) == 0)
+	{
+		strlcpy(ret_path, "/share", MAXPGPATH);
+		return;
+	}
+
+	strlcpy(ret_path, my_exec_path, MAXPGPATH);
+	separator = last_dir_separator(ret_path);
+	if (separator != NULL)
+		separator[1] = '\0';
+	else
+		ret_path[0] = '\0';
+	strlcat(ret_path, "share", MAXPGPATH);
+#else
 	make_relative_path(ret_path, PGSHAREDIR, PGBINDIR, my_exec_path);
+#endif
 }
 
 /*
@@ -972,7 +991,18 @@ get_lib_path(const char *my_exec_path, char *ret_path)
 void
 get_pkglib_path(const char *my_exec_path, char *ret_path)
 {
+#ifdef __wasi__
+	char	   *separator;
+
+	strlcpy(ret_path, my_exec_path, MAXPGPATH);
+	separator = last_dir_separator(ret_path);
+	if (separator != NULL)
+		*separator = '\0';
+	else
+		strlcpy(ret_path, ".", MAXPGPATH);
+#else
 	make_relative_path(ret_path, PKGLIBDIR, PGBINDIR, my_exec_path);
+#endif
 }
 
