#!/usr/bin/env python3
"""Test adapter for PostgreSQL, spoken over its version 3 wire protocol."""

import importlib.machinery
import importlib.util
import json
import os
import socket
import struct
import sys

_spec = importlib.util.spec_from_loader(
    "postgresql_probe",
    importlib.machinery.SourceFileLoader(
        "postgresql_probe",
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "postgresql-probe.py"),
    ),
)
probe = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(probe)


class Session:
    def __init__(self, host, port):
        self.sock = socket.create_connection((host, int(port)), timeout=15)
        startup = (
            b"user\0postgres\0database\0postgres\0client_encoding\0UTF8\0\0"
        )
        self.sock.sendall(struct.pack("!II", len(startup) + 8, 196608) + startup)
        probe.wait_ready(self.sock)

    def rows(self, sql):
        return probe.query(self.sock, sql)

    def close(self):
        try:
            self.sock.sendall(probe.packet(b"X", b""))
        finally:
            self.sock.close()


def expect(actual, expected, what):
    if actual != expected:
        raise SystemExit(f"{what}: expected {expected!r}, got {actual!r}")


def expect_parallel_rows(session, sql, expected, workers, what):
    expect(session.rows(sql), expected, what)
    _planned, launched = parallel_worker_counts(session, sql, what)
    if launched < workers:
        raise SystemExit(
            f"{what}: expected {workers} workers to launch, got {launched}"
        )


def parallel_worker_counts(session, sql, what):
    explained = session.rows(f"EXPLAIN (ANALYZE, FORMAT JSON) {sql}")
    plan = json.loads(explained[0][0])[0]["Plan"]
    gathers = []

    def visit(node):
        if node["Node Type"] in ("Gather", "Gather Merge"):
            gathers.append(node)
        for child in node.get("Plans", []):
            visit(child)

    visit(plan)
    if not gathers:
        raise SystemExit(f"{what}: planner did not produce a Gather: {plan!r}")
    planned = max(node.get("Workers Planned", 0) for node in gathers)
    launched = max(node.get("Workers Launched", 0) for node in gathers)
    return planned, launched


def expect_parallel_capacity_limited(session, sql, expected, requested, what):
    expect(session.rows(sql), expected, what)
    planned, launched = parallel_worker_counts(session, sql, what)
    if planned < requested:
        raise SystemExit(
            f"{what}: expected {requested} workers to be planned, got {planned}"
        )
    if not 0 < launched < requested:
        raise SystemExit(
            f"{what}: expected a partial launch below {requested} workers, "
            f"got {launched}"
        )


def recipe():
    print("CREATE TABLE adapter_probe (id integer PRIMARY KEY, value text NOT NULL);")
    print("INSERT INTO adapter_probe VALUES (1, 'recipe-value');")
    print("CREATE TABLE parallel_probe AS SELECT id FROM generate_series(1, 20000) id;")
    print("ANALYZE parallel_probe;")


def check_initialized(host, port):
    session = Session(host, port)
    version = session.rows("SELECT current_setting('server_version')")[0][0]
    if not version.startswith("18.6"):
        raise SystemExit(f"unexpected server version: {version}")
    expect(
        session.rows(
            "SELECT id::text, value FROM adapter_probe WHERE id < 1000 ORDER BY id"
        ),
        [["1", "recipe-value"]],
        "initializer row",
    )
    session.rows(
        "SET max_parallel_workers_per_gather = 4; "
        "SET min_parallel_table_scan_size = 0; "
        "SET parallel_setup_cost = 0; "
        "SET parallel_tuple_cost = 0; "
        "SET parallel_leader_participation = off; "
        "SET enable_indexscan = off; "
        "SET enable_indexonlyscan = off; "
        "SET enable_bitmapscan = off; "
        "ALTER TABLE parallel_probe SET (parallel_workers = 4)"
    )
    expect_parallel_rows(
        session,
        "SELECT (id % 4)::text, sum(id)::text "
        "FROM parallel_probe GROUP BY id % 4 ORDER BY id % 4",
        [
            ["0", "50010000"],
            ["1", "49995000"],
            ["2", "50000000"],
            ["3", "50005000"],
        ],
        4,
        "parallel aggregate",
    )
    expect_parallel_rows(
        session,
        "SELECT id::text FROM parallel_probe "
        "WHERE id IN (1, 5000, 10000, 15000, 20000) "
        "ORDER BY parallel_probe.id",
        [["1"], ["5000"], ["10000"], ["15000"], ["20000"]],
        4,
        "parallel filtered scan",
    )
    worker_capacity = int(session.rows("SHOW max_parallel_workers")[0][0])
    requested_workers = worker_capacity * 2
    session.rows(
        f"SET max_parallel_workers_per_gather = {requested_workers}; "
        f"ALTER TABLE parallel_probe SET (parallel_workers = {requested_workers})"
    )
    expect_parallel_capacity_limited(
        session,
        "SELECT (id % 4)::text, sum(id)::text "
        "FROM parallel_probe GROUP BY id % 4 ORDER BY id % 4",
        [
            ["0", "50010000"],
            ["1", "49995000"],
            ["2", "50000000"],
            ["3", "50005000"],
        ],
        requested_workers,
        "capacity-limited parallel aggregate",
    )
    expect(
        session.rows("SELECT 'still responsive'"),
        [["still responsive"]],
        "post-saturation health query",
    )
    session.close()


def check_working(host, port):
    first = Session(host, port)
    first.rows("INSERT INTO adapter_probe VALUES (2, 'first-connection')")
    first.close()
    second = Session(host, port)
    expect(
        second.rows("SELECT value FROM adapter_probe WHERE id = 2"),
        [["first-connection"]],
        "committed row",
    )
    second.close()


def diverge(host, port, tag):
    session = Session(host, port)
    session.rows(
        f"INSERT INTO adapter_probe VALUES ({1000 + int(tag)}, 'clone-{int(tag)}')"
    )
    session.close()


def check_diverged(host, port, tag):
    session = Session(host, port)
    rows = session.rows("SELECT id::text, value FROM adapter_probe WHERE id >= 1000")
    expect(rows, [[str(1000 + int(tag)), f"clone-{int(tag)}"]], "clone row")
    session.close()


def blocking_request(host, port):
    session = Session(host, port)
    try:
        print(f"pg_sleep ended with {session.rows('SELECT pg_sleep(3)')!r}")
    except (OSError, RuntimeError) as error:
        print(f"pg_sleep ended with {error}")
    finally:
        session.close()


def main(argv):
    if not argv:
        raise SystemExit(__doc__)
    verb, args = argv[0], argv[1:]
    if verb == "recipe":
        return recipe()
    if verb == "check-initialized":
        return check_initialized(*args)
    if verb == "check-working":
        return check_working(*args)
    if verb == "diverge":
        return diverge(*args)
    if verb == "check-diverged":
        return check_diverged(*args)
    if verb == "blocking-request":
        return blocking_request(*args)
    raise SystemExit(f"unknown verb {verb}\n{__doc__}")


if __name__ == "__main__":
    main(sys.argv[1:])
