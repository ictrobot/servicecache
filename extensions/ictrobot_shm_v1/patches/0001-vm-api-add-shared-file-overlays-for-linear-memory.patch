+        _file: &std::fs::File,
+        _file_offset: u64,
+    ) -> Result<(), String> {
+        Err("shared file overlays are not supported on Windows".to_string())
+    }
+
+    #[cfg(target_os = "windows")]
+    pub fn restore_private_anonymous(&mut self, _start: usize, _len: usize) -> Result<(), String> {
+        Err("shared file overlays are not supported on Windows".to_string())
+    }
