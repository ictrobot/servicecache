+    /// Replace a range of this allocation with a shared file mapping.
+    ///
+    /// The caller must ensure that the range is not concurrently accessed while
+    /// the mapping is being replaced.
+    #[cfg(not(target_os = "windows"))]
+    pub fn overlay_shared_file(
+        &mut self,
+        start: usize,
+        len: usize,
+        file: &std::fs::File,
+        file_offset: u64,
+    ) -> Result<(), String> {
+        use std::os::fd::AsRawFd;
+
+        self.validate_overlay_range(start, len, file_offset)?;
+        let file_offset = libc::off_t::try_from(file_offset)
+            .map_err(|_| "shared mapping file offset does not fit off_t".to_string())?;
+        let address = unsafe { (self.ptr as *mut u8).add(start) };
+        let mapped = unsafe {
+            libc::mmap(
+                address.cast(),
+                len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_FIXED | libc::MAP_SHARED,
+                file.as_raw_fd(),
+                file_offset,
+            )
+        };
+        if mapped == libc::MAP_FAILED {
+            return Err(io::Error::last_os_error().to_string());
+        }
+        debug_assert_eq!(mapped, address.cast());
+        self.overlay_count += 1;
+        Ok(())
+    }
+
+    /// Whether any shared file overlay is live inside this allocation.
+    pub fn has_overlays(&self) -> bool {
+        self.overlay_count > 0
+    }
+
+    /// Replace a range of this allocation with fresh private anonymous pages.
+    ///
+    /// The caller must ensure that the range is not concurrently accessed while
+    /// the mapping is being replaced.
+    #[cfg(not(target_os = "windows"))]
+    pub fn restore_private_anonymous(&mut self, start: usize, len: usize) -> Result<(), String> {
+        self.validate_overlay_range(start, len, 0)?;
+        let address = unsafe { (self.ptr as *mut u8).add(start) };
+        let mapped = unsafe {
+            libc::mmap(
+                address.cast(),
+                len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_FIXED | libc::MAP_PRIVATE | libc::MAP_ANON,
+                -1,
+                0,
+            )
+        };
+        if mapped == libc::MAP_FAILED {
+            return Err(io::Error::last_os_error().to_string());
+        }
+        debug_assert_eq!(mapped, address.cast());
+        self.overlay_count = self.overlay_count.saturating_sub(1);
+        Ok(())
+    }
+
+    #[cfg(not(target_os = "windows"))]
+    fn validate_overlay_range(
+        &self,
+        start: usize,
+        len: usize,
+        file_offset: u64,
+    ) -> Result<(), String> {
+        let page_size = region::page::size();
+        if len == 0 {
+            return Err("shared mapping length must not be zero".to_string());
+        }
+        if start % page_size != 0 || len % page_size != 0 {
+            return Err("shared mapping range is not host-page aligned".to_string());
+        }
+        if file_offset % page_size as u64 != 0 {
+            return Err("shared mapping file offset is not host-page aligned".to_string());
+        }
+        let end = start
+            .checked_add(len)
+            .ok_or_else(|| "shared mapping range overflows".to_string())?;
+        if end > self.total_size {
+            return Err("shared mapping range is outside the allocation".to_string());
+        }
+        Ok(())
+    }
+
+    #[cfg(target_os = "windows")]
