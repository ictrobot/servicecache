+#[cfg(all(test, not(target_os = "windows")))]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::FileExt;
+
+    #[test]
+    fn shared_file_overlay_is_visible_between_allocations() {
+        let page_size = region::page::size();
+        let file = tempfile::tempfile().unwrap();
+        file.set_len(page_size as u64).unwrap();
+        file.write_all_at(&[7], 0).unwrap();
+
+        let mut first = Mmap::with_at_least(page_size).unwrap();
+        let mut second = Mmap::with_at_least(page_size).unwrap();
+        first.overlay_shared_file(0, page_size, &file, 0).unwrap();
+        second.overlay_shared_file(0, page_size, &file, 0).unwrap();
+
+        assert_eq!(first.as_slice()[0], 7);
+        first.as_mut_slice()[1] = 42;
+        assert_eq!(second.as_slice()[1], 42);
+
+        first.restore_private_anonymous(0, page_size).unwrap();
+        assert_eq!(first.as_slice()[0], 0);
+        second.as_mut_slice()[0] = 99;
+        assert_eq!(first.as_slice()[0], 0);
+    }
+}
