diff --git a/lib/wasix/src/syscalls/ictrobot_shm.rs b/lib/wasix/src/syscalls/ictrobot_shm.rs
new file mode 100644
index 0000000..086af06
--- /dev/null
+++ b/lib/wasix/src/syscalls/ictrobot_shm.rs
@@ -0,0 +1,156 @@
+use super::*;
+use crate::fs::shared_memory::SharedMemoryObject;
+
+const WASM_PAGE_SIZE: u64 = 65_536;
+
+#[derive(Clone)]
+pub(crate) enum FutexOwner {
+    Process(Arc<WasiState>),
+    Shared(Arc<SharedMemoryObject>),
+}
+
+impl FutexOwner {
+    pub(crate) fn with_state<R>(&self, f: impl FnOnce(&mut state::WasiFutexState) -> R) -> R {
+        match self {
+            Self::Process(state) => f(&mut state.futexs.lock().unwrap()),
+            Self::Shared(object) => f(&mut object.futexs.lock().unwrap()),
+        }
+    }
+}
+
+pub(crate) fn futex_owner(env: &WasiEnv, address: u64) -> (FutexOwner, u64) {
+    // One relaxed load on the hot path: a process with no mappings, which
+    // is every process that never called fd_map, resolves locally without
+    // taking any lock.
+    let mappings = &env.process.shared_memory_mappings;
+    if !mappings.is_empty() {
+        let shared = mappings.read(|mappings| {
+            mappings
+                .iter()
+                .find(|mapping| {
+                    let Some(end) = address.checked_add(size_of::<u32>() as u64) else {
+                        return false;
+                    };
+                    let range = mapping.range();
+                    range.start <= address && end <= range.end
+                })
+                .map(|mapping| {
+                    (
+                        mapping.object.clone(),
+                        mapping.file_offset + (address - mapping.address),
+                    )
+                })
+        });
+        if let Some((object, offset)) = shared {
+            return (FutexOwner::Shared(object), offset);
+        }
+    }
+    (FutexOwner::Process(env.state.clone()), address)
+}
+
+pub(crate) fn fd_map32(
+    ctx: FunctionEnvMut<'_, WasiEnv>,
+    fd: u32,
+    address: u32,
+    len: u32,
+    file_offset: u64,
+) -> Errno {
+    fd_map(ctx, fd, u64::from(address), u64::from(len), file_offset)
+}
+
+fn fd_map(
+    mut ctx: FunctionEnvMut<'_, WasiEnv>,
+    fd: u32,
+    address: u64,
+    len: u64,
+    file_offset: u64,
+) -> Errno {
+    if len == 0
+        || address % WASM_PAGE_SIZE != 0
+        || len % WASM_PAGE_SIZE != 0
+        || file_offset % WASM_PAGE_SIZE != 0
+    {
+        return Errno::Inval;
+    }
+    let end = match address.checked_add(len) {
+        Some(end) => end,
+        None => return Errno::Overflow,
+    };
+
+    let (memory, object, process_mappings) = {
+        let env = ctx.data();
+        let Some(memory) = env.try_memory_clone() else {
+            return Errno::Fault;
+        };
+        let object = match env.state.fs.shared_memory_object(fd) {
+            Ok(object) => object,
+            Err(error) => return error,
+        };
+        (memory, object, env.process.shared_memory_mappings.clone())
+    };
+
+    // The write lock covers the whole update, so concurrent maps and
+    // unmaps of overlapping ranges exclude each other.
+    process_mappings.write(|mappings| {
+        if mappings.iter().any(|mapping| {
+            let range = mapping.range();
+            address < range.end && range.start < end
+        }) {
+            return Errno::Exist;
+        }
+
+        let mut mapping = match object.register_mapping(file_offset, len) {
+            Ok(mapping) => mapping,
+            Err(error) => return error,
+        };
+        let file = match object.try_clone_file() {
+            Ok(file) => file,
+            Err(error) => return error,
+        };
+        if memory
+            .overlay_shared_file(&mut ctx, address, len, &file, file_offset)
+            .is_err()
+        {
+            return Errno::Inval;
+        }
+
+        mapping.address = address;
+        mappings.push(mapping);
+        Errno::Success
+    })
+}
+
+pub(crate) fn fd_unmap32(ctx: FunctionEnvMut<'_, WasiEnv>, address: u32, len: u32) -> Errno {
+    fd_unmap(ctx, u64::from(address), u64::from(len))
+}
+
+fn fd_unmap(mut ctx: FunctionEnvMut<'_, WasiEnv>, address: u64, len: u64) -> Errno {
+    if len == 0 || address % WASM_PAGE_SIZE != 0 || len % WASM_PAGE_SIZE != 0 {
+        return Errno::Inval;
+    }
+
+    let (memory, process_mappings) = {
+        let env = ctx.data();
+        let Some(memory) = env.try_memory_clone() else {
+            return Errno::Fault;
+        };
+        (memory, env.process.shared_memory_mappings.clone())
+    };
+    process_mappings.write(|mappings| {
+        let Some(index) = mappings
+            .iter()
+            .position(|mapping| mapping.address == address && mapping.len == len)
+        else {
+            return Errno::Inval;
+        };
+
+        if memory
+            .restore_private_anonymous(&mut ctx, address, len)
+            .is_err()
+        {
+            return Errno::Inval;
+        }
+        mappings.swap_remove(index);
+        Errno::Success
+    })
+}
