--- /dev/null
+++ b/lib/wasix/src/fs/shared_memory.rs
@@ -0,0 +1,597 @@
+use std::{
+    collections::HashMap,
+    ffi::CString,
+    io,
+    ops::Range,
+    os::fd::FromRawFd,
+    path::{Component, Path, PathBuf},
+    pin::Pin,
+    sync::{
+        Arc, Mutex, RwLock,
+        atomic::{AtomicU64, Ordering},
+    },
+    task::{Context, Poll},
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+use futures::future::BoxFuture;
+use tokio::io::{AsyncRead, AsyncSeek, AsyncWrite, ReadBuf};
+use virtual_fs::{
+    DirEntry, FileOpener, FileSystem, FileType, FsError, Metadata, OpenOptions, OpenOptionsConfig,
+    ReadDir, VirtualFile,
+};
+use wasmer_wasix_types::wasi::{Errno, Rights};
+
+use super::{Kind, WasiFs};
+use crate::state::WasiFutexState;
+
+#[derive(Debug)]
+pub(crate) struct SharedMemoryObject {
+    file: std::fs::File,
+    created: u64,
+    accessed: AtomicU64,
+    modified: AtomicU64,
+    next_mapping: AtomicU64,
+    mappings: Mutex<HashMap<u64, Range<u64>>>,
+    pub(crate) futexs: Mutex<WasiFutexState>,
+    io_lock: Mutex<()>,
+}
+
+impl SharedMemoryObject {
+    fn new() -> Result<Self, FsError> {
+        #[cfg(target_os = "linux")]
+        let file = {
+            let name = CString::new("ictrobot-shm-v1").unwrap();
+            let fd = unsafe { libc::memfd_create(name.as_ptr(), libc::MFD_CLOEXEC) };
+            if fd < 0 {
+                return Err(io::Error::last_os_error().into());
+            }
+            unsafe { std::fs::File::from_raw_fd(fd) }
+        };
+
+        #[cfg(not(target_os = "linux"))]
+        return Err(FsError::Unsupported);
+
+        #[cfg(target_os = "linux")]
+        {
+            let now = now_nanos();
+            Ok(Self {
+                file,
+                created: now,
+                accessed: AtomicU64::new(now),
+                modified: AtomicU64::new(now),
+                next_mapping: AtomicU64::new(1),
+                mappings: Mutex::new(HashMap::new()),
+                futexs: Mutex::new(WasiFutexState::default()),
+                io_lock: Mutex::new(()),
+            })
+        }
+    }
+
+    pub(crate) fn try_clone_file(&self) -> Result<std::fs::File, Errno> {
+        self.file.try_clone().map_err(|_| Errno::Io)
+    }
+
+    pub(crate) fn register_mapping(
+        self: &Arc<Self>,
+        file_offset: u64,
+        len: u64,
+    ) -> Result<SharedMemoryMapping, Errno> {
+        let end = file_offset.checked_add(len).ok_or(Errno::Overflow)?;
+        if len == 0 || end > self.size() {
+            return Err(Errno::Inval);
+        }
+        let id = self.next_mapping.fetch_add(1, Ordering::Relaxed);
+        self.mappings.lock().unwrap().insert(id, file_offset..end);
+        Ok(SharedMemoryMapping {
+            object: self.clone(),
+            id,
+            address: 0,
+            len,
+            file_offset,
+        })
+    }
+
+    fn unregister_mapping(&self, id: u64) {
+        self.mappings.lock().unwrap().remove(&id);
+    }
+
+    fn size(&self) -> u64 {
+        self.file.metadata().map(|m| m.len()).unwrap_or(0)
+    }
+
+    fn set_len(&self, new_size: u64) -> Result<(), FsError> {
+        if self
+            .mappings
+            .lock()
+            .unwrap()
+            .values()
+            .any(|range| range.end > new_size)
+        {
+            return Err(FsError::PermissionDenied);
+        }
+        self.file.set_len(new_size)?;
+        self.modified.store(now_nanos(), Ordering::Relaxed);
+        Ok(())
+    }
+
+    fn metadata(&self) -> Metadata {
+        Metadata {
+            ft: FileType::new_file(),
+            accessed: self.accessed.load(Ordering::Relaxed),
+            created: self.created,
+            modified: self.modified.load(Ordering::Relaxed),
+            len: self.size(),
+        }
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct SharedMemoryMapping {
+    pub(crate) object: Arc<SharedMemoryObject>,
+    id: u64,
+    pub(crate) address: u64,
+    pub(crate) len: u64,
+    pub(crate) file_offset: u64,
+}
+
+impl SharedMemoryMapping {
+    pub(crate) fn range(&self) -> Range<u64> {
+        self.address..self.address + self.len
+    }
+
+    pub(crate) fn fork_clone(&self) -> Self {
+        let mut mapping = self
+            .object
+            .register_mapping(self.file_offset, self.len)
+            .expect("a live shared mapping must remain within its backing object");
+        mapping.address = self.address;
+        mapping
+    }
+
+    pub(crate) fn descriptor(&self) -> (Arc<SharedMemoryObject>, u64, u64, u64) {
+        (
+            self.object.clone(),
+            self.address,
+            self.len,
+            self.file_offset,
+        )
+    }
+}
+
+impl Drop for SharedMemoryMapping {
+    fn drop(&mut self) {
+        self.object.unregister_mapping(self.id);
+    }
+}
+
+#[derive(Debug, Default, Clone)]
+pub(crate) struct SharedMemoryFileSystem {
+    files: Arc<RwLock<HashMap<String, Arc<SharedMemoryObject>>>>,
+}
+
+impl SharedMemoryFileSystem {
+    pub(crate) fn new() -> Self {
+        Self::default()
+    }
+
+    fn name(path: &Path) -> Result<Option<String>, FsError> {
+        let mut name = None;
+        for component in path.components() {
+            match component {
+                Component::RootDir | Component::CurDir => {}
+                Component::Normal(part) if name.is_none() => {
+                    name = Some(part.to_string_lossy().into_owned());
+                }
+                _ => return Err(FsError::InvalidInput),
+            }
+        }
+        if name.as_deref() == Some("") {
+            return Err(FsError::InvalidInput);
+        }
+        Ok(name)
+    }
+
+    fn remove_named_object(&self, name: &str, expected: Option<&Arc<SharedMemoryObject>>) -> bool {
+        let mut files = self.files.write().unwrap();
+        match (files.get(name), expected) {
+            (Some(found), Some(expected)) if !Arc::ptr_eq(found, expected) => false,
+            (Some(_), _) => {
+                files.remove(name);
+                true
+            }
+            (None, _) => false,
+        }
+    }
+}
+
+impl FileOpener for SharedMemoryFileSystem {
+    fn open(
+        &self,
+        path: &Path,
+        conf: &OpenOptionsConfig,
+    ) -> virtual_fs::Result<Box<dyn VirtualFile + Send + Sync + 'static>> {
+        let name = Self::name(path)?.ok_or(FsError::NotAFile)?;
+        if !conf.read && !conf.write {
+            return Err(FsError::PermissionDenied);
+        }
+
+        let object = {
+            let mut files = self.files.write().unwrap();
+            if let Some(object) = files.get(&name) {
+                if conf.create_new {
+                    return Err(FsError::AlreadyExists);
+                }
+                object.clone()
+            } else {
+                if !conf.create && !conf.create_new {
+                    return Err(FsError::EntryNotFound);
+                }
+                let object = Arc::new(SharedMemoryObject::new()?);
+                files.insert(name.clone(), object.clone());
+                object
+            }
+        };
+
+        if conf.truncate {
+            if !conf.write {
+                return Err(FsError::PermissionDenied);
+            }
+            object.set_len(0)?;
+        }
+
+        let cursor = if conf.append { object.size() } else { 0 };
+        Ok(Box::new(SharedMemoryFileHandle {
+            object,
+            files: self.files.clone(),
+            name,
+            readable: conf.read,
+            writable: conf.write,
+            append: conf.append,
+            cursor,
+            pending_seek: None,
+        }))
+    }
+}
+
+impl FileSystem for SharedMemoryFileSystem {
+    fn readlink(&self, _path: &Path) -> virtual_fs::Result<PathBuf> {
+        Err(FsError::InvalidInput)
+    }
+
+    fn read_dir(&self, path: &Path) -> virtual_fs::Result<ReadDir> {
+        if Self::name(path)?.is_some() {
+            return Err(FsError::NotAFile);
+        }
+        let mut entries = self
+            .files
+            .read()
+            .unwrap()
+            .iter()
+            .map(|(name, object)| DirEntry {
+                path: Path::new("/").join(name),
+                metadata: Ok(object.metadata()),
+            })
+            .collect::<Vec<_>>();
+        entries.sort_by(|a, b| a.path.cmp(&b.path));
+        Ok(ReadDir::new(entries))
+    }
+
+    fn create_dir(&self, _path: &Path) -> virtual_fs::Result<()> {
+        Err(FsError::PermissionDenied)
+    }
+
+    fn remove_dir(&self, _path: &Path) -> virtual_fs::Result<()> {
+        Err(FsError::PermissionDenied)
+    }
+
+    fn rename<'a>(
+        &'a self,
+        _from: &'a Path,
+        _to: &'a Path,
+    ) -> BoxFuture<'a, virtual_fs::Result<()>> {
+        Box::pin(async { Err(FsError::Unsupported) })
+    }
+
+    fn metadata(&self, path: &Path) -> virtual_fs::Result<Metadata> {
+        match Self::name(path)? {
+            None => Ok(Metadata {
+                ft: FileType::new_dir(),
+                accessed: 0,
+                created: 0,
+                modified: 0,
+                len: 0,
+            }),
+            Some(name) => self
+                .files
+                .read()
+                .unwrap()
+                .get(&name)
+                .map(|object| object.metadata())
+                .ok_or(FsError::EntryNotFound),
+        }
+    }
+
+    fn symlink_metadata(&self, path: &Path) -> virtual_fs::Result<Metadata> {
+        self.metadata(path)
+    }
+
+    fn remove_file(&self, path: &Path) -> virtual_fs::Result<()> {
+        let name = Self::name(path)?.ok_or(FsError::NotAFile)?;
+        if self.remove_named_object(&name, None) {
+            Ok(())
+        } else {
+            Err(FsError::EntryNotFound)
+        }
+    }
+
+    fn new_open_options(&self) -> OpenOptions<'_> {
+        OpenOptions::new(self)
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct SharedMemoryFileHandle {
+    object: Arc<SharedMemoryObject>,
+    files: Arc<RwLock<HashMap<String, Arc<SharedMemoryObject>>>>,
+    name: String,
+    readable: bool,
+    writable: bool,
+    append: bool,
+    cursor: u64,
+    pending_seek: Option<io::Result<u64>>,
+}
+
+impl SharedMemoryFileHandle {
+    pub(crate) fn object(&self) -> Arc<SharedMemoryObject> {
+        self.object.clone()
+    }
+
+    fn remove_name(&self) -> bool {
+        let mut files = self.files.write().unwrap();
+        if files
+            .get(&self.name)
+            .is_some_and(|object| Arc::ptr_eq(object, &self.object))
+        {
+            files.remove(&self.name);
+            true
+        } else {
+            false
+        }
+    }
+}
+
+impl VirtualFile for SharedMemoryFileHandle {
+    fn last_accessed(&self) -> u64 {
+        self.object.accessed.load(Ordering::Relaxed)
+    }
+
+    fn last_modified(&self) -> u64 {
+        self.object.modified.load(Ordering::Relaxed)
+    }
+
+    fn created_time(&self) -> u64 {
+        self.object.created
+    }
+
+    fn set_times(&mut self, atime: Option<u64>, mtime: Option<u64>) -> virtual_fs::Result<()> {
+        if let Some(atime) = atime {
+            self.object.accessed.store(atime, Ordering::Relaxed);
+        }
+        if let Some(mtime) = mtime {
+            self.object.modified.store(mtime, Ordering::Relaxed);
+        }
+        Ok(())
+    }
+
+    fn size(&self) -> u64 {
+        self.object.size()
+    }
+
+    fn set_len(&mut self, new_size: u64) -> virtual_fs::Result<()> {
+        if !self.writable {
+            return Err(FsError::PermissionDenied);
+        }
+        self.object.set_len(new_size)?;
+        self.cursor = self.cursor.min(new_size);
+        Ok(())
+    }
+
+    fn unlink(&mut self) -> virtual_fs::Result<()> {
+        if self.remove_name() {
+            Ok(())
+        } else {
+            Err(FsError::EntryNotFound)
+        }
+    }
+
+    fn poll_read_ready(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<usize>> {
+        Poll::Ready(Ok(self.object.size().saturating_sub(self.cursor) as usize))
+    }
+
+    fn poll_write_ready(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<usize>> {
+        Poll::Ready(Ok(8192))
+    }
+}
+
+impl AsyncRead for SharedMemoryFileHandle {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        _cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        use std::os::unix::fs::FileExt;
+
+        if !self.readable {
+            return Poll::Ready(Err(io::ErrorKind::PermissionDenied.into()));
+        }
+        let destination = buf.initialize_unfilled();
+        match self.object.file.read_at(destination, self.cursor) {
+            Ok(read) => {
+                self.cursor += read as u64;
+                self.object.accessed.store(now_nanos(), Ordering::Relaxed);
+                buf.advance(read);
+                Poll::Ready(Ok(()))
+            }
+            Err(error) => Poll::Ready(Err(error)),
+        }
+    }
+}
+
+impl AsyncWrite for SharedMemoryFileHandle {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        _cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        use std::os::unix::fs::FileExt;
+
+        if !self.writable {
+            return Poll::Ready(Err(io::ErrorKind::PermissionDenied.into()));
+        }
+        let object = self.object.clone();
+        let _guard = object.io_lock.lock().unwrap();
+        let offset = if self.append {
+            object.size()
+        } else {
+            self.cursor
+        };
+        match object.file.write_at(buf, offset) {
+            Ok(written) => {
+                drop(_guard);
+                self.cursor = offset + written as u64;
+                object.modified.store(now_nanos(), Ordering::Relaxed);
+                Poll::Ready(Ok(written))
+            }
+            Err(error) => Poll::Ready(Err(error)),
+        }
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Poll::Ready(Ok(()))
+    }
+
+    fn poll_shutdown(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Poll::Ready(Ok(()))
+    }
+}
+
+impl AsyncSeek for SharedMemoryFileHandle {
+    fn start_seek(mut self: Pin<&mut Self>, position: io::SeekFrom) -> io::Result<()> {
+        let new_position = match position {
+            io::SeekFrom::Start(offset) => i128::from(offset),
+            io::SeekFrom::End(delta) => i128::from(self.object.size()) + i128::from(delta),
+            io::SeekFrom::Current(delta) => i128::from(self.cursor) + i128::from(delta),
+        };
+        self.pending_seek = Some(match u64::try_from(new_position) {
+            Ok(position) => {
+                self.cursor = position;
+                Ok(position)
+            }
+            Err(_) => Err(io::ErrorKind::InvalidInput.into()),
+        });
+        Ok(())
+    }
+
+    fn poll_complete(mut self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<u64>> {
+        Poll::Ready(self.pending_seek.take().unwrap_or(Ok(self.cursor)))
+    }
+}
+
+impl WasiFs {
+    pub(crate) fn shared_memory_object(&self, fd: u32) -> Result<Arc<SharedMemoryObject>, Errno> {
+        let fd = self.get_fd(fd)?;
+        if !fd.inner.rights.contains(Rights::FD_READ | Rights::FD_WRITE) {
+            return Err(Errno::Access);
+        }
+        let inode = fd.inode.read();
+        let Kind::File {
+            handle: Some(handle),
+            ..
+        } = &*inode
+        else {
+            return Err(Errno::Badf);
+        };
+        let handle = handle.read().unwrap();
+        handle
+            .upcast_any_ref()
+            .downcast_ref::<SharedMemoryFileHandle>()
+            .map(SharedMemoryFileHandle::object)
+            .ok_or(Errno::Nodev)
+    }
+}
+
+pub(crate) fn install(root: &virtual_fs::MountFileSystem) {
+    root.set_mount(
+        Path::new("/dev/shm"),
+        Arc::new(SharedMemoryFileSystem::new()),
+    )
+    .expect("installing the /dev/shm filesystem should succeed");
+}
+
+fn now_nanos() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| duration.as_nanos() as u64)
+        .unwrap_or(0)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn unlink_and_mapping_lifetimes_are_independent_of_the_name() {
+        let fs = SharedMemoryFileSystem::new();
+        let mut handle = fs
+            .new_open_options()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .open("/object")
+            .unwrap();
+        handle.set_len(WASM_PAGE_SIZE).unwrap();
+
+        let object = handle
+            .upcast_any_ref()
+            .downcast_ref::<SharedMemoryFileHandle>()
+            .unwrap()
+            .object();
+        let mapping = object
+            .register_mapping(0, WASM_PAGE_SIZE)
+            .expect("the complete object should be mappable");
+        assert_eq!(handle.set_len(0), Err(FsError::PermissionDenied));
+
+        handle.unlink().unwrap();
+        assert_eq!(
+            fs.metadata(Path::new("/object")),
+            Err(FsError::EntryNotFound)
+        );
+        assert_eq!(handle.size(), WASM_PAGE_SIZE);
+
+        drop(mapping);
+        handle.set_len(0).unwrap();
+    }
+
+    #[test]
+    fn wasi_root_reserves_dev_shm_for_memfd_objects() {
+        let root =
+            super::super::WasiFsRoot::from_filesystem(Arc::new(virtual_fs::TmpFileSystem::new()));
+        let mut handle = root
+            .new_open_options()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .open("/dev/shm/object")
+            .unwrap();
+        handle.set_len(WASM_PAGE_SIZE).unwrap();
+        assert!(
+            handle
+                .upcast_any_ref()
+                .downcast_ref::<SharedMemoryFileHandle>()
+                .is_some()
+        );
+    }
+
+    const WASM_PAGE_SIZE: u64 = 65_536;
+}
